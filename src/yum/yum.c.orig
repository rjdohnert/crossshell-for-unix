#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <wuapi.h>
#include <oleauto.h>
#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>
#include <wchar.h>

#pragma comment(lib, "ole32.lib")
#pragma comment(lib, "oleaut32.lib")
#pragma comment(lib, "advapi32.lib")
#pragma comment(lib, "uuid.lib")

#define YUM_VERSION L"5.0.0-NT"
#define MAX_CMDLINE 8192

typedef struct {
    bool assume_yes;
    bool verbose;
} YumContext;

/* --- Win32 Standard Command-Line Escaping --- */

static void AppendEscapedArgument(wchar_t* buffer, size_t bufferSize, const wchar_t* arg) {
    if (buffer[0] != L'\0') {
        wcsncat_s(buffer, bufferSize, L" ", _TRUNCATE);
    }

    bool needsQuotes = (wcslen(arg) == 0) || (wcschr(arg, L' ') != NULL) || (wcschr(arg, L'\t') != NULL);

    if (!needsQuotes) {
        wcsncat_s(buffer, bufferSize, arg, _TRUNCATE);
        return;
    }

    wcsncat_s(buffer, bufferSize, L"\"", _TRUNCATE);

    for (const wchar_t* p = arg; *p != L'\0'; ++p) {
        unsigned int numBackslashes = 0;
        while (*p == L'\\') {
            numBackslashes++;
            p++;
        }

        if (*p == L'\0') {
            for (unsigned int i = 0; i < numBackslashes * 2; ++i) {
                wcsncat_s(buffer, bufferSize, L"\\", _TRUNCATE);
            }
            break;
        } else if (*p == L'\"') {
            for (unsigned int i = 0; i < numBackslashes * 2 + 1; ++i) {
                wcsncat_s(buffer, bufferSize, L"\\", _TRUNCATE);
            }
            wcsncat_s(buffer, bufferSize, L"\"", _TRUNCATE);
        } else {
            for (unsigned int i = 0; i < numBackslashes; ++i) {
                wcsncat_s(buffer, bufferSize, L"\\", _TRUNCATE);
            }
            wchar_t ch[2] = { *p, L'\0' };
            wcsncat_s(buffer, bufferSize, ch, _TRUNCATE);
        }
    }

    wcsncat_s(buffer, bufferSize, L"\"", _TRUNCATE);
}

/* --- Native Process Dispatcher --- */

static int ExecuteWinget(const YumContext* ctx, const wchar_t* const args[], size_t argCount) {
    wchar_t cmdLine[MAX_CMDLINE] = { 0 };

    AppendEscapedArgument(cmdLine, MAX_CMDLINE, L"winget.exe");

    for (size_t i = 0; i < argCount; ++i) {
        AppendEscapedArgument(cmdLine, MAX_CMDLINE, args[i]);
    }

    if (ctx->verbose) {
        wprintf(L"[DEBUG] Spawning: %ls\n", cmdLine);
    }

    STARTUPINFOW si;
    PROCESS_INFORMATION pi;
    ZeroMemory(&si, sizeof(si));
    si.cb = sizeof(si);
    ZeroMemory(&pi, sizeof(pi));

    if (!CreateProcessW(NULL, cmdLine, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {
        DWORD err = GetLastError();
        fwprintf(stderr, L"Error: Failed to dispatch winget.exe (Win32 Error: %lu)\n", err);
        return (int)err;
    }

    WaitForSingleObject(pi.hProcess, INFINITE);

    DWORD exitCode = 0;
    GetExitCodeProcess(pi.hProcess, &exitCode);

    CloseHandle(pi.hProcess);
    CloseHandle(pi.hThread);

    return (int)exitCode;
}

/* --- Native Windows Update Agent (WUA) Engine via COM --- */

static int Yum_UpdateWindows(const YumContext* ctx) {
    wprintf(L"Loaded plugins: fastestmirror, native-wua\n");
    wprintf(L"Querying Windows Update Agent subsystem...\n\n");

    HRESULT hr = CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
    if (FAILED(hr)) {
        fwprintf(stderr, L"Fatal: CoInitializeEx failed (0x%08lX)\n", hr);
        return 1;
    }

    IUpdateSession* pSession = NULL;
    hr = CoCreateInstance(&CLSID_UpdateSession, NULL, CLSCTX_INPROC_SERVER,
                          &IID_IUpdateSession, (void**)&pSession);
    if (FAILED(hr)) {
        fwprintf(stderr, L"Error: Failed to instantiate UpdateSession (0x%08lX)\n", hr);
        CoUninitialize();
        return 1;
    }

    IUpdateSearcher* pSearcher = NULL;
    hr = pSession->lpVtbl->CreateUpdateSearcher(pSession, &pSearcher);
    if (FAILED(hr)) {
        fwprintf(stderr, L"Error: Failed to create UpdateSearcher (0x%08lX)\n", hr);
        pSession->lpVtbl->Release(pSession);
        CoUninitialize();
        return 1;
    }

    BSTR criteria = SysAllocString(L"IsInstalled=0 and Type='Software'");
    ISearchResult* pSearchResult = NULL;

    wprintf(L"Searching for pending OS updates against Microsoft Update catalogs...\n");
    hr = pSearcher->lpVtbl->Search(pSearcher, criteria, &pSearchResult);
    SysFreeString(criteria);

    if (FAILED(hr)) {
        fwprintf(stderr, L"Error: Search query failed (0x%08lX)\n", hr);
        pSearcher->lpVtbl->Release(pSearcher);
        pSession->lpVtbl->Release(pSession);
        CoUninitialize();
        return 1;
    }

    IUpdateCollection* pUpdates = NULL;
    hr = pSearchResult->lpVtbl->get_Updates(pSearchResult, &pUpdates);
    if (FAILED(hr) || !pUpdates) {
        fwprintf(stderr, L"Error: Failed to retrieve update collection.\n");
        pSearchResult->lpVtbl->Release(pSearchResult);
        pSearcher->lpVtbl->Release(pSearcher);
        pSession->lpVtbl->Release(pSession);
        CoUninitialize();
        return 1;
    }

    long count = 0;
    pUpdates->lpVtbl->get_Count(pUpdates, &count);

    if (count == 0) {
        wprintf(L"\nNo Windows updates available. Your system is up to date.\n");
    } else {
        wprintf(L"\n================================================================================\n");
        wprintf(L" Package                          Classification             Mandatory         \n");
        wprintf(L"================================================================================\n");

        for (long i = 0; i < count; ++i) {
            IUpdate* pUpdate = NULL;
            if (SUCCEEDED(pUpdates->lpVtbl->get_Item(pUpdates, i, &pUpdate))) {
                BSTR title = NULL;
                pUpdate->lpVtbl->get_Title(pUpdate, &title);

                VARIANT_BOOL isMandatory = VARIANT_FALSE;
                pUpdate->lpVtbl->get_IsMandatory(pUpdate, &isMandatory);

                IStringCollection* pKBs = NULL;
                BSTR kbId = NULL;
                if (SUCCEEDED(pUpdate->lpVtbl->get_KBArticleIDs(pUpdate, &pKBs)) && pKBs) {
                    long kbCount = 0;
                    pKBs->lpVtbl->get_Count(pKBs, &kbCount);
                    if (kbCount > 0) {
                        pKBs->lpVtbl->get_Item(pKBs, 0, &kbId);
                    }
                    pKBs->lpVtbl->Release(pKBs);
                }

                wprintf(L"[%2ld] %-50.50ls %-15ls %-10ls\n",
                        i + 1,
                        title ? title : L"Unknown",
                        kbId ? kbId : L"KB-Unknown",
                        (isMandatory == VARIANT_TRUE) ? L"Yes" : L"No");

                if (title) SysFreeString(title);
                if (kbId) SysFreeString(kbId);
                pUpdate->lpVtbl->Release(pUpdate);
            }
        }
        wprintf(L"\nFound %ld pending system update(s). Run 'yum sys-upgrade' to install them, or use Settings.\n", count);
    }

    pUpdates->lpVtbl->Release(pUpdates);
    pSearchResult->lpVtbl->Release(pSearchResult);
    pSearcher->lpVtbl->Release(pSearcher);
    pSession->lpVtbl->Release(pSession);
    CoUninitialize();

    return 0;
}

static bool Yum_IsElevated(void) {
    HANDLE token = NULL;
    TOKEN_ELEVATION elevation = {0};
    DWORD bytes = 0;
    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) return false;
    BOOL success = GetTokenInformation(token, TokenElevation, &elevation, sizeof(elevation), &bytes);
    CloseHandle(token);
    return success && elevation.TokenIsElevated != 0;
}

static int Yum_SystemUpgrade(const YumContext* ctx) {
    if (!Yum_IsElevated()) {
        fwprintf(stderr, L"yum sys-upgrade requires an Administrator terminal. No updates were installed.\n");
        return 1;
    }

    HRESULT hr = CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
    if (FAILED(hr)) {
        fwprintf(stderr, L"yum: COM initialization failed (0x%08lX)\n", (unsigned long)hr);
        return 1;
    }

    int status = 1;
    const wchar_t* failure = NULL;
    IUpdateSession* session = NULL;
    IUpdateSearcher* searcher = NULL;
    ISearchResult* search_result = NULL;
    IUpdateCollection* available = NULL;
    IUpdateCollection* downloaded = NULL;
    IUpdateDownloader* downloader = NULL;
    IDownloadResult* download_result = NULL;
    IUpdateInstaller* installer = NULL;
    IInstallationResult* install_result = NULL;
    IUpdateInstallationResult* item_result = NULL;
    IUpdate* update = NULL;
    BSTR criteria = NULL, client_id = NULL, title = NULL, license = NULL;
    OperationResultCode result_code = orcNotStarted;
    long count = 0, install_count = 0, installed = 0, failed = 0, download_failed = 0;
    VARIANT_BOOL reboot = VARIANT_FALSE;
    CLSID collection_class;

#define YUM_WUA_TRY(expression, description) do { hr = (expression); if (FAILED(hr)) { failure = (description); goto cleanup_upgrade; } } while (0)

    YUM_WUA_TRY(CoCreateInstance(&CLSID_UpdateSession, NULL, CLSCTX_INPROC_SERVER,
        &IID_IUpdateSession, (void**)&session), L"create Windows Update session");
    client_id = SysAllocString(L"CrossShell yum sys-upgrade");
    criteria = SysAllocString(L"IsInstalled=0 and IsHidden=0 and Type='Software'");
    if (!client_id || !criteria) { hr = E_OUTOFMEMORY; failure = L"allocate search parameters"; goto cleanup_upgrade; }
    YUM_WUA_TRY(session->lpVtbl->put_ClientApplicationID(session, client_id), L"identify update client");
    YUM_WUA_TRY(session->lpVtbl->CreateUpdateSearcher(session, &searcher), L"create update searcher");
    wprintf(L"Loaded plugins: fastestmirror, native-wua\nSearching the configured Windows Update service...\n");
    YUM_WUA_TRY(searcher->lpVtbl->Search(searcher, criteria, &search_result), L"search Windows Update");
    YUM_WUA_TRY(search_result->lpVtbl->get_ResultCode(search_result, &result_code), L"read search result");
    if (result_code != orcSucceeded) {
        fwprintf(stderr, L"yum: Windows Update search did not complete successfully (result %d).\n", (int)result_code);
        goto cleanup_upgrade;
    }
    YUM_WUA_TRY(search_result->lpVtbl->get_Updates(search_result, &available), L"retrieve pending updates");
    YUM_WUA_TRY(available->lpVtbl->get_Count(available, &count), L"count pending updates");
    if (!count) { wprintf(L"No pending non-hidden Windows software updates.\n"); status = 0; goto cleanup_upgrade; }

    wprintf(L"\nPending Windows updates:\n");
    for (long index = 0; index < count; ++index) {
        YUM_WUA_TRY(available->lpVtbl->get_Item(available, index, &update), L"retrieve update details");
        YUM_WUA_TRY(update->lpVtbl->get_Title(update, &title), L"read update title");
        wprintf(L"  [%ld] %ls\n", index + 1, title ? title : L"Untitled update");
        VARIANT_BOOL accepted = VARIANT_FALSE;
        YUM_WUA_TRY(update->lpVtbl->get_EulaAccepted(update, &accepted), L"read license acceptance");
        if (accepted != VARIANT_TRUE) {
            YUM_WUA_TRY(update->lpVtbl->get_EulaText(update, &license), L"read update license");
            wprintf(L"\nLicense for this update:\n%ls\n\n", license ? license : L"See Windows Update for license terms.");
            SysFreeString(license); license = NULL;
        }
        SysFreeString(title); title = NULL;
        update->lpVtbl->Release(update); update = NULL;
    }
    if (!ctx->assume_yes) {
        wchar_t answer[16];
        wprintf(L"Download and install these %ld update(s), accepting any displayed licenses? [y/N] ", count);
        fflush(stdout);
        if (!fgetws(answer, (int)(sizeof(answer) / sizeof(answer[0])), stdin) ||
            (answer[0] != L'y' && answer[0] != L'Y')) {
            wprintf(L"Cancelled. No updates were downloaded or installed.\n");
            status = 0; goto cleanup_upgrade;
        }
    }
    for (long index = 0; index < count; ++index) {
        YUM_WUA_TRY(available->lpVtbl->get_Item(available, index, &update), L"retrieve update for license acceptance");
        VARIANT_BOOL accepted = VARIANT_FALSE;
        YUM_WUA_TRY(update->lpVtbl->get_EulaAccepted(update, &accepted), L"read update license state");
        if (accepted != VARIANT_TRUE) YUM_WUA_TRY(update->lpVtbl->AcceptEula(update), L"accept confirmed update license");
        update->lpVtbl->Release(update); update = NULL;
    }

    YUM_WUA_TRY(session->lpVtbl->CreateUpdateDownloader(session, &downloader), L"create update downloader");
    YUM_WUA_TRY(downloader->lpVtbl->put_Updates(downloader, available), L"select updates for download");
    wprintf(L"\nDownloading %ld update(s)...\n", count);
    YUM_WUA_TRY(downloader->lpVtbl->Download(downloader, &download_result), L"download updates");
    YUM_WUA_TRY(download_result->lpVtbl->get_ResultCode(download_result, &result_code), L"read download result");
    if (ctx->verbose) wprintf(L"Download operation result: %d\n", (int)result_code);
    if (result_code != orcSucceeded && result_code != orcSucceededWithErrors) {
        fwprintf(stderr, L"yum: update download did not succeed (result %d).\n", (int)result_code);
        goto cleanup_upgrade;
    }
    YUM_WUA_TRY(CLSIDFromProgID(L"Microsoft.Update.UpdateColl", &collection_class), L"resolve update collection class");
    YUM_WUA_TRY(CoCreateInstance(&collection_class, NULL, CLSCTX_INPROC_SERVER,
        &IID_IUpdateCollection, (void**)&downloaded), L"create installation collection");
    for (long index = 0; index < count; ++index) {
        YUM_WUA_TRY(available->lpVtbl->get_Item(available, index, &update), L"retrieve downloaded update");
        VARIANT_BOOL ready = VARIANT_FALSE;
        YUM_WUA_TRY(update->lpVtbl->get_IsDownloaded(update, &ready), L"verify downloaded update");
        if (ready == VARIANT_TRUE) {
            long added_index = 0;
            YUM_WUA_TRY(downloaded->lpVtbl->Add(downloaded, update, &added_index), L"queue downloaded update");
        } else {
            ++download_failed;
            YUM_WUA_TRY(update->lpVtbl->get_Title(update, &title), L"read failed download title");
            fwprintf(stderr, L"Not downloaded; skipping: %ls\n", title ? title : L"Untitled update");
            SysFreeString(title); title = NULL;
        }
        update->lpVtbl->Release(update); update = NULL;
    }
    YUM_WUA_TRY(downloaded->lpVtbl->get_Count(downloaded, &install_count), L"count installable updates");
    if (!install_count) { fwprintf(stderr, L"No updates were downloaded successfully.\n"); goto cleanup_upgrade; }
    YUM_WUA_TRY(session->lpVtbl->CreateUpdateInstaller(session, &installer), L"create update installer");
    YUM_WUA_TRY(installer->lpVtbl->put_Updates(installer, downloaded), L"select updates for installation");
    VARIANT_BOOL busy = VARIANT_FALSE, reboot_before = VARIANT_FALSE;
    YUM_WUA_TRY(installer->lpVtbl->get_IsBusy(installer, &busy), L"check installer availability");
    if (busy == VARIANT_TRUE) { fwprintf(stderr, L"Windows Update is already installing updates. Try again later.\n"); goto cleanup_upgrade; }
    YUM_WUA_TRY(installer->lpVtbl->get_RebootRequiredBeforeInstallation(installer, &reboot_before), L"check pending restart");
    if (reboot_before == VARIANT_TRUE) {
        wprintf(L"Windows requires a restart before installation. Restart manually, then run yum sys-upgrade again.\n");
        status = 3010; goto cleanup_upgrade;
    }
    YUM_WUA_TRY(installer->lpVtbl->put_AllowSourcePrompts(installer, VARIANT_FALSE), L"disable installer source prompts");
    wprintf(L"Installing %ld update(s)...\n", install_count);
    YUM_WUA_TRY(installer->lpVtbl->Install(installer, &install_result), L"install updates");
    YUM_WUA_TRY(install_result->lpVtbl->get_ResultCode(install_result, &result_code), L"read installation result");
    YUM_WUA_TRY(install_result->lpVtbl->get_RebootRequired(install_result, &reboot), L"read restart requirement");
    for (long index = 0; index < install_count; ++index) {
        OperationResultCode item_code = orcNotStarted;
        HRESULT item_hr = E_FAIL;
        YUM_WUA_TRY(downloaded->lpVtbl->get_Item(downloaded, index, &update), L"retrieve installed update");
        YUM_WUA_TRY(update->lpVtbl->get_Title(update, &title), L"read installed update title");
        YUM_WUA_TRY(install_result->lpVtbl->GetUpdateResult(install_result, index, &item_result), L"read individual installation result");
        YUM_WUA_TRY(item_result->lpVtbl->get_ResultCode(item_result, &item_code), L"read individual result code");
        YUM_WUA_TRY(item_result->lpVtbl->get_HResult(item_result, &item_hr), L"read individual error code");
        if (item_code == orcSucceeded && SUCCEEDED(item_hr)) { ++installed; wprintf(L"Installed: %ls\n", title ? title : L"Untitled update"); }
        else { ++failed; fwprintf(stderr, L"Failed: %ls (result %d, HRESULT 0x%08lX)\n", title ? title : L"Untitled update", (int)item_code, (unsigned long)item_hr); }
        item_result->lpVtbl->Release(item_result); item_result = NULL;
        SysFreeString(title); title = NULL;
        update->lpVtbl->Release(update); update = NULL;
    }
    wprintf(L"\nWindows Update summary: %ld installed, %ld installation failures, %ld download failures.\n", installed, failed, download_failed);
    if (reboot == VARIANT_TRUE) wprintf(L"A restart is required. Restart manually when convenient; yum will not reboot automatically.\n");
    status = failed || download_failed || result_code != orcSucceeded ? 1 : reboot == VARIANT_TRUE ? 3010 : 0;

cleanup_upgrade:
    if (failure) fwprintf(stderr, L"yum: failed to %ls (HRESULT 0x%08lX)\n", failure, (unsigned long)hr);
    SysFreeString(criteria); SysFreeString(client_id); SysFreeString(title); SysFreeString(license);
    if (item_result) item_result->lpVtbl->Release(item_result);
    if (update) update->lpVtbl->Release(update);
    if (install_result) install_result->lpVtbl->Release(install_result);
    if (installer) installer->lpVtbl->Release(installer);
    if (download_result) download_result->lpVtbl->Release(download_result);
    if (downloader) downloader->lpVtbl->Release(downloader);
    if (downloaded) downloaded->lpVtbl->Release(downloaded);
    if (available) available->lpVtbl->Release(available);
    if (search_result) search_result->lpVtbl->Release(search_result);
    if (searcher) searcher->lpVtbl->Release(searcher);
    if (session) session->lpVtbl->Release(session);
    CoUninitialize();
#undef YUM_WUA_TRY
    return status;
}

/* --- Package Operations --- */

static int Yum_Install(const YumContext* ctx, const wchar_t* package) {
    wprintf(L"Loaded plugins: fastestmirror\nResolving dependencies for: %ls\n\n", package);
    const wchar_t* args[] = {
        L"install",
        L"--exact",
        package,
        L"--accept-package-agreements",
        L"--accept-source-agreements",
        ctx->assume_yes ? L"--silent" : L""
    };
    return ExecuteWinget(ctx, args, ctx->assume_yes ? 6 : 5);
}

static int Yum_Remove(const YumContext* ctx, const wchar_t* package) {
    wprintf(L"Loaded plugins: fastestmirror\nPreparing erase transaction: %ls\n\n", package);
    const wchar_t* args[] = { L"uninstall", L"--exact", package };
    return ExecuteWinget(ctx, args, 3);
}

static int Yum_Search(const YumContext* ctx, const wchar_t* query) {
    const wchar_t* args[] = { L"search", query };
    return ExecuteWinget(ctx, args, 2);
}

static int Yum_Info(const YumContext* ctx, const wchar_t* package) {
    const wchar_t* args[] = { L"show", L"--exact", package };
    return ExecuteWinget(ctx, args, 3);
}

static int Yum_List(const YumContext* ctx) {
    const wchar_t* args[] = { L"list" };
    return ExecuteWinget(ctx, args, 1);
}

static int Yum_Upgrade(const YumContext* ctx) {
    const wchar_t* args[] = {
        L"upgrade",
        L"--all",
        L"--include-unknown",
        ctx->assume_yes ? L"--silent" : L""
    };
    return ExecuteWinget(ctx, args, ctx->assume_yes ? 4 : 3);
}

static int Yum_RepoList(const YumContext* ctx) {
    const wchar_t* args[] = { L"source", L"list" };
    return ExecuteWinget(ctx, args, 2);
}

static int Yum_RepoAdd(const YumContext* ctx, const wchar_t* name, const wchar_t* url) {
    const wchar_t* args[] = { L"source", L"add", L"--name", name, L"--arg", url };
    return ExecuteWinget(ctx, args, 5);
}

static int Yum_RepoRemove(const YumContext* ctx, const wchar_t* name) {
    const wchar_t* args[] = { L"source", L"remove", L"--name", name };
    return ExecuteWinget(ctx, args, 4);
}

static void Yum_ShowHelp(void) {
    wprintf(
        L"Loaded plugins: fastestmirror, native-wua\n"
        L"Usage: yum [options] COMMAND\n\n"
        L"Yellowdog Updater, Modified (YUM) " YUM_VERSION L"\n"
        L"Main Commands:\n"
        L"  install <pkg>               Install a package onto the system\n"
        L"  remove | erase <pkg>        Remove a package from the system\n"
        L"  update                      Query Windows Update Agent via native COM\n"
        L"  sys-upgrade                 Download/install pending Windows software updates\n"
        L"  upgrade                     Upgrade all winget-managed packages\n"
        L"  search <keyword>            Search repository package names/summaries\n"
        L"  info <pkg>                  Display package metadata\n"
        L"  list                        List installed packages\n"
        L"  repolist                    Display active package repositories\n"
        L"  repo add <name> <url>       Register a new package repository/feed\n"
        L"  repo remove <name>          Unregister a package repository\n"
        L"  help                        Show this menu\n\n"
        L"Options:\n"
        L"  -y, --assumeyes             Answer yes to all confirmations\n"
        L"  -v, --verbose               Log detailed execution statements\n"
        L"  --version                   Display version and exit\n"
        L"\nWindows updates:\n"
        L"  update only lists pending updates; sys-upgrade installs non-hidden software updates.\n"
        L"  sys-upgrade requires an Administrator terminal and confirms installation/licenses.\n"
        L"  Use -y to skip confirmation; Windows Update service policy is respected.\n"
        L"  No automatic reboot. Exit 3010 means a restart is required; 1 means failure.\n"
    );
}

/* --- Entry Point --- */

int wmain(int argc, wchar_t* argv[]) {
    if (argc < 2) {
        Yum_ShowHelp();
        return 1;
    }

    YumContext ctx = { .assume_yes = false, .verbose = false };
    int argIdx = 1;

    while (argIdx < argc && argv[argIdx][0] == L'-') {
        if (wcscmp(argv[argIdx], L"-y") == 0 || wcscmp(argv[argIdx], L"--assumeyes") == 0) {
            ctx.assume_yes = true;
        } else if (wcscmp(argv[argIdx], L"-v") == 0 || wcscmp(argv[argIdx], L"--verbose") == 0) {
            ctx.verbose = true;
        } else if (wcscmp(argv[argIdx], L"-h") == 0 || wcscmp(argv[argIdx], L"--help") == 0) {
            Yum_ShowHelp();
            return 0;
        } else if (wcscmp(argv[argIdx], L"--version") == 0) {
            wprintf(L"%ls\n", YUM_VERSION);
            return 0;
        } else {
            fwprintf(stderr, L"Unknown option: %ls\n", argv[argIdx]);
            Yum_ShowHelp();
            return 1;
        }
        argIdx++;
    }

    if (argIdx >= argc) {
        Yum_ShowHelp();
        return 0;
    }

    const wchar_t* command = argv[argIdx++];

    if (wcscmp(command, L"install") == 0) {
        if (argIdx >= argc) { fwprintf(stderr, L"Error: Missing package name.\n"); return 1; }
        return Yum_Install(&ctx, argv[argIdx]);
    } else if (wcscmp(command, L"remove") == 0 || wcscmp(command, L"erase") == 0) {
        if (argIdx >= argc) { fwprintf(stderr, L"Error: Missing package name.\n"); return 1; }
        return Yum_Remove(&ctx, argv[argIdx]);
    } else if (wcscmp(command, L"search") == 0) {
        if (argIdx >= argc) { fwprintf(stderr, L"Error: Missing search term.\n"); return 1; }
        return Yum_Search(&ctx, argv[argIdx]);
    } else if (wcscmp(command, L"info") == 0) {
        if (argIdx >= argc) { fwprintf(stderr, L"Error: Missing package name.\n"); return 1; }
        return Yum_Info(&ctx, argv[argIdx]);
    } else if (wcscmp(command, L"list") == 0) {
        return Yum_List(&ctx);
    } else if (wcscmp(command, L"update") == 0) {
        return Yum_UpdateWindows(&ctx);
    } else if (wcscmp(command, L"sys-upgrade") == 0) {
        while (argIdx < argc) {
            const wchar_t* option = argv[argIdx++];
            if (wcscmp(option, L"-h") == 0 || wcscmp(option, L"--help") == 0) { Yum_ShowHelp(); return 0; }
            if (wcscmp(option, L"-y") == 0 || wcscmp(option, L"--assumeyes") == 0) ctx.assume_yes = true;
            else if (wcscmp(option, L"-v") == 0 || wcscmp(option, L"--verbose") == 0) ctx.verbose = true;
            else { fwprintf(stderr, L"yum sys-upgrade: unexpected argument: %ls\n", option); return 1; }
        }
        return Yum_SystemUpgrade(&ctx);
    } else if (wcscmp(command, L"upgrade") == 0) {
        return Yum_Upgrade(&ctx);
    } else if (wcscmp(command, L"repolist") == 0) {
        return Yum_RepoList(&ctx);
    } else if (wcscmp(command, L"repo") == 0) {
        if (argIdx >= argc) { fwprintf(stderr, L"Error: Subcommand missing (add/remove).\n"); return 1; }
        const wchar_t* subCmd = argv[argIdx++];
        if (wcscmp(subCmd, L"add") == 0) {
            if (argIdx + 1 >= argc) { fwprintf(stderr, L"Usage: yum repo add <name> <url>\n"); return 1; }
            return Yum_RepoAdd(&ctx, argv[argIdx], argv[argIdx + 1]);
        } else if (wcscmp(subCmd, L"remove") == 0 || wcscmp(subCmd, L"rm") == 0) {
            if (argIdx >= argc) { fwprintf(stderr, L"Usage: yum repo remove <name>\n"); return 1; }
            return Yum_RepoRemove(&ctx, argv[argIdx]);
        } else if (wcscmp(subCmd, L"list") == 0) {
            return Yum_RepoList(&ctx);
        }
    } else if (wcscmp(command, L"help") == 0) {
        Yum_ShowHelp();
        return 0;
    }

    fwprintf(stderr, L"No such command: %ls. See 'yum help'.\n", command);
    return 1;
}