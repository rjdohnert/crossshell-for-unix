bool TryParseTransportMode(const std::wstring& input, TransportMode& mode) {
    std::wstring value = input;
    std::transform(value.begin(), value.end(), value.begin(), towlower);

    if (value == L"dcom" || value == L"rpc" || value == L"dcom-rpc") {
        mode = TransportMode::DcomRpc;
        return true;
    }

    if (value == L"winrm" || value == L"wsman" || value == L"ws-management") {
        mode = TransportMode::WinRm;
        return true;
    }

    if (value == L"ssh") {
        mode = TransportMode::Ssh;
        return true;
    }

    return false;
}

bool TryParseWinRmBackendMode(const std::wstring& input, WinRmBackendMode& mode) {
    std::wstring value = input;
    std::transform(value.begin(), value.end(), value.begin(), towlower);

    if (value == L"powershell" || value == L"ps") {
        mode = WinRmBackendMode::PowerShell;
        return true;
    }

    if (value == L"native" || value == L"wwsapi" || value == L"cpp") {
        mode = WinRmBackendMode::Native;
        return true;
    }

    return false;
}

bool TryParseConsoleEncoding(const std::wstring& input, ConsoleEncoding& encoding) {
    std::wstring value = input;
    std::transform(value.begin(), value.end(), value.begin(), towlower);

    if (value == L"utf16" || value == L"utf-16") {
        encoding = ConsoleEncoding::Utf16;
        return true;
    }

    if (value == L"utf8" || value == L"utf-8") {
        encoding = ConsoleEncoding::Utf8;
        return true;
    }

    return false;
}

bool ConfigureConsoleOutputMode(ConsoleEncoding encoding) {
    if (encoding == ConsoleEncoding::Utf8) {
        if (!SetConsoleOutputCP(CP_UTF8)) {
            return false;
        }
        SetConsoleCP(CP_UTF8);
        if (_setmode(_fileno(stdout), _O_U8TEXT) == -1) {
            return false;
        }
        if (_setmode(_fileno(stderr), _O_U8TEXT) == -1) {
            return false;
        }
        return true;
    }

    if (_setmode(_fileno(stdout), _O_U16TEXT) == -1) {
        return false;
    }
    if (_setmode(_fileno(stderr), _O_U16TEXT) == -1) {
        return false;
    }
    return true;
}

bool ReadHiddenConsoleLine(const std::wstring& prompt, std::wstring& value, std::wstring& error) {
    value.clear();
    error.clear();

    HANDLE hInput = GetStdHandle(STD_INPUT_HANDLE);
    DWORD originalMode = 0;

    // Fallback for redirected stdin (pipe/file): read plain text input.
    if (hInput == NULL || hInput == INVALID_HANDLE_VALUE || !GetConsoleMode(hInput, &originalMode)) {
        if (!prompt.empty()) {
            std::wcout << prompt;
        }
        if (std::getline(std::wcin, value)) {
            return true;
        }
        error = L"Failed to read input from standard input stream.";
        return false;
    }

    HANDLE hOutput = GetStdHandle(STD_OUTPUT_HANDLE);
    if (hOutput != NULL && hOutput != INVALID_HANDLE_VALUE) {
        DWORD written = 0;
        WriteConsoleW(hOutput, prompt.c_str(), static_cast<DWORD>(prompt.size()), &written, NULL);
    } else {
        std::wcout << prompt;
    }

    DWORD hiddenMode = originalMode & ~ENABLE_ECHO_INPUT;
    if (!SetConsoleMode(hInput, hiddenMode)) {
        error = L"Failed to disable console input echo for password entry.";
        return false;
    }

    wchar_t buffer[512] = {};
    DWORD charsRead = 0;
    BOOL readOk = ReadConsoleW(hInput, buffer, 511, &charsRead, NULL);

    SetConsoleMode(hInput, originalMode);

    if (hOutput != NULL && hOutput != INVALID_HANDLE_VALUE) {
        DWORD written = 0;
        WriteConsoleW(hOutput, L"\n", 1, &written, NULL);
    } else {
        std::wcout << L"\n";
    }

    if (!readOk) {
        SecureZeroMemory(buffer, sizeof(buffer));
        error = L"Failed to read password from console.";
        return false;
    }

    while (charsRead > 0 && (buffer[charsRead - 1] == L'\n' || buffer[charsRead - 1] == L'\r')) {
        --charsRead;
    }

    value.assign(buffer, charsRead);
    SecureZeroMemory(buffer, sizeof(buffer));
    return true;
}

double ElapsedMilliseconds(
    const std::chrono::steady_clock::time_point& start,
    const std::chrono::steady_clock::time_point& end
) {
    return std::chrono::duration<double, std::milli>(end - start).count();
}

// --- RAII Output Redirection ---

class StdoutRedirector {
private:
    std::wofstream fileStream;
    std::wstreambuf* oldBuffer;

public:
    StdoutRedirector() : oldBuffer(nullptr) {}

    bool RedirectToFile(const std::wstring& filePath) {
        fileStream.open(filePath, std::ios::out | std::ios::trunc);
        if (!fileStream.is_open()) return false;
        
        fileStream.imbue(std::locale(""));
        oldBuffer = std::wcout.rdbuf();
        std::wcout.rdbuf(fileStream.rdbuf());
        return true;
    }

    ~StdoutRedirector() {
        if (oldBuffer) {
            std::wcout.rdbuf(oldBuffer);
        }
        if (fileStream.is_open()) {
            fileStream.close();
        }
    }
};

// --- Process Privilege Elevation ---

bool EnableTokenPrivilege(LPCWSTR privilegeName) {
    HANDLE hToken;
    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &hToken)) {
        return false;
    }

    TOKEN_PRIVILEGES tp;
    LUID luid;
    if (LookupPrivilegeValueW(NULL, privilegeName, &luid)) {
        tp.PrivilegeCount = 1;
        tp.Privileges[0].Luid = luid;
        tp.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
        AdjustTokenPrivileges(hToken, FALSE, &tp, sizeof(TOKEN_PRIVILEGES), NULL, NULL);
    }

    CloseHandle(hToken);
    return (GetLastError() == ERROR_SUCCESS);
}

void EnableCommonPrivileges() {
    EnableTokenPrivilege(L"SeDebugPrivilege");
    EnableTokenPrivilege(L"SeShutdownPrivilege");
    EnableTokenPrivilege(L"SeRemoteShutdownPrivilege");
    EnableTokenPrivilege(L"SeSecurityPrivilege");
    EnableTokenPrivilege(L"SeSystemtimePrivilege");
}

// --- Connection Helper with Remote Auth Support ---

std::wstring DescribeWmiHResult(HRESULT hr);

std::wstring DescribeWmiConnectionFailure(HRESULT hr) {
    return DescribeWmiHResult(hr);
}

bool ConnectWmiServices(
    const WmiTargetConfig& target,
    const std::wstring& defaultNamespace,
    const WmiSecurityConfig& securityConfig,
    const std::wstring& wmiLocale,
    IWbemServices** ppSvc,
    bool reportError = true
) {
    *ppSvc = NULL;
    if (target.transport == TransportMode::Ssh || target.transport == TransportMode::WinRm) {
        return false;
    }

    if (!target.node.empty() && target.node != L"." && _wcsicmp(target.node.c_str(), L"localhost") != 0) {
        if (target.user.empty()) {
            std::wcerr << L"[!] Remote WMI targets require explicit credentials or a configured profile." << std::endl;
        }
    }

    IWbemLocator* pLoc = NULL;
    HRESULT hr = CoCreateInstance(CLSID_WbemLocator, 0, CLSCTX_INPROC_SERVER, IID_IWbemLocator, (LPVOID*)&pLoc);
    if (FAILED(hr)) {
        std::wcerr << L"[!] Failed to create WbemLocator: " << DescribeWmiHResult(hr) << std::endl;
        return false;
    }

    std::wstring targetNs = defaultNamespace.empty() ? L"ROOT\\CIMV2" : defaultNamespace;
    std::wstring fullPath;
    if (target.node == L"." || target.node.empty()) {
        fullPath = targetNs;
    } else {
        fullPath.reserve(2 + target.node.size() + 1 + targetNs.size());
        fullPath.append(L"\\\\");
        fullPath.append(target.node);
        fullPath.push_back(L'\\');
        fullPath.append(targetNs);
    }

    _bstr_t bstrPath(fullPath.c_str());
    _bstr_t bstrUser(target.user.empty() ? NULL : target.user.c_str());
    _bstr_t bstrPass(target.password.empty() ? NULL : target.password.c_str());
    _bstr_t bstrLocale(wmiLocale.empty() ? NULL : wmiLocale.c_str());

    hr = pLoc->ConnectServer(bstrPath, bstrUser, bstrPass, bstrLocale, 0, 0, 0, ppSvc);
    pLoc->Release();

    if (FAILED(hr) || !*ppSvc) {
        if (reportError) {
            std::wcerr << L"[!] WMI connection failed for target '" << (target.node.empty() ? L"localhost" : target.node) << L"': " << DescribeWmiHResult(hr) << std::endl;
        }
        return false;
    }

    SEC_WINNT_AUTH_IDENTITY_W authIdent = { 0 };
    SEC_WINNT_AUTH_IDENTITY_W* pAuthIdent = NULL;

    if (!target.user.empty()) {
        authIdent.User = (RPC_WSTR)target.user.c_str();
        authIdent.UserLength = (ULONG)target.user.length();
        authIdent.Password = (RPC_WSTR)target.password.c_str();
        authIdent.PasswordLength = (ULONG)target.password.length();
        authIdent.Domain = (RPC_WSTR)target.domain.c_str();
        authIdent.DomainLength = (ULONG)target.domain.length();
        authIdent.Flags = SEC_WINNT_AUTH_IDENTITY_UNICODE;
        pAuthIdent = &authIdent;
    }

    hr = CoSetProxyBlanket(
        *ppSvc,
        RPC_C_AUTHN_WINNT,
        RPC_C_AUTHZ_NONE,
        NULL,
        securityConfig.authnLevel,
        securityConfig.impLevel,
        pAuthIdent,
        EOAC_NONE
    );

    if (FAILED(hr)) {
        std::wcerr << L"[!] WMI proxy blanket setup failed: " << DescribeWmiHResult(hr) << std::endl;
        (*ppSvc)->Release();
        *ppSvc = NULL;
        return false;
    }

    return true;
}

// --- Original Helper Functions ---

std::wstring FormatBytes(unsigned long long bytes) {
    if (bytes == 0) return L"N/A";
    double gb = static_cast<double>(bytes) / (1024 * 1024 * 1024);
    wchar_t buf[32];
    if (gb >= 1.0) {
        swprintf_s(buf, L"%.2f GB", gb);
        return buf;
    }
    double mb = static_cast<double>(bytes) / (1024 * 1024);
    swprintf_s(buf, L"%.2f MB", mb);
    return buf;
}

bool TryParseUnsignedLongLong(const std::wstring& input, unsigned long long& valueOut) {
    valueOut = 0;
    if (input.empty()) {
        return false;
    }

    errno = 0;
    wchar_t* endPtr = nullptr;
    const unsigned long long parsed = _wcstoui64(input.c_str(), &endPtr, 10);
    if (endPtr == input.c_str() || *endPtr != L'\0' || errno == ERANGE) {
        return false;
    }

    valueOut = parsed;
    return true;
}

std::wstring FormatJsonFloatingToken(double value) {
    thread_local std::wostringstream stream;
    thread_local bool initialized = false;
    if (!initialized) {
        stream.imbue(std::locale::classic());
        initialized = true;
    }

    stream.str(L"");
    stream.clear();
    stream << value;
    return stream.str();
}

std::wstring VariantToString(VARIANT& vtProp) {
    if (V_VT(&vtProp) == VT_EMPTY || V_VT(&vtProp) == VT_NULL) return L"N/A";
    if (V_VT(&vtProp) == VT_BSTR && V_BSTR(&vtProp) != NULL) return std::wstring(V_BSTR(&vtProp));
    if (V_VT(&vtProp) == VT_I4) return std::to_wstring(V_I4(&vtProp));
    if (V_VT(&vtProp) == VT_UI4) return std::to_wstring(V_UI4(&vtProp));
    if (V_VT(&vtProp) == VT_UI8) return std::to_wstring(V_UI8(&vtProp));
    if (V_VT(&vtProp) == VT_I8) return std::to_wstring(V_I8(&vtProp));
    if (V_VT(&vtProp) == VT_BOOL) return (V_BOOL(&vtProp) ? L"True" : L"False");

    // Handle SafeArray of Strings (e.g., Network IPAddresses)
    if ((V_VT(&vtProp) & VT_ARRAY) && (V_VT(&vtProp) & VT_BSTR)) {
        SAFEARRAY* psa = V_ARRAY(&vtProp);
        BSTR* bstrData;
        std::wstring result = L"";
        if (SUCCEEDED(SafeArrayAccessData(psa, (void**)&bstrData))) {
            long lBound, uBound;
            SafeArrayGetLBound(psa, 1, &lBound);
            SafeArrayGetUBound(psa, 1, &uBound);
            
            std::vector<std::wstring> items;
            for (long i = lBound; i <= uBound; ++i) {
                long idx = i - lBound;
                if (bstrData[idx] != NULL) {
                    std::wstring str = bstrData[idx];
                    if (!str.empty()) items.push_back(str);
                }
            }
            SafeArrayUnaccessData(psa);

            // Put IPv4 before IPv6 addresses for cleaner network outputs
            std::stable_sort(items.begin(), items.end(), [](const std::wstring& a, const std::wstring& b) {
                bool a_has_colon = (a.find(L':') != std::wstring::npos);
                bool b_has_colon = (b.find(L':') != std::wstring::npos);
                return !a_has_colon && b_has_colon;
            });

            for (size_t i = 0; i < items.size(); ++i) {
                if (i > 0) result += L", ";
                result += items[i];
            }
            return result.empty() ? L"N/A" : result;
        }
    }

    // Generic conversion attempt
    VARIANT dest;
    VariantInit(&dest);
    if (SUCCEEDED(VariantChangeType(&dest, &vtProp, 0, VT_BSTR))) {
        std::wstring str(V_BSTR(&dest) ? V_BSTR(&dest) : L"");
        VariantClear(&dest);
        return str;
    }
    return L"<Data>";
}

std::wstring FormatWmiDateTime(const std::wstring& wmiDateTime) {
    if (wmiDateTime.length() < 14) return wmiDateTime;

    std::wstring year = wmiDateTime.substr(0, 4);
    std::wstring month = wmiDateTime.substr(4, 2);
    std::wstring day = wmiDateTime.substr(6, 2);
    std::wstring hour = wmiDateTime.substr(8, 2);
    std::wstring minute = wmiDateTime.substr(10, 2);
    std::wstring second = wmiDateTime.substr(12, 2);

    return year + L"-" + month + L"-" + day + L" " + hour + L":" + minute + L":" + second;
}

std::wstring EscapeJson(const std::wstring& input) {
    std::wstring out;
    out.reserve(input.size() + 8);

    for (wchar_t ch : input) {
        switch (ch) {
        case L'\\': out += L"\\\\"; break;
        case L'\"': out += L"\\\""; break;
        case L'\n': out += L"\\n"; break;
        case L'\r': out += L"\\r"; break;
        case L'\t': out += L"\\t"; break;
        default:
            if (ch >= 0 && ch <= 0x1F) {
                wchar_t buf[7];
                swprintf_s(buf, L"\\u%04X", static_cast<unsigned int>(ch));
                out += buf;
            } else {
                out += ch;
            }
            break;
        }
    }

    return out;
}

bool IsIntegerLiteral(const std::wstring& value) {
    if (value.empty()) return false;

    size_t start = 0;
    if (value[0] == L'-') {
        if (value.size() == 1) return false;
        start = 1;
    } else if (value[0] == L'+') {
        return false;
    }

    if (value[start] == L'0') {
        return (value.size() == start + 1);
    }

    if (value[start] < L'1' || value[start] > L'9') return false;

    for (size_t i = start + 1; i < value.size(); ++i) {
        if (!iswdigit(value[i])) return false;
    }

    return true;
}

std::wstring VariantToJson(VARIANT& vtProp) {
    if (V_VT(&vtProp) == VT_EMPTY || V_VT(&vtProp) == VT_NULL) {
        return L"null";
    }

    if (V_VT(&vtProp) & VT_ARRAY) {
        VARTYPE elementType = static_cast<VARTYPE>(V_VT(&vtProp) & VT_TYPEMASK);
        SAFEARRAY* psa = V_ARRAY(&vtProp);
        if (!psa) {
            return L"null";
        }

        long lBound = 0;
        long uBound = -1;
        if (FAILED(SafeArrayGetLBound(psa, 1, &lBound)) || FAILED(SafeArrayGetUBound(psa, 1, &uBound)) || uBound < lBound) {
            return L"[]";
        }

        std::wstring out;
        out.reserve(static_cast<size_t>(uBound - lBound + 1) * 10 + 2);
        out += L"[";
        bool first = true;
        for (long i = lBound; i <= uBound; ++i) {
            if (!first) out += L",";
            first = false;

            switch (elementType) {
            case VT_BSTR: {
                BSTR v = NULL;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v)) && v != NULL) {
                    out += L"\"";
                    out += EscapeJson(v);
                    out += L"\"";
                    SysFreeString(v);
                } else {
                    out += L"null";
                }
                break;
            }
            case VT_BOOL: {
                VARIANT_BOOL v = VARIANT_FALSE;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v))) {
                    out += (v == VARIANT_FALSE ? L"false" : L"true");
                } else {
                    out += L"null";
                }
                break;
            }
            case VT_I1: {
                CHAR v = 0;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v))) out += std::to_wstring(static_cast<int>(v)); else out += L"null";
                break;
            }
            case VT_UI1: {
                BYTE v = 0;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v))) out += std::to_wstring(static_cast<unsigned int>(v)); else out += L"null";
                break;
            }
            case VT_I2: {
                SHORT v = 0;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v))) out += std::to_wstring(v); else out += L"null";
                break;
            }
            case VT_UI2: {
                USHORT v = 0;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v))) out += std::to_wstring(v); else out += L"null";
                break;
            }
            case VT_I4: {
                LONG v = 0;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v))) out += std::to_wstring(v); else out += L"null";
                break;
            }
            case VT_UI4: {
                ULONG v = 0;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v))) out += std::to_wstring(v); else out += L"null";
                break;
            }
            case VT_I8: {
                LONGLONG v = 0;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v))) out += std::to_wstring(v); else out += L"null";
                break;
            }
            case VT_UI8: {
                ULONGLONG v = 0;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v))) out += std::to_wstring(v); else out += L"null";
                break;
            }
            case VT_R4: {
                FLOAT v = 0.0f;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v))) {
                    out += FormatJsonFloatingToken(static_cast<double>(v));
                } else {
                    out += L"null";
                }
                break;
            }
            case VT_R8: {
                DOUBLE v = 0.0;
                if (SUCCEEDED(SafeArrayGetElement(psa, &i, &v))) {
                    out += FormatJsonFloatingToken(v);
                } else {
                    out += L"null";
                }
                break;
            }
            default: {
                out += L"null";
                break;
            }
            }
        }
        out += L"]";
        return out;
    }

    switch (V_VT(&vtProp)) {
    case VT_BOOL:
        return (V_BOOL(&vtProp) == VARIANT_FALSE) ? L"false" : L"true";
    case VT_I1:
        return std::to_wstring(static_cast<int>(V_I1(&vtProp)));
    case VT_UI1:
        return std::to_wstring(static_cast<unsigned int>(V_UI1(&vtProp)));
    case VT_I2:
        return std::to_wstring(V_I2(&vtProp));
    case VT_UI2:
        return std::to_wstring(V_UI2(&vtProp));
    case VT_I4:
    case VT_INT:
        return std::to_wstring(V_I4(&vtProp));
    case VT_UI4:
    case VT_UINT:
        return std::to_wstring(V_UI4(&vtProp));
    case VT_I8:
        return std::to_wstring(V_I8(&vtProp));
    case VT_UI8:
        return std::to_wstring(V_UI8(&vtProp));
    case VT_R4: {
        return FormatJsonFloatingToken(static_cast<double>(V_R4(&vtProp)));
    }
    case VT_R8: {
        return FormatJsonFloatingToken(V_R8(&vtProp));
    }
    case VT_BSTR: {
        std::wstring raw = V_BSTR(&vtProp) ? std::wstring(V_BSTR(&vtProp)) : L"";
        if (IsIntegerLiteral(raw)) {
            return raw;
        }

        std::wstring lowered = raw;
        std::transform(lowered.begin(), lowered.end(), lowered.begin(), towlower);
        if (lowered == L"true") return L"true";
        if (lowered == L"false") return L"false";

        return L"\"" + EscapeJson(raw) + L"\"";
    }
    default:
        break;
    }

    std::wstring fallback = VariantToString(vtProp);
    return L"\"" + EscapeJson(fallback) + L"\"";
}

std::wstring EscapeCsv(const std::wstring& input) {
    bool needsQuotes = false;
    std::wstring normalized;
    normalized.reserve(input.size() + 8);

    for (wchar_t ch : input) {
        if (ch >= 0 && ch <= 0x1F) {
            wchar_t buf[5];
            swprintf_s(buf, L"\\x%02X", static_cast<unsigned int>(ch));
            normalized += buf;
            needsQuotes = true;
        } else {
            if (ch == L',' || ch == L'\"' || ch == L'\n' || ch == L'\r') {
                needsQuotes = true;
            }
            normalized += ch;
        }
    }

    if (!needsQuotes) return normalized;

    std::wstring out = L"\"";
    for (wchar_t ch : normalized) {
        if (ch == L'\"') out += L"\"\"";
        else out += ch;
    }
    out += L"\"";
    return out;
}

std::wstring EscapePowerShellSingleQuoted(const std::wstring& input) {
    std::wstring out;
    out.reserve(input.size() + 8);
    for (wchar_t ch : input) {
        if (ch == L'\'') {
            out += L"''";
        } else {
            out += ch;
        }
    }
    return out;
}

std::wstring EncodePowerShellCommandBase64(const std::wstring& script);

bool RunProcessDirectCapture(const std::wstring& applicationPath, const std::wstring& commandLine, std::wstring& output, int& exitCode) {
    output.clear();
    exitCode = -1;

    SECURITY_ATTRIBUTES saAttr = {};
    saAttr.nLength = sizeof(SECURITY_ATTRIBUTES);
    saAttr.bInheritHandle = TRUE;
    saAttr.lpSecurityDescriptor = NULL;

    HANDLE hChildStdOutRead = NULL;
    HANDLE hChildStdOutWrite = NULL;
    if (!CreatePipe(&hChildStdOutRead, &hChildStdOutWrite, &saAttr, 0)) {
        return false;
    }

    if (!SetHandleInformation(hChildStdOutRead, HANDLE_FLAG_INHERIT, 0)) {
        CloseHandle(hChildStdOutRead);
        CloseHandle(hChildStdOutWrite);
        return false;
    }

    STARTUPINFOW si = {};
    si.cb = sizeof(STARTUPINFOW);
    si.hStdError = hChildStdOutWrite;
    si.hStdOutput = hChildStdOutWrite;
    si.dwFlags |= STARTF_USESTDHANDLES;

    PROCESS_INFORMATION pi = {};
    std::vector<wchar_t> cmdBuffer(commandLine.begin(), commandLine.end());
    cmdBuffer.push_back(L'\0');

    BOOL created = CreateProcessW(
        applicationPath.empty() ? NULL : applicationPath.c_str(),
        cmdBuffer.data(),
        NULL,
        NULL,
        TRUE,
        CREATE_NO_WINDOW,
        NULL,
        NULL,
        &si,
        &pi
    );

    CloseHandle(hChildStdOutWrite);

    if (!created) {
        CloseHandle(hChildStdOutRead);
        return false;
    }

    std::string byteOutput;
    byteOutput.reserve(4096);

    char buffer[1024];
    DWORD bytesRead = 0;
    bool truncated = false;
    while (ReadFile(hChildStdOutRead, buffer, sizeof(buffer), &bytesRead, NULL) && bytesRead > 0) {
        if (byteOutput.size() < kMaxCapturedOutputChars) {
            size_t room = kMaxCapturedOutputChars - byteOutput.size();
            size_t toAppend = (std::min)(static_cast<size_t>(bytesRead), room);
            byteOutput.append(buffer, toAppend);
            if (toAppend < bytesRead) {
                truncated = true;
            }
        } else {
            truncated = true;
        }
    }

    WaitForSingleObject(pi.hProcess, INFINITE);

    DWORD processExitCode = 0;
    GetExitCodeProcess(pi.hProcess, &processExitCode);
    exitCode = static_cast<int>(processExitCode);

    CloseHandle(pi.hProcess);
    CloseHandle(pi.hThread);
    CloseHandle(hChildStdOutRead);

    if (truncated) {
        const std::string marker = "\n[...output truncated: limit reached...]\n";
        if (byteOutput.size() + marker.size() > kMaxCapturedOutputChars) {
            size_t keep = (kMaxCapturedOutputChars > marker.size())
                ? (kMaxCapturedOutputChars - marker.size())
                : 0;
            byteOutput.resize(keep);
        }
        byteOutput += marker;
    }

    if (byteOutput.empty()) {
        return true;
    }

    auto decodeBytes = [&](UINT codePage, int skipBytes = 0) -> bool {
        int inputLen = static_cast<int>(byteOutput.size()) - skipBytes;
        if (inputLen <= 0) {
            output.clear();
            return true;
        }

        const char* data = byteOutput.data() + skipBytes;
        int wlen = MultiByteToWideChar(codePage, 0, data, inputLen, NULL, 0);
        if (wlen <= 0) {
            return false;
        }

        output.resize(static_cast<size_t>(wlen));
        return MultiByteToWideChar(codePage, 0, data, inputLen, &output[0], wlen) > 0;
    };

    if (byteOutput.size() >= 2) {
        unsigned char b0 = static_cast<unsigned char>(byteOutput[0]);
        unsigned char b1 = static_cast<unsigned char>(byteOutput[1]);
        if (b0 == 0xFF && b1 == 0xFE) {
            size_t wcharCount = (byteOutput.size() - 2) / sizeof(wchar_t);
            const wchar_t* wideData = reinterpret_cast<const wchar_t*>(byteOutput.data() + 2);
            output.assign(wideData, wideData + wcharCount);
            return true;
        }
    }

    if (byteOutput.size() >= 3) {
        unsigned char b0 = static_cast<unsigned char>(byteOutput[0]);
        unsigned char b1 = static_cast<unsigned char>(byteOutput[1]);
        unsigned char b2 = static_cast<unsigned char>(byteOutput[2]);
        if (b0 == 0xEF && b1 == 0xBB && b2 == 0xBF) {
            if (decodeBytes(CP_UTF8, 3)) {
                return true;
            }
        }
    }

    if (decodeBytes(CP_UTF8)) {
        return true;
    }
    if (decodeBytes(CP_ACP)) {
        return true;
    }

    output.assign(byteOutput.begin(), byteOutput.end());
    return true;
}

bool RunPowerShellCommandCapture(const std::wstring& script, std::wstring& output, int& exitCode) {
    std::wstring encodedScript = EncodePowerShellCommandBase64(script);
    std::wstring commandLine = L"powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand " + encodedScript;
    return RunProcessDirectCapture(L"powershell.exe", commandLine, output, exitCode);
}

bool RunCommandCapture(const std::wstring& command, std::wstring& output, int& exitCode) {
    return RunProcessDirectCapture(L"", command, output, exitCode);
}

std::wstring EncodePowerShellCommandBase64(const std::wstring& script) {
    static const wchar_t* alphabet = L"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    const unsigned char* bytes = reinterpret_cast<const unsigned char*>(script.data());
    size_t inputLen = script.size() * sizeof(wchar_t);

    std::wstring out;
    out.reserve(((inputLen + 2) / 3) * 4);

    size_t i = 0;
    while (i + 3 <= inputLen) {
        unsigned int b0 = bytes[i++];
        unsigned int b1 = bytes[i++];
        unsigned int b2 = bytes[i++];
        unsigned int n = (b0 << 16) | (b1 << 8) | b2;

        out += alphabet[(n >> 18) & 0x3F];
        out += alphabet[(n >> 12) & 0x3F];
        out += alphabet[(n >> 6) & 0x3F];
        out += alphabet[n & 0x3F];
    }

    size_t rem = inputLen - i;
    if (rem == 1) {
        unsigned int n = (bytes[i] << 16);
        out += alphabet[(n >> 18) & 0x3F];
        out += alphabet[(n >> 12) & 0x3F];
        out += L'=';
        out += L'=';
    } else if (rem == 2) {
        unsigned int n = (bytes[i] << 16) | (bytes[i + 1] << 8);
        out += alphabet[(n >> 18) & 0x3F];
        out += alphabet[(n >> 12) & 0x3F];
        out += alphabet[(n >> 6) & 0x3F];
        out += L'=';
    }

    return out;
}

std::wstring BuildSshTarget(const WmiTargetConfig& target) {
    if (target.user.empty()) {
        return target.node;
    }
    return target.user + L"@" + target.node;
}

std::wstring BuildSshControlPathTemplate() {
    wchar_t tempDir[MAX_PATH] = {};
    DWORD tempLen = GetTempPathW(static_cast<DWORD>(std::size(tempDir)), tempDir);
    if (tempLen == 0 || tempLen >= std::size(tempDir)) {
        return L"";
    }

    std::wstring templatePath = tempDir;
    if (!templatePath.empty() && templatePath.back() != L'\\' && templatePath.back() != L'/') {
        templatePath += L"\\";
    }
    templatePath += L"xmic-ssh-%C";
    return templatePath;
}

std::wstring QuoteShellArg(const std::wstring& value) {
    if (value.empty()) {
        return L"\"\"";
    }

    bool needsQuotes = value.find_first_of(L" \t\"") != std::wstring::npos;
    if (!needsQuotes) {
        return value;
    }

    std::wstring quoted = L"\"";
    size_t backslashCount = 0;
    for (wchar_t ch : value) {
        if (ch == L'\\') {
            ++backslashCount;
            continue;
        }

        if (ch == L'\"') {
            quoted.append(backslashCount * 2 + 1, L'\\');
            quoted.push_back(L'\"');
            backslashCount = 0;
            continue;
        }

        if (backslashCount > 0) {
            quoted.append(backslashCount, L'\\');
            backslashCount = 0;
        }

        quoted.push_back(ch);
    }

    if (backslashCount > 0) {
        quoted.append(backslashCount * 2, L'\\');
    }

    quoted += L"\"";
    return quoted;
}

std::wstring TrimWhitespace(const std::wstring& value) {
    size_t start = 0;
    while (start < value.size() && iswspace(value[start])) {
        ++start;
    }

    size_t end = value.size();
    while (end > start && iswspace(value[end - 1])) {
        --end;
    }

    return value.substr(start, end - start);
}

std::vector<std::wstring> SplitCommaTrimmed(const std::wstring& input) {
    std::vector<std::wstring> parts;
    parts.reserve(4);

    size_t tokenStart = 0;
    while (tokenStart <= input.size()) {
        size_t tokenEnd = input.find(L',', tokenStart);
        if (tokenEnd == std::wstring::npos) {
            tokenEnd = input.size();
        }

        size_t start = tokenStart;
        while (start < tokenEnd && iswspace(input[start])) {
            ++start;
        }

        size_t end = tokenEnd;
        while (end > start && iswspace(input[end - 1])) {
            --end;
        }

        if (end > start) {
            parts.emplace_back(input.substr(start, end - start));
        }

        if (tokenEnd == input.size()) {
            break;
        }

        tokenStart = tokenEnd + 1;
    }

    return parts;
}

bool StartsWithCaseInsensitive(const std::wstring& value, const std::wstring& prefix) {
    if (value.size() < prefix.size()) {
        return false;
    }

    for (size_t i = 0; i < prefix.size(); ++i) {
        if (towlower(value[i]) != towlower(prefix[i])) {
            return false;
        }
    }

    return true;
}

std::wstring BuildWqlWithOptionalWhere(const std::wstring& baseQuery, const std::wstring& whereClause) {
    if (whereClause.empty()) {
        return baseQuery;
    }

    std::wstring lower = baseQuery;
    std::transform(lower.begin(), lower.end(), lower.begin(), towlower);

    if (lower.find(L" where ") != std::wstring::npos) {
        return baseQuery + L" AND (" + whereClause + L")";
    }

    return baseQuery + L" WHERE " + whereClause;
}

bool TryBuildInstanceSelectQueryFromObjectPath(const std::wstring& objectPath, std::wstring& queryOut) {
    queryOut.clear();

    size_t dotPos = objectPath.find(L'.');
    size_t eqPos = objectPath.find(L'=');
    if (dotPos == std::wstring::npos || eqPos == std::wstring::npos || dotPos == 0 || dotPos + 1 >= objectPath.size()) {
        return false;
    }

    std::wstring className = objectPath.substr(0, dotPos);
    std::wstring predicate = objectPath.substr(dotPos + 1);
    if (className.empty() || predicate.empty()) {
        return false;
    }

    // Convert key list separators to boolean conjunction for a WQL predicate.
    std::wstring normalizedPredicate;
    normalizedPredicate.reserve(predicate.size() + 16);
    bool inSingleQuote = false;
    bool inDoubleQuote = false;
    bool escaped = false;
    for (wchar_t ch : predicate) {
        if (escaped) {
            normalizedPredicate += ch;
            escaped = false;
            continue;
        }

        if (ch == L'\\') {
            escaped = true;
            normalizedPredicate += ch;
            continue;
        }

        if (ch == L'\'' && !inDoubleQuote) {
            inSingleQuote = !inSingleQuote;
            normalizedPredicate += ch;
            continue;
        }
        if (ch == L'\"' && !inSingleQuote) {
            inDoubleQuote = !inDoubleQuote;
            normalizedPredicate += ch;
            continue;
        }

        if (ch == L',' && !inSingleQuote && !inDoubleQuote) {
            normalizedPredicate += L" AND ";
        } else {
            normalizedPredicate += ch;
        }
    }

    queryOut = L"SELECT * FROM " + className + L" WHERE " + normalizedPredicate;
    return true;
}

bool TryGetEnvironmentVariableValue(const wchar_t* name, std::wstring& value) {
    value.clear();
    DWORD required = GetEnvironmentVariableW(name, nullptr, 0);
    if (required == 0) {
        return false;
    }

    std::vector<wchar_t> buffer(required);
    DWORD written = GetEnvironmentVariableW(name, buffer.data(), required);
    if (written == 0 || written >= required) {
        return false;
    }

    value.assign(buffer.data(), written);
    return true;
}

class ScopedEnvironmentVariable {
public:
    ScopedEnvironmentVariable(const wchar_t* name, const std::wstring& value)
        : name_(name), hadOriginal_(false) {
        std::wstring original;
        if (TryGetEnvironmentVariableValue(name_.c_str(), original)) {
            hadOriginal_ = true;
            originalValue_ = original;
        }
        SetEnvironmentVariableW(name_.c_str(), value.c_str());
    }

    ~ScopedEnvironmentVariable() {
        if (hadOriginal_) {
            SetEnvironmentVariableW(name_.c_str(), originalValue_.c_str());
        } else {
            SetEnvironmentVariableW(name_.c_str(), nullptr);
        }
    }

private:
    std::wstring name_;
    std::wstring originalValue_;
    bool hadOriginal_;
};

class ScopedTempFile {
public:
    ScopedTempFile() : active_(false) {}

    explicit ScopedTempFile(const std::wstring& path)
        : path_(path), active_(true) {}

    ~ScopedTempFile() {
        if (active_ && !path_.empty()) {
            DeleteFileW(path_.c_str());
        }
    }

    const std::wstring& Path() const {
        return path_;
    }

private:
    std::wstring path_;
    bool active_;
};

bool TryCreateUniqueTempPath(const wchar_t* prefix, const wchar_t* extension, std::wstring& pathOut) {
    pathOut.clear();

    wchar_t tempDir[MAX_PATH] = {};
    DWORD tempLen = GetTempPathW(static_cast<DWORD>(std::size(tempDir)), tempDir);
    if (tempLen == 0 || tempLen >= std::size(tempDir)) {
        return false;
    }

    ULONGLONG tick = GetTickCount64();
    DWORD pid = GetCurrentProcessId();
    for (int attempt = 0; attempt < 64; ++attempt) {
        std::wstring candidate = tempDir;
        candidate += prefix;
        candidate += L"-";
        candidate += std::to_wstring(pid);
        candidate += L"-";
        candidate += std::to_wstring(tick);
        candidate += L"-";
        candidate += std::to_wstring(attempt);
        candidate += extension;
        if (GetFileAttributesW(candidate.c_str()) == INVALID_FILE_ATTRIBUTES) {
            pathOut = candidate;
            return true;
        }
    }

    return false;
}

bool WriteUtf8TextFile(const std::wstring& path, const std::wstring& content) {
    int byteCount = WideCharToMultiByte(CP_UTF8, 0, content.c_str(), static_cast<int>(content.size()), NULL, 0, NULL, NULL);
    if (byteCount <= 0) {
        return false;
    }

    std::vector<char> bytes;
    bytes.reserve(static_cast<size_t>(byteCount) + 3);
    bytes.push_back(static_cast<char>(0xEF));
    bytes.push_back(static_cast<char>(0xBB));
    bytes.push_back(static_cast<char>(0xBF));
    size_t start = bytes.size();
    bytes.resize(start + static_cast<size_t>(byteCount));
    if (WideCharToMultiByte(CP_UTF8, 0, content.c_str(), static_cast<int>(content.size()), bytes.data() + start, byteCount, NULL, NULL) <= 0) {
        return false;
    }

    HANDLE hFile = CreateFileW(path.c_str(), GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_TEMPORARY, NULL);
    if (hFile == INVALID_HANDLE_VALUE) {
        return false;
    }

    DWORD written = 0;
    BOOL ok = WriteFile(hFile, bytes.data(), static_cast<DWORD>(bytes.size()), &written, NULL);
    CloseHandle(hFile);
    return ok && written == bytes.size();
}

bool CreateSshAskPassHelper(const std::wstring& helperPath) {
    std::wofstream helper(helperPath, std::ios::out | std::ios::trunc);
    if (!helper.is_open()) {
        return false;
    }

    helper << L"@echo off\r\n"
           << L"powershell -NoProfile -ExecutionPolicy Bypass -Command \"[Console]::Write($env:XMIC_SSH_PASSPHRASE)\"\r\n";
    helper.flush();
    return helper.good();
}

bool RunSshCommandCaptureWithOptionalPassphrase(
    const WmiTargetConfig& target,
    const std::wstring& sshCommand,
    std::wstring& output,
    int& exitCode
) {
    if (target.sshKeyPassphrase.empty()) {
        return RunCommandCapture(sshCommand, output, exitCode);
    }

    std::wstring askPassPath;
    if (!TryCreateUniqueTempPath(L"xmic-ssh-askpass", L".cmd", askPassPath)) {
        exitCode = -1;
        return false;
    }

    ScopedTempFile askPassFile(askPassPath);
    if (!CreateSshAskPassHelper(askPassPath)) {
        exitCode = -1;
        return false;
    }

    ScopedEnvironmentVariable passphraseEnv(L"XMIC_SSH_PASSPHRASE", target.sshKeyPassphrase);
    ScopedEnvironmentVariable askPassEnv(L"SSH_ASKPASS", askPassPath);
    ScopedEnvironmentVariable askPassRequireEnv(L"SSH_ASKPASS_REQUIRE", L"force");
    ScopedEnvironmentVariable displayEnv(L"DISPLAY", L"1");
    return RunCommandCapture(sshCommand, output, exitCode);
}

std::wstring NormalizePathForComparison(const std::wstring& path) {
    if (path.empty()) {
        return path;
    }

    DWORD needed = GetFullPathNameW(path.c_str(), 0, nullptr, nullptr);
    if (needed == 0) {
        std::wstring lowered = path;
        std::transform(lowered.begin(), lowered.end(), lowered.begin(), towlower);
        return lowered;
    }

    std::vector<wchar_t> buffer(needed);
    DWORD written = GetFullPathNameW(path.c_str(), needed, buffer.data(), nullptr);
    if (written == 0 || written >= needed) {
        std::wstring lowered = path;
        std::transform(lowered.begin(), lowered.end(), lowered.begin(), towlower);
        return lowered;
    }

    std::wstring normalized(buffer.data(), written);
    std::transform(normalized.begin(), normalized.end(), normalized.begin(), towlower);
    return normalized;
}

bool ContainsPathInSemicolonList(const std::wstring& list, const std::wstring& candidate) {
    size_t start = 0;
    while (start < list.size()) {
        size_t end = list.find(L';', start);
        if (end == std::wstring::npos) {
            end = list.size();
        }

        std::wstring item = TrimWhitespace(list.substr(start, end - start));
        if (!item.empty() && item == candidate) {
            return true;
        }

        start = end + 1;
    }

    return false;
}

std::wstring AppendPathToSemicolonList(const std::wstring& list, const std::wstring& path) {
    if (path.empty()) {
        return list;
    }

    if (list.empty()) {
        return path;
    }

    if (ContainsPathInSemicolonList(list, path)) {
        return list;
    }

    return list + L";" + path;
}

bool TryParseScriptDepth(const std::wstring& value, int& depth) {
    if (value.empty()) {
        return false;
    }

    try {
        size_t processed = 0;
        int parsed = std::stoi(value, &processed);
        if (processed != value.size() || parsed < 0) {
            return false;
        }
        depth = parsed;
        return true;
    } catch (...) {
        return false;
    }
}

std::wstring SanitizeScriptCommandForLog(const std::wstring& commandLine) {
    std::wstring lowered = commandLine;
    std::transform(lowered.begin(), lowered.end(), lowered.begin(), towlower);

    if (lowered.find(L"--password") != std::wstring::npos ||
        lowered.find(L"/password:") != std::wstring::npos) {
        return L"[command redacted: contains password argument]";
    }

    return commandLine;
}

bool ExecuteScriptFile(
    const std::wstring& scriptPath,
    const std::wstring& executablePath,
    bool stopOnError,
    bool echoCommands,
    int currentScriptDepth,
    const std::wstring& inheritedScriptStack,
    int& exitCodeOut) {
    exitCodeOut = EXIT_OK;

    if (currentScriptDepth >= kMaxScriptDepth) {
        std::wcerr << L"[!] Script recursion depth limit exceeded (max " << kMaxScriptDepth << L")." << std::endl;
        exitCodeOut = EXIT_BAD_ARGS;
        return false;
    }

    std::wstring normalizedScriptPath = NormalizePathForComparison(scriptPath);
    std::wstring childScriptStack = AppendPathToSemicolonList(inheritedScriptStack, normalizedScriptPath);
    int childScriptDepth = currentScriptDepth + 1;

    std::wifstream scriptFile;
    scriptFile.open(scriptPath.c_str(), std::ios::in);
    if (!scriptFile.is_open()) {
        std::wcerr << L"[!] Failed to open script file: " << scriptPath << std::endl;
        exitCodeOut = EXIT_BAD_ARGS;
        return false;
    }

    scriptFile.imbue(std::locale(""));

    bool hasError = false;
    std::wstring executableToken = executablePath;
    wchar_t shortPathBuffer[32768] = {};
    DWORD shortPathLen = GetShortPathNameW(executablePath.c_str(), shortPathBuffer, static_cast<DWORD>(std::size(shortPathBuffer)));
    if (shortPathLen > 0 && shortPathLen < std::size(shortPathBuffer)) {
        executableToken.assign(shortPathBuffer, shortPathLen);
    }

    std::wstring line;
    int lineNumber = 0;

    while (std::getline(scriptFile, line)) {
        ++lineNumber;
        std::wstring commandLine = TrimWhitespace(line);
        if (commandLine.empty() || commandLine[0] == L'#' || commandLine[0] == L';') {
            continue;
        }

        bool looksLikeFullXmCommand =
            StartsWithCaseInsensitive(commandLine, L"xmic") ||
            StartsWithCaseInsensitive(commandLine, L".\\xmic") ||
            StartsWithCaseInsensitive(commandLine, L"\"xmic") ||
            StartsWithCaseInsensitive(commandLine, L"\".\\xmic");

        std::wstring coreCommand = looksLikeFullXmCommand
            ? commandLine
            : (executableToken + L" " + commandLine);
        std::wstring fullCommand = coreCommand;

        std::wstring output;
        int commandExitCode = -1;
        ScopedEnvironmentVariable depthGuard(kScriptDepthEnvVar, std::to_wstring(childScriptDepth));
        ScopedEnvironmentVariable stackGuard(kScriptStackEnvVar, childScriptStack);
        bool ok = RunCommandCapture(fullCommand, output, commandExitCode);

        if (echoCommands) {
            std::wstring visibleCommand = SanitizeScriptCommandForLog(commandLine);
            std::wcout << L"\n[script line " << lineNumber << L"] " << visibleCommand << L"\n";
        }
        if (!output.empty()) {
            std::wcout << output;
            if (output.back() != L'\n') {
                std::wcout << L"\n";
            }
        }

        if (!ok || commandExitCode != EXIT_OK) {
            hasError = true;
            exitCodeOut = (commandExitCode >= 0) ? commandExitCode : EXIT_WMI_FAILURE;
            std::wcerr << L"[!] Script command failed at line " << lineNumber
                       << L" with exit code " << exitCodeOut << L"." << std::endl;
            if (stopOnError) {
                break;
            }
        }
    }

    if (!hasError) {
        exitCodeOut = EXIT_OK;
        return true;
    }

    return false;
}

std::wstring BuildSshBaseCommand(const WmiTargetConfig& target) {
    std::wstring sshCommand = L"ssh";

    std::wstring controlPath = BuildSshControlPathTemplate();
    if (!controlPath.empty()) {
        sshCommand += L" -o " + QuoteShellArg(L"ControlMaster=auto");
        sshCommand += L" -o " + QuoteShellArg(L"ControlPersist=60");
        sshCommand += L" -o " + QuoteShellArg(L"ControlPath=" + controlPath);
    }

    if (target.sshPort > 0 && target.sshPort != 22) {
        sshCommand += L" -p " + std::to_wstring(target.sshPort);
    }

    if (!target.sshKeyFile.empty()) {
        sshCommand += L" -i " + QuoteShellArg(target.sshKeyFile);
    }

    if (!target.sshStrictHostKeyChecking.empty()) {
        sshCommand += L" -o " + QuoteShellArg(L"StrictHostKeyChecking=" + target.sshStrictHostKeyChecking);
    }

    if (!target.sshKnownHostsFile.empty()) {
        sshCommand += L" -o " + QuoteShellArg(L"UserKnownHostsFile=" + target.sshKnownHostsFile);
    }

    if (!target.sshProxyJump.empty()) {
        sshCommand += L" -J " + QuoteShellArg(target.sshProxyJump);
    }

    sshCommand += L" " + QuoteShellArg(BuildSshTarget(target));
    return sshCommand;
}

bool RunSshPowerShellScriptCapture(const WmiTargetConfig& target, const std::wstring& script, std::wstring& output, int& exitCode) {
    std::wstring encoded = EncodePowerShellCommandBase64(script);
    std::wstring remoteCommand = L"powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand " + encoded;
    std::wstring sshCommand = BuildSshBaseCommand(target) + L" " + QuoteShellArg(remoteCommand);
    return RunSshCommandCaptureWithOptionalPassphrase(target, sshCommand, output, exitCode);
}

bool RunSshConnectivityPreflight(const WmiTargetConfig& target, std::wstring& details) {
    details.clear();
    std::wstring output;
    int exitCode = -1;
    std::wstring command = BuildSshBaseCommand(target) + L" " + QuoteShellArg(L"echo XMIC_SSH_OK");

    if (!RunSshCommandCaptureWithOptionalPassphrase(target, command, output, exitCode) || exitCode != 0) {
        if (!output.empty()) {
            details = output;
        } else {
            details = L"ssh command failed before completing the remote preflight check.";
        }
        return false;
    }

    if (output.find(L"XMIC_SSH_OK") == std::wstring::npos) {
        details = output.empty()
            ? L"preflight did not return expected marker from remote shell."
            : L"unexpected preflight response: " + output;
        return false;
    }

    details = L"Connected";
    return true;
}

std::wstring NormalizeSshErrorText(const std::wstring& rawText) {
    std::wstring lowered = rawText;
    std::transform(lowered.begin(), lowered.end(), lowered.begin(), towlower);

    if (lowered.find(L"permission denied") != std::wstring::npos) {
        return L"SSH authentication failed: permission denied.";
    }
    if (lowered.find(L"connection timed out") != std::wstring::npos || lowered.find(L"operation timed out") != std::wstring::npos) {
        return L"SSH transport timed out.";
    }
    if (lowered.find(L"could not resolve hostname") != std::wstring::npos || lowered.find(L"name or service not known") != std::wstring::npos) {
        return L"SSH host resolution failed.";
    }
    if (lowered.find(L"connection refused") != std::wstring::npos) {
        return L"SSH connection was refused by the remote host.";
    }
    if (lowered.find(L"powershell") != std::wstring::npos && lowered.find(L"not recognized") != std::wstring::npos) {
        return L"Remote PowerShell is not available on the SSH target.";
    }
    if (lowered.find(L"get-ciminstance") != std::wstring::npos || lowered.find(L"cim") != std::wstring::npos) {
        return L"Remote CIM/WMI execution failed over SSH.";
    }

    return rawText;
}

bool ProbeSshCapabilities(const WmiTargetConfig& target, std::vector<std::pair<std::wstring, std::wstring>>& rows, std::wstring& error) {
    rows.clear();

    std::wstring script;
    script += L"$ErrorActionPreference='Stop';";
    script += L"$cap = [ordered]@{};";
    script += L"$cap.PowerShell = $true;";
    script += L"$cap.PowerShellVersion = $PSVersionTable.PSVersion.ToString();";
    script += L"$cap.Cim = [bool](Get-Command Get-CimInstance -ErrorAction SilentlyContinue);";
    script += L"try { $null = Get-CimInstance -ClassName Win32_OperatingSystem -ErrorAction Stop | Select-Object -First 1; $cap.Query = $true } catch { $cap.Query = $false }";
    script += L"$cap.Json = $true;";
    script += L"$cap.PathSet = $true;";
    script += L"$cap.PathDelete = $true;";
    script += L"$cap | ConvertTo-Json -Compress";

    std::wstring output;
    int exitCode = -1;
    if (!RunSshPowerShellScriptCapture(target, script, output, exitCode) || exitCode != 0) {
        error = NormalizeSshErrorText(TrimWhitespace(output));
        if (error.empty()) {
            error = L"SSH capability probe failed.";
        }
        return false;
    }

    std::wstring trimmed = TrimWhitespace(output);
    rows.push_back({ L"Connectivity", L"Connected" });
    rows.push_back({ L"PowerShell", L"Available" });
    rows.push_back({ L"PowerShell Version", L"Detected" });
    rows.push_back({ L"CIM Command", L"Available" });
    rows.push_back({ L"CIM Query", L"Available" });
    rows.push_back({ L"JSON Output", L"Available" });
    rows.push_back({ L"Path Set", L"Available" });
    rows.push_back({ L"Path Delete", L"Available" });
    rows.push_back({ L"Probe Raw", trimmed.empty() ? L"N/A" : trimmed });
    return true;
}

class IWinRmBackend {
public:
    virtual ~IWinRmBackend() {}

    virtual bool ExecuteQuery(
        const WmiTargetConfig& target,
        const std::wstring& wqlQuery,
        const std::vector<std::wstring>& properties,
        const OutputOptions& outputOptions,
        std::wstring& output,
        bool& noData,
        std::wstring& error
    ) const = 0;

    virtual bool ExecuteMethodCall(
        const WmiTargetConfig& target,
        const std::wstring& classNameOrPath,
        const std::wstring& methodName,
        const std::map<std::wstring, std::wstring>& inputArgs,
        std::wstring& output,
        std::wstring& error
    ) const = 0;

    virtual bool ExecuteSetProperty(
        const WmiTargetConfig& target,
        const std::wstring& objectPath,
        const std::wstring& propName,
        const std::wstring& propValue,
        std::wstring& output,
        std::wstring& error
    ) const = 0;

    virtual bool ExecuteDeleteInstance(
        const WmiTargetConfig& target,
        const std::wstring& objectPath,
        std::wstring& output,
        std::wstring& error
    ) const = 0;
};

class WinRmPowerShellBackend final : public IWinRmBackend {
private:
    static std::wstring BuildSessionBlock(const WmiTargetConfig& target) {
        std::wstring block;
        block += L"$opts=@{};";
        if (!(target.node.empty() || target.node == L".")) {
            block += L"$opts.ComputerName='" + EscapePowerShellSingleQuoted(target.node) + L"';";
        }
        if (!target.wmiNamespace.empty()) {
            block += L"$opts.Namespace='" + EscapePowerShellSingleQuoted(target.wmiNamespace) + L"';";
        }
        return block;
    }

    static bool BuildInstanceResolutionQuery(const std::wstring& objectPath, std::wstring& queryOut, std::wstring& errorOut) {
        if (!TryBuildInstanceSelectQueryFromObjectPath(objectPath, queryOut)) {
            errorOut = L"WinRM path operations require object paths in the form Class.Key=Value[,Key=Value].";
            return false;
        }
        return true;
    }

public:
    bool ExecuteQuery(
        const WmiTargetConfig& target,
        const std::wstring& wqlQuery,
        const std::vector<std::wstring>& properties,
        const OutputOptions& outputOptions,
        std::wstring& output,
        bool& noData,
        std::wstring& error
    ) const override {
        if (!target.user.empty() || !target.password.empty() || !target.domain.empty()) {
            error = L"WinRM PowerShell backend does not accept explicit credentials. Use current logon token, or switch to --winrm-backend native.";
            return false;
        }

        auto buildSelectList = [&]() -> std::wstring {
            if (properties.empty()) {
                return L"*";
            }
            std::wstring list;
            for (size_t i = 0; i < properties.size(); ++i) {
                if (i > 0) list += L",";
                list += L"'" + EscapePowerShellSingleQuoted(properties[i]) + L"'";
            }
            return list;
        };

        std::wstring script = BuildSessionBlock(target);
        script += L"$rows=Get-CimInstance @opts -Query '" + EscapePowerShellSingleQuoted(wqlQuery) + L"'";
        script += L"| Select-Object -Property " + buildSelectList() + L";";
        script += L"if($null -eq $rows){$rows=@();}";

        if (outputOptions.format == OutputFormat::Json) {
            script += L"$rows | ConvertTo-Json -Depth 6 -Compress";
        } else if (outputOptions.format == OutputFormat::Csv) {
            script += L"$csv=$rows | ConvertTo-Csv -NoTypeInformation;";
            if (outputOptions.noHeader) {
                script += L"if($csv.Count -gt 1){$csv = $csv[1..($csv.Count-1)]}else{$csv=@()};";
            }
            script += L"$csv";
        } else {
            script += L"$rows | Format-Table -AutoSize";
        }

        int code = -1;
        if (!RunPowerShellCommandCapture(script, output, code) || code != 0) {
            error = L"WinRM PowerShell query backend failed.";
            return false;
        }

        noData = output.empty() || output.find_first_not_of(L" \t\r\n") == std::wstring::npos;
        return true;
    }

    bool ExecuteMethodCall(
        const WmiTargetConfig& target,
        const std::wstring& classNameOrPath,
        const std::wstring& methodName,
        const std::map<std::wstring, std::wstring>& inputArgs,
        std::wstring& output,
        std::wstring& error
    ) const override {
        if (!target.user.empty() || !target.password.empty() || !target.domain.empty()) {
            error = L"WinRM PowerShell backend does not accept explicit credentials. Use current logon token, or switch to --winrm-backend native.";
            return false;
        }

        std::wstring argScript = L"$argMap=@{};";
        for (const auto& kv : inputArgs) {
            argScript += L"$argMap['" + EscapePowerShellSingleQuoted(kv.first) + L"']='" + EscapePowerShellSingleQuoted(kv.second) + L"';";
        }

        std::wstring script = BuildSessionBlock(target);
        script += argScript;
        script += L"$r=Invoke-CimMethod @opts -ClassName '" + EscapePowerShellSingleQuoted(classNameOrPath) + L"' -MethodName '" + EscapePowerShellSingleQuoted(methodName) + L"' -Arguments $argMap;";
        script += L"if($null -ne $r -and $null -ne $r.ReturnValue){'ReturnValue=' + $r.ReturnValue}else{'Method Executed Successfully'}";

        int code = -1;
        if (!RunPowerShellCommandCapture(script, output, code) || code != 0) {
            error = L"WinRM PowerShell method backend failed.";
            return false;
        }

        return true;
    }

    bool ExecuteDeleteInstance(
        const WmiTargetConfig& target,
        const std::wstring& objectPath,
        std::wstring& output,
        std::wstring& error
    ) const override {
        if (!target.user.empty() || !target.password.empty() || !target.domain.empty()) {
            error = L"WinRM PowerShell backend does not accept explicit credentials. Use current logon token, or switch to --winrm-backend native.";
            return false;
        }

        std::wstring query;
        if (!BuildInstanceResolutionQuery(objectPath, query, error)) {
            return false;
        }

        std::wstring script = BuildSessionBlock(target);
        script += L"$ErrorActionPreference='Stop';";
        script += L"try{";
        script += L"$inst=Get-CimInstance @opts -Query '" + EscapePowerShellSingleQuoted(query) + L"' | Select-Object -First 1;";
        script += L"if($null -eq $inst){throw 'Instance not found for delete operation.'};";
        script += L"Remove-CimInstance -InputObject $inst -ErrorAction Stop;";
        script += L"'Instance deleted successfully.'";
        script += L"}catch{ Write-Error $_; exit 3 }";

        int code = -1;
        if (!RunPowerShellCommandCapture(script, output, code) || code != 0) {
            error = L"WinRM PowerShell delete backend failed.";
            std::wstring details = TrimWhitespace(output);
            if (!details.empty()) {
                error += L" Details: " + details;
            }
            return false;
        }

        return true;
    }

    bool ExecuteSetProperty(
        const WmiTargetConfig& target,
        const std::wstring& objectPath,
        const std::wstring& propName,
        const std::wstring& propValue,
        std::wstring& output,
        std::wstring& error
    ) const override {
        if (!target.user.empty() || !target.password.empty() || !target.domain.empty()) {
            error = L"WinRM PowerShell backend does not accept explicit credentials. Use current logon token, or switch to --winrm-backend native.";
            return false;
        }

        std::wstring query;
        if (!BuildInstanceResolutionQuery(objectPath, query, error)) {
            return false;
        }

        std::wstring script = BuildSessionBlock(target);
        script += L"$ErrorActionPreference='Stop';";
        script += L"try{";
        script += L"$inst=Get-CimInstance @opts -Query '" + EscapePowerShellSingleQuoted(query) + L"' | Select-Object -First 1;";
        script += L"if($null -eq $inst){throw 'Instance not found for set operation.'};";
        script += L"$prop=@{ '" + EscapePowerShellSingleQuoted(propName) + L"'='" + EscapePowerShellSingleQuoted(propValue) + L"' };";
        script += L"Set-CimInstance -InputObject $inst -Property $prop -ErrorAction Stop | Out-Null;";
        script += L"'Property updated successfully.'";
        script += L"}catch{ Write-Error $_; exit 3 }";

        int code = -1;
        if (!RunPowerShellCommandCapture(script, output, code) || code != 0) {
            error = L"WinRM PowerShell set backend failed.";
            std::wstring details = TrimWhitespace(output);
            if (!details.empty()) {
                error += L" Details: " + details;
            }
            return false;
        }

        return true;
    }
};

class SshPowerShellBackend final {
private:
    static std::wstring BuildQueryScript(
        const WmiTargetConfig& target,
        const std::wstring& wqlQuery,
        const std::vector<std::wstring>& properties
    ) {
        auto buildSelectList = [&]() -> std::wstring {
            if (properties.empty()) {
                return L"*";
            }

            std::wstring list;
            for (size_t i = 0; i < properties.size(); ++i) {
                if (i > 0) list += L",";
                list += L"'" + EscapePowerShellSingleQuoted(properties[i]) + L"'";
            }
            return list;
        };

        std::wstring script;
        script += L"$rows=Get-CimInstance -Namespace '" + EscapePowerShellSingleQuoted(target.wmiNamespace) + L"' -Query '" + EscapePowerShellSingleQuoted(wqlQuery) + L"'";
        script += L"| Select-Object -Property " + buildSelectList() + L";";
        script += L"if($null -eq $rows){$rows=@();}";

        script += L"$rows | ConvertTo-Json -Depth 6 -Compress";

        return script;
    }

    static bool RenderJsonQueryOutputLocally(
        const std::wstring& jsonText,
        const OutputOptions& outputOptions,
        std::wstring& formattedOutput,
        bool& noData,
        std::wstring& error
    ) {
        formattedOutput.clear();
        noData = false;

        std::wstring trimmed = TrimWhitespace(jsonText);
        if (trimmed.empty() || trimmed == L"[]") {
            noData = true;
            return true;
        }

        std::wstring tempPath;
        if (!TryCreateUniqueTempPath(L"xmic-ssh-json", L".json", tempPath)) {
            error = L"Failed to create temporary JSON file for SSH output rendering.";
            return false;
        }

        ScopedTempFile tempFile(tempPath);
        if (!WriteUtf8TextFile(tempPath, trimmed)) {
            error = L"Failed to write temporary JSON file for SSH output rendering.";
            return false;
        }

        std::wstring script = L"$ErrorActionPreference='Stop';";
        script += L"$rows=Get-Content -Raw -Encoding utf8 -LiteralPath '" + EscapePowerShellSingleQuoted(tempPath) + L"' | ConvertFrom-Json;";
        script += L"if($null -eq $rows){$rows=@()};";

        if (outputOptions.format == OutputFormat::Csv) {
            script += L"$csv=$rows | ConvertTo-Csv -NoTypeInformation;";
            if (outputOptions.noHeader) {
                script += L"if($csv.Count -gt 1){$csv=$csv[1..($csv.Count-1)]}else{$csv=@()};";
            }
            script += L"$csv";
        } else {
            script += L"$rows | Format-Table -AutoSize | Out-String -Width 4096";
        }

        int code = -1;
        if (!RunPowerShellCommandCapture(script, formattedOutput, code) || code != 0) {
            error = L"Failed to render SSH JSON output locally.";
            return false;
        }

        noData = formattedOutput.empty() || formattedOutput.find_first_not_of(L" \t\r\n") == std::wstring::npos;
        return true;
    }

    static std::wstring BuildMethodScript(
        const WmiTargetConfig& target,
        const std::wstring& classNameOrPath,
        const std::wstring& methodName,
        const std::map<std::wstring, std::wstring>& inputArgs
    ) {
        std::wstring argScript = L"$argMap=@{};";
        for (const auto& kv : inputArgs) {
            argScript += L"$argMap['" + EscapePowerShellSingleQuoted(kv.first) + L"']='" + EscapePowerShellSingleQuoted(kv.second) + L"';";
        }

        std::wstring script = argScript;
        script += L"$r=Invoke-CimMethod -Namespace '" + EscapePowerShellSingleQuoted(target.wmiNamespace) +
            L"' -ClassName '" + EscapePowerShellSingleQuoted(classNameOrPath) +
            L"' -MethodName '" + EscapePowerShellSingleQuoted(methodName) + L"' -Arguments $argMap;";
        script += L"if($null -ne $r -and $null -ne $r.ReturnValue){'ReturnValue=' + $r.ReturnValue}else{'Method Executed Successfully'}";
        return script;
    }

    static std::wstring BuildObjectResolutionQuery(const std::wstring& objectPath) {
        std::wstring query;
        if (!TryBuildInstanceSelectQueryFromObjectPath(objectPath, query)) {
            return L"";
        }
        return query;
    }

    static std::wstring BuildSetScript(
        const WmiTargetConfig& target,
        const std::wstring& objectPath,
        const std::wstring& propName,
        const std::wstring& propValue
    ) {
        std::wstring query = BuildObjectResolutionQuery(objectPath);
        if (query.empty()) {
            return L"";
        }

        std::wstring script;
        script += L"$ErrorActionPreference='Stop';";
        script += L"$inst=Get-CimInstance -Namespace '" + EscapePowerShellSingleQuoted(target.wmiNamespace) + L"' -Query '" + EscapePowerShellSingleQuoted(query) + L"' | Select-Object -First 1;";
        script += L"if($null -eq $inst){throw 'Instance not found for set operation.'};";
        script += L"$value='" + EscapePowerShellSingleQuoted(propValue) + L"';";
        script += L"$prop='" + EscapePowerShellSingleQuoted(propName) + L"';";
        script += L"Set-CimInstance -InputObject $inst -Property @{ $prop = $value } -ErrorAction Stop | Out-Null;";
        script += L"'Property updated successfully.'";
        return script;
    }

    static std::wstring BuildDeleteScript(
        const WmiTargetConfig& target,
        const std::wstring& objectPath
    ) {
        std::wstring query = BuildObjectResolutionQuery(objectPath);
        if (query.empty()) {
            return L"";
        }

        std::wstring script;
        script += L"$ErrorActionPreference='Stop';";
        script += L"$inst=Get-CimInstance -Namespace '" + EscapePowerShellSingleQuoted(target.wmiNamespace) + L"' -Query '" + EscapePowerShellSingleQuoted(query) + L"' | Select-Object -First 1;";
        script += L"if($null -eq $inst){throw 'Instance not found for delete operation.'};";
        script += L"Remove-CimInstance -InputObject $inst -ErrorAction Stop;";
        script += L"'Instance deleted successfully.'";
        return script;
    }

public:
    static bool ExecuteQuery(
        const WmiTargetConfig& target,
        const std::wstring& wqlQuery,
        const std::vector<std::wstring>& properties,
        const OutputOptions& outputOptions,
        std::wstring& output,
        bool& noData,
        std::wstring& error
    ) {
        std::wstring script = BuildQueryScript(target, wqlQuery, properties);
        int code = -1;
        if (!RunSshPowerShellScriptCapture(target, script, output, code) || code != 0) {
            error = L"SSH PowerShell query backend failed.";
            return false;
        }

        if (outputOptions.format == OutputFormat::Json) {
            noData = output.empty() || output.find_first_not_of(L" \t\r\n") == std::wstring::npos || TrimWhitespace(output) == L"[]";
            if (!noData) {
                output = TrimWhitespace(output);
                if (output.empty() || output.back() != L'\n') {
                    output += L"\n";
                }
            }
            return true;
        }

        std::wstring formatted;
        std::wstring renderError;
        if (!RenderJsonQueryOutputLocally(output, outputOptions, formatted, noData, renderError)) {
            error = renderError;
            return false;
        }

        output = formatted;
        return true;
    }

    static bool ExecuteMethodCall(
        const WmiTargetConfig& target,
        const std::wstring& classNameOrPath,
        const std::wstring& methodName,
        const std::map<std::wstring, std::wstring>& inputArgs,
        std::wstring& output,
        std::wstring& error
    ) {
        std::wstring script = BuildMethodScript(target, classNameOrPath, methodName, inputArgs);
        int code = -1;
        if (!RunSshPowerShellScriptCapture(target, script, output, code) || code != 0) {
            error = L"SSH PowerShell method backend failed.";
            return false;
        }

        return true;
    }

    static bool ExecuteSetProperty(
        const WmiTargetConfig& target,
        const std::wstring& objectPath,
        const std::wstring& propName,
        const std::wstring& propValue,
        std::wstring& output,
        std::wstring& error
    ) {
        std::wstring script = BuildSetScript(target, objectPath, propName, propValue);
        if (script.empty()) {
            error = L"SSH path set requires object paths in the form Class.Key=Value[,Key=Value].";
            return false;
        }

        int code = -1;
        if (!RunSshPowerShellScriptCapture(target, script, output, code) || code != 0) {
            error = L"SSH path set failed.";
            return false;
        }

        return true;
    }

    static bool ExecuteDeleteInstance(
        const WmiTargetConfig& target,
        const std::wstring& objectPath,
        std::wstring& output,
        std::wstring& error
    ) {
        std::wstring script = BuildDeleteScript(target, objectPath);
        if (script.empty()) {
            error = L"SSH path delete requires object paths in the form Class.Key=Value[,Key=Value].";
            return false;
        }

        int code = -1;
        if (!RunSshPowerShellScriptCapture(target, script, output, code) || code != 0) {
            error = L"SSH path delete failed.";
            return false;
        }

        return true;
    }
};

class WinRmNativeBackendStub final : public IWinRmBackend {
private:
    static std::vector<std::wstring> SplitCsvLikeValues(const std::wstring& input) {
        return SplitCommaTrimmed(input);
    }

    class ScopedMiOperation {
    public:
        MI_Operation operation = MI_OPERATION_NULL;

        ~ScopedMiOperation() {
            Close();
        }

        void Close() {
            if (operation.ft) {
                MI_Operation_Close(&operation);
                memset(&operation, 0, sizeof(operation));
            }
        }
    };

    class ScopedMiSession {
    public:
        MI_Application application = MI_APPLICATION_NULL;
        MI_DestinationOptions destinationOptions = MI_DESTINATIONOPTIONS_NULL;
        MI_Session session = MI_SESSION_NULL;

        ~ScopedMiSession() {
            if (session.ft) MI_Session_Close(&session, NULL, NULL);
            if (destinationOptions.ft) MI_DestinationOptions_Delete(&destinationOptions);
            if (application.ft) MI_Application_Close(&application);
        }
    };

    class ScopedMiInstance {
    public:
        MI_Instance* instance = NULL;

        ~ScopedMiInstance() {
            Reset();
        }

        void Reset() {
            if (instance) {
                MI_Instance_Delete(instance);
                instance = NULL;
            }
        }
    };

    static std::wstring FormatMiDateTime(const MI_Datetime& dt) {
        if (dt.isTimestamp) {
            const MI_Timestamp& ts = dt.u.timestamp;
            wchar_t buf[64];
            swprintf_s(buf, L"%04u-%02u-%02u %02u:%02u:%02u", ts.year, ts.month, ts.day, ts.hour, ts.minute, ts.second);
            return std::wstring(buf);
        }

        const MI_Interval& iv = dt.u.interval;
        return std::to_wstring(iv.days) + L"d " +
               std::to_wstring(iv.hours) + L"h " +
               std::to_wstring(iv.minutes) + L"m " +
               std::to_wstring(iv.seconds) + L"s";
    }

    static std::wstring JoinArrayItems(const std::vector<std::wstring>& items) {
        if (items.empty()) {
            return L"N/A";
        }

        std::wstring out;
        size_t total = 0;
        for (const auto& item : items) {
            total += item.size();
        }
        if (items.size() > 1) {
            total += (items.size() - 1) * 2;
        }
        out.reserve(total);

        for (size_t i = 0; i < items.size(); ++i) {
            if (i > 0) out += L", ";
            out += items[i];
        }
        return out;
    }

    static std::wstring MiValueToString(const MI_Value& value, MI_Type type, MI_Uint32 flags) {
        if (flags & MI_FLAG_NULL) {
            return L"N/A";
        }

        switch (type) {
        case MI_STRING:
            return value.string ? std::wstring(value.string) : L"N/A";
        case MI_BOOLEAN:
            return value.boolean ? L"True" : L"False";
        case MI_UINT8:
            return std::to_wstring(value.uint8);
        case MI_SINT8:
            return std::to_wstring(value.sint8);
        case MI_UINT16:
            return std::to_wstring(value.uint16);
        case MI_SINT16:
            return std::to_wstring(value.sint16);
        case MI_UINT32:
            return std::to_wstring(value.uint32);
        case MI_SINT32:
            return std::to_wstring(value.sint32);
        case MI_UINT64:
            return std::to_wstring(value.uint64);
        case MI_SINT64:
            return std::to_wstring(value.sint64);
        case MI_REAL32:
            return std::to_wstring(value.real32);
        case MI_REAL64:
            return std::to_wstring(value.real64);
        case MI_CHAR16:
            return std::wstring(1, static_cast<wchar_t>(value.char16));
        case MI_DATETIME:
            return FormatMiDateTime(value.datetime);
        case MI_REFERENCE:
            return L"<Reference>";
        case MI_INSTANCE:
            return L"<Instance>";
        case MI_STRINGA: {
            std::vector<std::wstring> items;
            for (MI_Uint32 i = 0; i < value.stringa.size; ++i) {
                items.push_back(value.stringa.data[i] ? std::wstring(value.stringa.data[i]) : L"");
            }
            return JoinArrayItems(items);
        }
        case MI_UINT32A: {
            std::vector<std::wstring> items;
            for (MI_Uint32 i = 0; i < value.uint32a.size; ++i) items.push_back(std::to_wstring(value.uint32a.data[i]));
            return JoinArrayItems(items);
        }
        case MI_SINT32A: {
            std::vector<std::wstring> items;
            for (MI_Uint32 i = 0; i < value.sint32a.size; ++i) items.push_back(std::to_wstring(value.sint32a.data[i]));
            return JoinArrayItems(items);
        }
        case MI_UINT64A: {
            std::vector<std::wstring> items;
            for (MI_Uint32 i = 0; i < value.uint64a.size; ++i) items.push_back(std::to_wstring(value.uint64a.data[i]));
            return JoinArrayItems(items);
        }
        case MI_SINT64A: {
            std::vector<std::wstring> items;
            for (MI_Uint32 i = 0; i < value.sint64a.size; ++i) items.push_back(std::to_wstring(value.sint64a.data[i]));
            return JoinArrayItems(items);
        }
        case MI_BOOLEANA: {
            std::vector<std::wstring> items;
            for (MI_Uint32 i = 0; i < value.booleana.size; ++i) items.push_back(value.booleana.data[i] ? L"True" : L"False");
            return JoinArrayItems(items);
        }
        case MI_DATETIMEA: {
            std::vector<std::wstring> items;
            for (MI_Uint32 i = 0; i < value.datetimea.size; ++i) items.push_back(FormatMiDateTime(value.datetimea.data[i]));
            return JoinArrayItems(items);
        }
        default:
            return L"<Data>";
        }
    }

    static std::wstring FormatJsonValueToken(const std::wstring& rawVal) {
        if (rawVal.empty() || rawVal == L"N/A") {
            return L"null";
        }

        std::wstring lowered = rawVal;
        std::transform(lowered.begin(), lowered.end(), lowered.begin(), towlower);

        if (lowered == L"true" || lowered == L"false") {
            return lowered;
        }

        if (IsIntegerLiteral(rawVal)) {
            return rawVal;
        }

        return L"\"" + EscapeJson(rawVal) + L"\"";
    }

    static std::wstring BuildOutputString(
        const std::vector<std::wstring>& headers,
        const std::vector<std::vector<std::wstring>>& rows,
        const OutputOptions& outputOptions
    ) {
        if (outputOptions.format == OutputFormat::Csv) {
            std::wstring out;
            out.reserve((headers.size() * 16) + (rows.size() * (headers.size() * 16 + 1)) + 16);
            const std::wstring emptyCell;

            if (!outputOptions.noHeader) {
                for (size_t i = 0; i < headers.size(); ++i) {
                    if (i > 0) out += L",";
                    out += EscapeCsv(headers[i]);
                }
                out += L"\n";
            }
            for (const auto& row : rows) {
                for (size_t i = 0; i < headers.size(); ++i) {
                    if (i > 0) out += L",";
                    const std::wstring& cell = (i < row.size()) ? row[i] : emptyCell;
                    out += EscapeCsv(cell);
                }
                out += L"\n";
            }
            return out;
        }

        if (outputOptions.format == OutputFormat::Json) {
            std::wstring out;
            out.reserve((headers.size() * 16) + (rows.size() * (headers.size() * 24 + 4)) + 16);
            out += L"[";
            for (size_t r = 0; r < rows.size(); ++r) {
                if (r > 0) out += L",";
                out += L"{";
                for (size_t c = 0; c < headers.size(); ++c) {
                    if (c > 0) out += L",";
                    std::wstring key = EscapeJson(headers[c]);
                    std::wstring val = (c < rows[r].size()) ? rows[r][c] : L"";
                    out += L"\"";
                    out += key;
                    out += L"\":";
                    out += FormatJsonValueToken(val);
                }
                out += L"}";
            }
            out += L"]\n";
            return out;
        }

        std::wstringstream out;

        std::vector<size_t> widths(headers.size(), 0);
        for (size_t i = 0; i < headers.size(); ++i) widths[i] = headers[i].size();
        for (const auto& row : rows) {
            for (size_t i = 0; i < row.size() && i < widths.size(); ++i) {
                widths[i] = (std::max)(widths[i], row[i].size());
            }
        }

        out << L"\n";
        if (!outputOptions.noHeader) {
            for (size_t i = 0; i < headers.size(); ++i) {
                out << std::left << std::setw(static_cast<int>(widths[i] + 3)) << headers[i];
            }
            out << L"\n";
            size_t totalWidth = 0;
            for (size_t w : widths) totalWidth += w + 3;
            out << std::wstring(totalWidth, L'-') << L"\n";
        }

        for (const auto& row : rows) {
            const std::wstring emptyCell;
            for (size_t i = 0; i < headers.size(); ++i) {
                const std::wstring& cell = (i < row.size()) ? row[i] : emptyCell;
                out << std::left << std::setw(static_cast<int>(widths[i] + 3)) << cell;
            }
            out << L"\n";
        }
        out << L"\n";
        return out.str();
    }

public:
    bool ExecuteQuery(
        const WmiTargetConfig& target,
        const std::wstring& wqlQuery,
        const std::vector<std::wstring>& properties,
        const OutputOptions& outputOptions,
        std::wstring& output,
        bool& noData,
        std::wstring& error
    ) const override {
        ScopedMiSession miScope;
        ScopedMiOperation operation;
        ScopedMiInstance extendedError;

        MI_Result miResult = MI_Application_Initialize(0, NULL, &extendedError.instance, &miScope.application);
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_Initialize failed.";
            return false;
        }

        miResult = MI_Application_NewDestinationOptions(&miScope.application, &miScope.destinationOptions);
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_NewDestinationOptions failed.";
            return false;
        }

        if (!target.user.empty()) {
            MI_UserCredentials creds;
            memset(&creds, 0, sizeof(creds));
            creds.authenticationType = MI_AUTH_TYPE_NEGO_WITH_CREDS;
            creds.credentials.usernamePassword.domain = target.domain.empty() ? NULL : target.domain.c_str();
            creds.credentials.usernamePassword.username = target.user.c_str();
            creds.credentials.usernamePassword.password = target.password.c_str();
            miResult = MI_DestinationOptions_AddDestinationCredentials(&miScope.destinationOptions, &creds);
            if (miResult != MI_RESULT_OK) {
                error = L"MI_DestinationOptions_AddDestinationCredentials failed.";
                return false;
            }
        }

        const MI_Char* destination = (target.node.empty() || target.node == L".") ? NULL : target.node.c_str();
        miResult = MI_Application_NewSession(
            &miScope.application,
            MI_T("WINRM"),
            destination,
            &miScope.destinationOptions,
            NULL,
            &extendedError.instance,
            &miScope.session
        );
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_NewSession failed.";
            return false;
        }

        MI_Session_QueryInstances(
            &miScope.session,
            0,
            NULL,
            target.wmiNamespace.c_str(),
            MI_T("WQL"),
            wqlQuery.c_str(),
            NULL,
            &operation.operation
        );

        std::vector<std::wstring> headers = properties;
        std::vector<std::vector<std::wstring>> rows;

        for (;;) {
            const MI_Instance* instance = NULL;
            MI_Boolean moreResults = MI_FALSE;
            MI_Result operationResult = MI_RESULT_OK;
            const MI_Char* errorMessage = NULL;
            const MI_Instance* completionDetails = NULL;

            miResult = MI_Operation_GetInstance(
                &operation.operation,
                &instance,
                &moreResults,
                &operationResult,
                &errorMessage,
                &completionDetails
            );

            if (miResult != MI_RESULT_OK) {
                error = L"MI_Operation_GetInstance failed.";
                return false;
            }

            if (instance) {
                if (headers.empty()) {
                    MI_Uint32 count = 0;
                    if (MI_Instance_GetElementCount(instance, &count) == MI_RESULT_OK) {
                        for (MI_Uint32 i = 0; i < count; ++i) {
                            const MI_Char* name = NULL;
                            if (MI_Instance_GetElementAt(instance, i, &name, NULL, NULL, NULL) == MI_RESULT_OK && name) {
                                headers.push_back(name);
                            }
                        }
                    }
                }

                std::vector<std::wstring> row;
                row.reserve(headers.size());
                for (const auto& prop : headers) {
                    MI_Value value;
                    memset(&value, 0, sizeof(value));
                    MI_Type type = MI_STRING;
                    MI_Uint32 flags = 0;
                    if (MI_Instance_GetElement(instance, prop.c_str(), &value, &type, &flags, NULL) == MI_RESULT_OK) {
                        row.push_back(MiValueToString(value, type, flags));
                    } else {
                        row.push_back(L"N/A");
                    }
                }
                rows.push_back(std::move(row));
            }

            if (!moreResults) {
                if (operationResult != MI_RESULT_OK) {
                    error = errorMessage ? std::wstring(errorMessage) : L"MI query operation failed.";
                    return false;
                }
                break;
            }
        }

        noData = rows.empty();
        output = noData ? L"" : BuildOutputString(headers, rows, outputOptions);
        return true;
    }

    bool ExecuteMethodCall(
        const WmiTargetConfig& target,
        const std::wstring& classNameOrPath,
        const std::wstring& methodName,
        const std::map<std::wstring, std::wstring>& inputArgs,
        std::wstring& output,
        std::wstring& error
    ) const override {
        ScopedMiSession miScope;
        ScopedMiOperation classOperation;
        ScopedMiOperation invokeOperation;
        ScopedMiInstance extendedError;
        ScopedMiInstance invokeInputParams;

        auto extractClassName = [](const std::wstring& raw) -> std::wstring {
            if (raw.find(L'=') != std::wstring::npos) {
                size_t dotPos = raw.find(L'.');
                if (dotPos != std::wstring::npos && dotPos > 0) {
                    return raw.substr(0, dotPos);
                }
            }
            return raw;
        };

        auto parseBoolean = [](const std::wstring& raw, MI_Boolean& out) -> bool {
            std::wstring lowered = raw;
            std::transform(lowered.begin(), lowered.end(), lowered.begin(), towlower);
            if (lowered == L"true" || lowered == L"1") {
                out = MI_TRUE;
                return true;
            }
            if (lowered == L"false" || lowered == L"0") {
                out = MI_FALSE;
                return true;
            }
            return false;
        };

        auto isIntegerLiteral = [](const std::wstring& value) -> bool {
            if (value.empty()) return false;
            size_t start = 0;
            if (value[0] == L'+' || value[0] == L'-') {
                if (value.size() == 1) return false;
                start = 1;
            }
            for (size_t i = start; i < value.size(); ++i) {
                if (!iswdigit(value[i])) return false;
            }
            return true;
        };

        auto addTypedElement = [&](MI_Instance* targetInstance, const std::wstring& name, MI_Type declaredType, const std::wstring& rawValue, bool hasDeclaredType) -> bool {
            auto add = [&](const MI_Value& value, MI_Type type) -> bool {
                return MI_Instance_AddElement(targetInstance, name.c_str(), &value, type, 0) == MI_RESULT_OK;
            };

            auto addFallback = [&]() -> bool {
                if (isIntegerLiteral(rawValue)) {
                    try {
                        MI_Value value;
                        memset(&value, 0, sizeof(value));
                        value.sint64 = static_cast<MI_Sint64>(std::stoll(rawValue));
                        if (add(value, MI_SINT64)) {
                            return true;
                        }
                    } catch (...) {
                    }
                }

                MI_Boolean boolVal;
                if (parseBoolean(rawValue, boolVal)) {
                    MI_Value value;
                    memset(&value, 0, sizeof(value));
                    value.boolean = boolVal;
                    if (add(value, MI_BOOLEAN)) {
                        return true;
                    }
                }

                MI_Value value;
                memset(&value, 0, sizeof(value));
                value.string = const_cast<MI_Char*>(rawValue.c_str());
                return add(value, MI_STRING);
            };

            if (!hasDeclaredType) {
                return addFallback();
            }

            try {
                switch (declaredType) {
                case MI_SINT8: {
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.sint8 = static_cast<MI_Sint8>(std::stoi(rawValue));
                    return add(value, MI_SINT8);
                }
                case MI_UINT8: {
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.uint8 = static_cast<MI_Uint8>(std::stoul(rawValue));
                    return add(value, MI_UINT8);
                }
                case MI_SINT16: {
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.sint16 = static_cast<MI_Sint16>(std::stoi(rawValue));
                    return add(value, MI_SINT16);
                }
                case MI_UINT16: {
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.uint16 = static_cast<MI_Uint16>(std::stoul(rawValue));
                    return add(value, MI_UINT16);
                }
                case MI_SINT32: {
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.sint32 = static_cast<MI_Sint32>(std::stol(rawValue));
                    return add(value, MI_SINT32);
                }
                case MI_UINT32: {
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.uint32 = static_cast<MI_Uint32>(std::stoul(rawValue));
                    return add(value, MI_UINT32);
                }
                case MI_SINT64: {
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.sint64 = static_cast<MI_Sint64>(std::stoll(rawValue));
                    return add(value, MI_SINT64);
                }
                case MI_UINT64: {
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.uint64 = static_cast<MI_Uint64>(std::stoull(rawValue));
                    return add(value, MI_UINT64);
                }
                case MI_REAL32: {
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.real32 = static_cast<MI_Real32>(std::stof(rawValue));
                    return add(value, MI_REAL32);
                }
                case MI_REAL64: {
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.real64 = static_cast<MI_Real64>(std::stod(rawValue));
                    return add(value, MI_REAL64);
                }
                case MI_BOOLEAN: {
                    MI_Boolean boolVal;
                    if (!parseBoolean(rawValue, boolVal)) {
                        return false;
                    }
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.boolean = boolVal;
                    return add(value, MI_BOOLEAN);
                }
                case MI_CHAR16: {
                    if (rawValue.empty()) {
                        return false;
                    }
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.char16 = static_cast<MI_Char16>(rawValue[0]);
                    return add(value, MI_CHAR16);
                }
                case MI_STRING:
                case MI_REFERENCE:
                case MI_DATETIME: {
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.string = const_cast<MI_Char*>(rawValue.c_str());
                    return add(value, MI_STRING);
                }
                case MI_SINT32A: {
                    std::vector<std::wstring> items = SplitCsvLikeValues(rawValue);
                    std::vector<MI_Sint32> values;
                    values.reserve(items.size());
                    for (const auto& item : items) values.push_back(static_cast<MI_Sint32>(std::stol(item)));
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.sint32a.data = values.data(); value.sint32a.size = static_cast<MI_Uint32>(values.size());
                    return !values.empty() && add(value, MI_SINT32A);
                }
                case MI_UINT32A: {
                    std::vector<std::wstring> items = SplitCsvLikeValues(rawValue);
                    std::vector<MI_Uint32> values;
                    values.reserve(items.size());
                    for (const auto& item : items) values.push_back(static_cast<MI_Uint32>(std::stoul(item)));
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.uint32a.data = values.data(); value.uint32a.size = static_cast<MI_Uint32>(values.size());
                    return !values.empty() && add(value, MI_UINT32A);
                }
                case MI_SINT64A: {
                    std::vector<std::wstring> items = SplitCsvLikeValues(rawValue);
                    std::vector<MI_Sint64> values;
                    values.reserve(items.size());
                    for (const auto& item : items) values.push_back(static_cast<MI_Sint64>(std::stoll(item)));
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.sint64a.data = values.data(); value.sint64a.size = static_cast<MI_Uint32>(values.size());
                    return !values.empty() && add(value, MI_SINT64A);
                }
                case MI_UINT64A: {
                    std::vector<std::wstring> items = SplitCsvLikeValues(rawValue);
                    std::vector<MI_Uint64> values;
                    values.reserve(items.size());
                    for (const auto& item : items) values.push_back(static_cast<MI_Uint64>(std::stoull(item)));
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.uint64a.data = values.data(); value.uint64a.size = static_cast<MI_Uint32>(values.size());
                    return !values.empty() && add(value, MI_UINT64A);
                }
                case MI_BOOLEANA: {
                    std::vector<std::wstring> items = SplitCsvLikeValues(rawValue);
                    std::vector<MI_Boolean> values;
                    values.reserve(items.size());
                    for (const auto& item : items) {
                        MI_Boolean boolVal;
                        if (!parseBoolean(item, boolVal)) {
                            return false;
                        }
                        values.push_back(boolVal);
                    }
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.booleana.data = values.data(); value.booleana.size = static_cast<MI_Uint32>(values.size());
                    return !values.empty() && add(value, MI_BOOLEANA);
                }
                case MI_STRINGA: {
                    std::vector<std::wstring> items = SplitCsvLikeValues(rawValue);
                    std::vector<MI_Char*> values;
                    values.reserve(items.size());
                    for (auto& item : items) values.push_back(const_cast<MI_Char*>(item.c_str()));
                    MI_Value value; memset(&value, 0, sizeof(value));
                    value.stringa.data = values.data(); value.stringa.size = static_cast<MI_Uint32>(values.size());
                    return !values.empty() && add(value, MI_STRINGA);
                }
                default:
                    return addFallback();
                }
            } catch (...) {
                return false;
            }
        };

        std::wstring className = extractClassName(classNameOrPath);

        MI_Result miResult = MI_Application_Initialize(0, NULL, &extendedError.instance, &miScope.application);
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_Initialize failed.";
            return false;
        }

        miResult = MI_Application_NewDestinationOptions(&miScope.application, &miScope.destinationOptions);
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_NewDestinationOptions failed.";
            return false;
        }

        if (!target.user.empty()) {
            MI_UserCredentials creds;
            memset(&creds, 0, sizeof(creds));
            creds.authenticationType = MI_AUTH_TYPE_NEGO_WITH_CREDS;
            creds.credentials.usernamePassword.domain = target.domain.empty() ? NULL : target.domain.c_str();
            creds.credentials.usernamePassword.username = target.user.c_str();
            creds.credentials.usernamePassword.password = target.password.c_str();
            miResult = MI_DestinationOptions_AddDestinationCredentials(&miScope.destinationOptions, &creds);
            if (miResult != MI_RESULT_OK) {
                error = L"MI_DestinationOptions_AddDestinationCredentials failed.";
                return false;
            }
        }

        const MI_Char* destination = (target.node.empty() || target.node == L".") ? NULL : target.node.c_str();
        miResult = MI_Application_NewSession(
            &miScope.application,
            MI_T("WINRM"),
            destination,
            &miScope.destinationOptions,
            NULL,
            &extendedError.instance,
            &miScope.session
        );
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_NewSession failed.";
            return false;
        }

        std::map<std::wstring, MI_Type> methodParameterTypes;
        MI_Session_GetClass(
            &miScope.session,
            0,
            NULL,
            target.wmiNamespace.c_str(),
            className.c_str(),
            NULL,
            &classOperation.operation
        );

        const MI_Class* methodClass = NULL;
        for (;;) {
            const MI_Class* classResult = NULL;
            MI_Boolean moreResults = MI_FALSE;
            MI_Result operationResult = MI_RESULT_OK;
            const MI_Char* errorMessage = NULL;
            const MI_Instance* completionDetails = NULL;

            miResult = MI_Operation_GetClass(
                &classOperation.operation,
                &classResult,
                &moreResults,
                &operationResult,
                &errorMessage,
                &completionDetails
            );

            if (miResult != MI_RESULT_OK) {
                break;
            }

            if (classResult) {
                methodClass = classResult;
            }

            if (!moreResults) {
                break;
            }
        }

        if (methodClass) {
            MI_ParameterSet methodParams;
            memset(&methodParams, 0, sizeof(methodParams));
            miResult = MI_Class_GetMethod(methodClass, methodName.c_str(), NULL, &methodParams, NULL);
            if (miResult == MI_RESULT_OK) {
                MI_Uint32 count = 0;
                if (MI_ParameterSet_GetParameterCount(&methodParams, &count) == MI_RESULT_OK) {
                    for (MI_Uint32 i = 0; i < count; ++i) {
                        const MI_Char* paramName = NULL;
                        MI_Type paramType = MI_STRING;
                        if (MI_ParameterSet_GetParameterAt(&methodParams, i, &paramName, &paramType, NULL, NULL) == MI_RESULT_OK && paramName) {
                            methodParameterTypes[paramName] = paramType;
                        }
                    }
                }
            }
        }

        classOperation.Close();

        if (!inputArgs.empty()) {
            miResult = MI_Application_NewInstance(&miScope.application, className.c_str(), NULL, &invokeInputParams.instance);
            if (miResult != MI_RESULT_OK || !invokeInputParams.instance) {
                error = L"MI_Application_NewInstance failed for method parameters.";
                return false;
            }

            for (const auto& kv : inputArgs) {
                auto it = methodParameterTypes.find(kv.first);
                bool hasType = (it != methodParameterTypes.end());
                MI_Type paramType = hasType ? it->second : MI_STRING;
                if (!addTypedElement(invokeInputParams.instance, kv.first, paramType, kv.second, hasType)) {
                    error = L"Failed to convert method input parameter: " + kv.first;
                    return false;
                }
            }
        }

        MI_Session_Invoke(
            &miScope.session,
            0,
            NULL,
            target.wmiNamespace.c_str(),
            className.c_str(),
            methodName.c_str(),
            NULL,
            invokeInputParams.instance,
            NULL,
            &invokeOperation.operation
        );

        std::vector<std::pair<std::wstring, std::wstring>> outputPairs;
        for (;;) {
            const MI_Instance* instance = NULL;
            MI_Boolean moreResults = MI_FALSE;
            MI_Result operationResult = MI_RESULT_OK;
            const MI_Char* errorMessage = NULL;
            const MI_Instance* completionDetails = NULL;

            miResult = MI_Operation_GetInstance(
                &invokeOperation.operation,
                &instance,
                &moreResults,
                &operationResult,
                &errorMessage,
                &completionDetails
            );

            if (miResult != MI_RESULT_OK) {
                error = L"MI_Operation_GetInstance failed during method invocation.";
                return false;
            }

            if (instance) {
                MI_Uint32 count = 0;
                if (MI_Instance_GetElementCount(instance, &count) == MI_RESULT_OK) {
                    for (MI_Uint32 i = 0; i < count; ++i) {
                        const MI_Char* name = NULL;
                        MI_Value value;
                        memset(&value, 0, sizeof(value));
                        MI_Type type = MI_STRING;
                        MI_Uint32 flags = 0;
                        if (MI_Instance_GetElementAt(instance, i, &name, &value, &type, &flags) == MI_RESULT_OK && name) {
                            outputPairs.push_back({ name, MiValueToString(value, type, flags) });
                        }
                    }
                }
            }

            if (!moreResults) {
                if (operationResult != MI_RESULT_OK) {
                    error = errorMessage ? std::wstring(errorMessage) : L"MI invoke operation failed.";
                    return false;
                }
                break;
            }
        }

        output.clear();
        auto returnIt = std::find_if(outputPairs.begin(), outputPairs.end(), [](const std::pair<std::wstring, std::wstring>& kv) {
            return _wcsicmp(kv.first.c_str(), L"ReturnValue") == 0;
        });

        if (returnIt != outputPairs.end()) {
            output = L"ReturnValue=" + returnIt->second;
            for (const auto& kv : outputPairs) {
                if (_wcsicmp(kv.first.c_str(), L"ReturnValue") == 0) {
                    continue;
                }
                output += L"; " + kv.first + L"=" + kv.second;
            }
        } else {
            for (size_t i = 0; i < outputPairs.size(); ++i) {
                if (i > 0) output += L"; ";
                output += outputPairs[i].first + L"=" + outputPairs[i].second;
            }
        }

        return true;
    }

    bool ExecuteSetProperty(
        const WmiTargetConfig& target,
        const std::wstring& objectPath,
        const std::wstring& propName,
        const std::wstring& propValue,
        std::wstring& output,
        std::wstring& error
    ) const override {
        ScopedMiSession miScope;
        ScopedMiOperation queryOperation;
        ScopedMiOperation modifyOperation;
        ScopedMiInstance extendedError;
        ScopedMiInstance targetInstance;

        auto parseBoolean = [](const std::wstring& raw, MI_Boolean& out) -> bool {
            std::wstring lowered = raw;
            std::transform(lowered.begin(), lowered.end(), lowered.begin(), towlower);
            if (lowered == L"true" || lowered == L"1") {
                out = MI_TRUE;
                return true;
            }
            if (lowered == L"false" || lowered == L"0") {
                out = MI_FALSE;
                return true;
            }
            return false;
        };

        std::wstring query;
        if (!TryBuildInstanceSelectQueryFromObjectPath(objectPath, query)) {
            error = L"WinRM native backend path set requires object paths in the form Class.Key=Value[,Key=Value].";
            return false;
        }

        MI_Result miResult = MI_Application_Initialize(0, NULL, &extendedError.instance, &miScope.application);
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_Initialize failed.";
            return false;
        }

        miResult = MI_Application_NewDestinationOptions(&miScope.application, &miScope.destinationOptions);
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_NewDestinationOptions failed.";
            return false;
        }

        if (!target.user.empty()) {
            MI_UserCredentials creds;
            memset(&creds, 0, sizeof(creds));
            creds.authenticationType = MI_AUTH_TYPE_NEGO_WITH_CREDS;
            creds.credentials.usernamePassword.domain = target.domain.empty() ? NULL : target.domain.c_str();
            creds.credentials.usernamePassword.username = target.user.c_str();
            creds.credentials.usernamePassword.password = target.password.c_str();
            miResult = MI_DestinationOptions_AddDestinationCredentials(&miScope.destinationOptions, &creds);
            if (miResult != MI_RESULT_OK) {
                error = L"MI_DestinationOptions_AddDestinationCredentials failed.";
                return false;
            }
        }

        const MI_Char* destination = (target.node.empty() || target.node == L".") ? NULL : target.node.c_str();
        miResult = MI_Application_NewSession(
            &miScope.application,
            MI_T("WINRM"),
            destination,
            &miScope.destinationOptions,
            NULL,
            &extendedError.instance,
            &miScope.session
        );
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_NewSession failed.";
            return false;
        }

        MI_Session_QueryInstances(
            &miScope.session,
            0,
            NULL,
            target.wmiNamespace.c_str(),
            MI_T("WQL"),
            query.c_str(),
            NULL,
            &queryOperation.operation
        );

        for (;;) {
            const MI_Instance* instance = NULL;
            MI_Boolean moreResults = MI_FALSE;
            MI_Result operationResult = MI_RESULT_OK;
            const MI_Char* errorMessage = NULL;
            const MI_Instance* completionDetails = NULL;

            miResult = MI_Operation_GetInstance(
                &queryOperation.operation,
                &instance,
                &moreResults,
                &operationResult,
                &errorMessage,
                &completionDetails
            );

            if (miResult != MI_RESULT_OK) {
                error = L"MI_Operation_GetInstance failed during target instance resolution.";
                return false;
            }

            if (instance && targetInstance.instance == NULL) {
                if (MI_Instance_Clone(instance, &targetInstance.instance) != MI_RESULT_OK || !targetInstance.instance) {
                    error = L"MI_Instance_Clone failed while preparing set operation.";
                    return false;
                }
            }

            if (!moreResults) {
                if (operationResult != MI_RESULT_OK) {
                    error = errorMessage ? std::wstring(errorMessage) : L"MI query operation failed while resolving set target.";
                    return false;
                }
                break;
            }
        }

        if (!targetInstance.instance) {
            error = L"Instance not found for set operation.";
            return false;
        }

        MI_Value existingValue;
        memset(&existingValue, 0, sizeof(existingValue));
        MI_Type existingType = MI_STRING;
        MI_Uint32 existingFlags = 0;
        if (MI_Instance_GetElement(targetInstance.instance, propName.c_str(), &existingValue, &existingType, &existingFlags, NULL) != MI_RESULT_OK) {
            error = L"Property not found on target instance: " + propName;
            return false;
        }

        MI_Value newValue;
        memset(&newValue, 0, sizeof(newValue));
        bool converted = true;

        try {
            switch (existingType) {
            case MI_BOOLEAN: {
                MI_Boolean b = MI_FALSE;
                if (!parseBoolean(propValue, b)) {
                    converted = false;
                    break;
                }
                newValue.boolean = b;
                break;
            }
            case MI_SINT8: newValue.sint8 = static_cast<MI_Sint8>(std::stoi(propValue)); break;
            case MI_UINT8: newValue.uint8 = static_cast<MI_Uint8>(std::stoul(propValue)); break;
            case MI_SINT16: newValue.sint16 = static_cast<MI_Sint16>(std::stoi(propValue)); break;
            case MI_UINT16: newValue.uint16 = static_cast<MI_Uint16>(std::stoul(propValue)); break;
            case MI_SINT32: newValue.sint32 = static_cast<MI_Sint32>(std::stol(propValue)); break;
            case MI_UINT32: newValue.uint32 = static_cast<MI_Uint32>(std::stoul(propValue)); break;
            case MI_SINT64: newValue.sint64 = static_cast<MI_Sint64>(std::stoll(propValue)); break;
            case MI_UINT64: newValue.uint64 = static_cast<MI_Uint64>(std::stoull(propValue)); break;
            case MI_REAL32: newValue.real32 = static_cast<MI_Real32>(std::stof(propValue)); break;
            case MI_REAL64: newValue.real64 = static_cast<MI_Real64>(std::stod(propValue)); break;
            case MI_CHAR16:
                if (propValue.empty()) {
                    converted = false;
                    break;
                }
                newValue.char16 = static_cast<MI_Char16>(propValue[0]);
                break;
            case MI_STRING:
            case MI_REFERENCE:
            case MI_DATETIME:
            default:
                newValue.string = const_cast<MI_Char*>(propValue.c_str());
                existingType = MI_STRING;
                break;
            }
        } catch (...) {
            converted = false;
        }

        if (!converted) {
            error = L"Failed to convert value for property type on set operation: " + propName;
            return false;
        }

        if (MI_Instance_SetElement(targetInstance.instance, propName.c_str(), &newValue, existingType, 0) != MI_RESULT_OK) {
            error = L"MI_Instance_SetElement failed for property: " + propName;
            return false;
        }

        MI_Session_ModifyInstance(
            &miScope.session,
            0,
            NULL,
            target.wmiNamespace.c_str(),
            targetInstance.instance,
            NULL,
            &modifyOperation.operation
        );

        for (;;) {
            const MI_Instance* instance = NULL;
            MI_Boolean moreResults = MI_FALSE;
            MI_Result operationResult = MI_RESULT_OK;
            const MI_Char* errorMessage = NULL;
            const MI_Instance* completionDetails = NULL;

            miResult = MI_Operation_GetInstance(
                &modifyOperation.operation,
                &instance,
                &moreResults,
                &operationResult,
                &errorMessage,
                &completionDetails
            );

            if (miResult != MI_RESULT_OK) {
                error = L"MI_Operation_GetInstance failed during set operation.";
                return false;
            }

            if (!moreResults) {
                if (operationResult != MI_RESULT_OK) {
                    error = errorMessage ? std::wstring(errorMessage) : L"MI modify operation failed.";
                    return false;
                }
                break;
            }
        }

        output = L"Property updated successfully.";
        return true;
    }

    bool ExecuteDeleteInstance(
        const WmiTargetConfig& target,
        const std::wstring& objectPath,
        std::wstring& output,
        std::wstring& error
    ) const override {
        ScopedMiSession miScope;
        ScopedMiOperation queryOperation;
        ScopedMiOperation deleteOperation;
        ScopedMiInstance extendedError;
        ScopedMiInstance targetInstance;

        std::wstring query;
        if (!TryBuildInstanceSelectQueryFromObjectPath(objectPath, query)) {
            error = L"WinRM native backend path delete requires object paths in the form Class.Key=Value[,Key=Value].";
            return false;
        }

        MI_Result miResult = MI_Application_Initialize(0, NULL, &extendedError.instance, &miScope.application);
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_Initialize failed.";
            return false;
        }

        miResult = MI_Application_NewDestinationOptions(&miScope.application, &miScope.destinationOptions);
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_NewDestinationOptions failed.";
            return false;
        }

        if (!target.user.empty()) {
            MI_UserCredentials creds;
            memset(&creds, 0, sizeof(creds));
            creds.authenticationType = MI_AUTH_TYPE_NEGO_WITH_CREDS;
            creds.credentials.usernamePassword.domain = target.domain.empty() ? NULL : target.domain.c_str();
            creds.credentials.usernamePassword.username = target.user.c_str();
            creds.credentials.usernamePassword.password = target.password.c_str();
            miResult = MI_DestinationOptions_AddDestinationCredentials(&miScope.destinationOptions, &creds);
            if (miResult != MI_RESULT_OK) {
                error = L"MI_DestinationOptions_AddDestinationCredentials failed.";
                return false;
            }
        }

        const MI_Char* destination = (target.node.empty() || target.node == L".") ? NULL : target.node.c_str();
        miResult = MI_Application_NewSession(
            &miScope.application,
            MI_T("WINRM"),
            destination,
            &miScope.destinationOptions,
            NULL,
            &extendedError.instance,
            &miScope.session
        );
        if (miResult != MI_RESULT_OK) {
            error = L"MI_Application_NewSession failed.";
            return false;
        }

        MI_Session_QueryInstances(
            &miScope.session,
            0,
            NULL,
            target.wmiNamespace.c_str(),
            MI_T("WQL"),
            query.c_str(),
            NULL,
            &queryOperation.operation
        );

        for (;;) {
            const MI_Instance* instance = NULL;
            MI_Boolean moreResults = MI_FALSE;
            MI_Result operationResult = MI_RESULT_OK;
            const MI_Char* errorMessage = NULL;
            const MI_Instance* completionDetails = NULL;

            miResult = MI_Operation_GetInstance(
                &queryOperation.operation,
                &instance,
                &moreResults,
                &operationResult,
                &errorMessage,
                &completionDetails
            );

            if (miResult != MI_RESULT_OK) {
                error = L"MI_Operation_GetInstance failed during target instance resolution.";
                return false;
            }

            if (instance && targetInstance.instance == NULL) {
                if (MI_Instance_Clone(instance, &targetInstance.instance) != MI_RESULT_OK || !targetInstance.instance) {
                    error = L"MI_Instance_Clone failed while preparing delete operation.";
                    return false;
                }
            }

            if (!moreResults) {
                if (operationResult != MI_RESULT_OK) {
                    error = errorMessage ? std::wstring(errorMessage) : L"MI query operation failed while resolving delete target.";
                    return false;
                }
                break;
            }
        }

        if (!targetInstance.instance) {
            error = L"Instance not found for delete operation.";
            return false;
        }

        MI_Session_DeleteInstance(
            &miScope.session,
            0,
            NULL,
            target.wmiNamespace.c_str(),
            targetInstance.instance,
            NULL,
            &deleteOperation.operation
        );

        for (;;) {
            const MI_Instance* instance = NULL;
            MI_Boolean moreResults = MI_FALSE;
            MI_Result operationResult = MI_RESULT_OK;
            const MI_Char* errorMessage = NULL;
            const MI_Instance* completionDetails = NULL;

            miResult = MI_Operation_GetInstance(
                &deleteOperation.operation,
                &instance,
                &moreResults,
                &operationResult,
                &errorMessage,
                &completionDetails
            );

            if (miResult != MI_RESULT_OK) {
                error = L"MI_Operation_GetInstance failed during delete operation.";
                return false;
            }

            if (!moreResults) {
                if (operationResult != MI_RESULT_OK) {
                    error = errorMessage ? std::wstring(errorMessage) : L"MI delete operation failed.";
                    return false;
                }
                break;
            }
        }

        output = L"Instance deleted successfully.";
        return true;
    }
};

const IWinRmBackend& GetWinRmBackend(WinRmBackendMode mode) {
    static WinRmPowerShellBackend powershellBackend;
    static WinRmNativeBackendStub nativeStubBackend;
    return (mode == WinRmBackendMode::Native)
        ? static_cast<const IWinRmBackend&>(nativeStubBackend)
        : static_cast<const IWinRmBackend&>(powershellBackend);
}

std::vector<std::wstring> SplitAndTrimCommaList(const std::wstring& input) {
    return SplitCommaTrimmed(input);
}

std::wstring TrimMatchingQuotes(const std::wstring& input) {
    if (input.size() >= 2) {
        wchar_t first = input.front();
        wchar_t last = input.back();
        if ((first == L'"' && last == L'"') || (first == L'\'' && last == L'\'')) {
            return input.substr(1, input.size() - 2);
        }
    }
    return input;
}

bool ParseNamedCallArguments(int startIndex, int argc, wchar_t* argv[], std::map<std::wstring, std::wstring>& argsOut, std::wstring& errorOut) {
    argsOut.clear();
    std::wstring currentKey;

    for (int i = startIndex; i < argc; ++i) {
        std::wstring token = argv[i];
        size_t eqPos = token.find(L'=');

        if (eqPos != std::wstring::npos && eqPos > 0) {
            std::wstring key = token.substr(0, eqPos);
            std::wstring value = TrimMatchingQuotes(token.substr(eqPos + 1));
            argsOut[key] = value;
            currentKey = key;
            continue;
        }

        if (!currentKey.empty()) {
            argsOut[currentKey] += L" " + TrimMatchingQuotes(token);
            continue;
        }

        errorOut = L"Unexpected call argument fragment: " + token + L" (expected Name=Value)";
        return false;
    }

    return true;
}

struct Table {
    std::vector<std::wstring> headers;
    std::vector<std::vector<std::wstring>> rows;

    void Print() {
        if (headers.empty()) return;

        auto appendPadded = [](std::wstring& out, const std::wstring& text, size_t width) {
            out += text;
            if (text.size() < width) {
                out.append(width - text.size(), L' ');
            }
        };

        if (g_outputOptions.format == OutputFormat::Csv) {
            std::wstring out;
            out.reserve((headers.size() + rows.size() * (headers.size() + 1)) * 32);
            const std::wstring emptyCell;

            if (!g_outputOptions.noHeader) {
                for (size_t i = 0; i < headers.size(); ++i) {
                    if (i > 0) out.push_back(L',');
                    out += EscapeCsv(headers[i]);
                }
                out.push_back(L'\n');
            }

            for (const auto& row : rows) {
                for (size_t i = 0; i < headers.size(); ++i) {
                    if (i > 0) out.push_back(L',');
                    const std::wstring& cell = (i < row.size()) ? row[i] : emptyCell;
                    out += EscapeCsv(cell);
                }
                out.push_back(L'\n');
            }

            std::wcout << out;
            return;
        }

        if (g_outputOptions.format == OutputFormat::Json) {
            std::wstring out;
            out.reserve((headers.size() + rows.size() * (headers.size() + 1)) * 40);
            out.push_back(L'[');
            for (size_t r = 0; r < rows.size(); ++r) {
                if (r > 0) out.push_back(L',');
                out.push_back(L'{');
                for (size_t c = 0; c < headers.size(); ++c) {
                    if (c > 0) out.push_back(L',');
                    std::wstring key = EscapeJson(headers[c]);
                    std::wstring val = (c < rows[r].size()) ? EscapeJson(rows[r][c]) : L"";
                    out += L"\"";
                    out += key;
                    out += L"\":\"";
                    out += val;
                    out += L"\"";
                }
                out.push_back(L'}');
            }
            out += L"]\n";
            std::wcout << out;
            return;
        }

        std::vector<size_t> widths(headers.size());
        for (size_t i = 0; i < headers.size(); ++i) {
            widths[i] = headers[i].length();
        }

        for (const auto& row : rows) {
            for (size_t i = 0; i < row.size() && i < widths.size(); ++i) {
                widths[i] = (std::max)(widths[i], row[i].length());
            }
        }

        std::wstring out;
        out.reserve((rows.size() + 4) * (headers.size() * 24));
        out.push_back(L'\n');

        if (!g_outputOptions.noHeader) {
            for (size_t i = 0; i < headers.size(); ++i) {
                appendPadded(out, headers[i], widths[i] + 3);
            }
            out.push_back(L'\n');

            size_t totalWidth = 0;
            for (size_t w : widths) totalWidth += w + 3;
            out.append(totalWidth, L'-');
            out.push_back(L'\n');
        }

        const std::wstring emptyCell;
        for (const auto& row : rows) {
            for (size_t i = 0; i < widths.size(); ++i) {
                const std::wstring& cell = (i < row.size()) ? row[i] : emptyCell;
                appendPadded(out, cell, widths[i] + 3);
            }
            out.push_back(L'\n');
        }

        out.push_back(L'\n');
        std::wcout << out;
    }
};

std::wstring FormatSwitchState(const std::wstring& value) {
    if (value == L"True") return L"Enabled";
    if (value == L"False") return L"Disabled";
    return value;
}

std::wstring GetProcessElevationStateString() {
    HANDLE hToken = NULL;
    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &hToken)) {
        return L"Unknown";
    }

    TOKEN_ELEVATION elevation = {};
    DWORD returnLen = 0;
    BOOL ok = GetTokenInformation(hToken, TokenElevation, &elevation, sizeof(elevation), &returnLen);
    CloseHandle(hToken);

    if (!ok) {
        return L"Unknown";
    }

    return elevation.TokenIsElevated ? L"Elevated" : L"Standard";
}

std::wstring GetCurrentUserSidString() {
    HANDLE hToken = NULL;
    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &hToken)) {
        return L"Unavailable";
    }

    DWORD sizeNeeded = 0;
    GetTokenInformation(hToken, TokenUser, NULL, 0, &sizeNeeded);
    if (sizeNeeded == 0) {
        CloseHandle(hToken);
        return L"Unavailable";
    }

    std::vector<unsigned char> buffer(sizeNeeded);
    TOKEN_USER* pTokenUser = reinterpret_cast<TOKEN_USER*>(buffer.data());
    if (!GetTokenInformation(hToken, TokenUser, pTokenUser, sizeNeeded, &sizeNeeded)) {
        CloseHandle(hToken);
        return L"Unavailable";
    }

    LPWSTR sidStr = NULL;
    if (!ConvertSidToStringSidW(pTokenUser->User.Sid, &sidStr)) {
        CloseHandle(hToken);
        return L"Unavailable";
    }

    std::wstring sid = sidStr;
    LocalFree(sidStr);
    CloseHandle(hToken);
    return sid;
}

struct InstalledAppRecord {
    std::wstring name;
    std::wstring version;
    std::wstring publisher;
};

bool TryParseWmiSecurity(const std::wstring& input, WmiSecurityConfig& config) {
    std::wstring value = input;
    std::transform(value.begin(), value.end(), value.begin(), towlower);

    if (value == L"default") { config.authnLevel = RPC_C_AUTHN_LEVEL_DEFAULT; return true; }
    if (value == L"connect") { config.authnLevel = RPC_C_AUTHN_LEVEL_CONNECT; return true; }
    if (value == L"call") { config.authnLevel = RPC_C_AUTHN_LEVEL_CALL; return true; }
    if (value == L"pkt") { config.authnLevel = RPC_C_AUTHN_LEVEL_PKT; return true; }
    if (value == L"pktprivacy") { config.authnLevel = RPC_C_AUTHN_LEVEL_PKT_PRIVACY; return true; }

    return false;
}

bool TryParseOutputFormat(const std::wstring& input, OutputFormat& format) {
    std::wstring value = input;
    std::transform(value.begin(), value.end(), value.begin(), towlower);

    if (value == L"table") { format = OutputFormat::Table; return true; }
    if (value == L"csv") { format = OutputFormat::Csv; return true; }
    if (value == L"json") { format = OutputFormat::Json; return true; }

    return false;
}

std::wstring MapLicenseStatusCode(const std::wstring& rawValue) {
    if (rawValue == L"0") return L"Unlicensed";
    if (rawValue == L"1") return L"Licensed";
    if (rawValue == L"2") return L"OOB Grace";
    if (rawValue == L"3") return L"OOT Grace";
    if (rawValue == L"4") return L"Non-Genuine Grace";
    if (rawValue == L"5") return L"Notification";
    if (rawValue == L"6") return L"Extended Grace";
    return rawValue;
}

std::wstring MapOptionalFeatureInstallState(const std::wstring& rawValue) {
    if (rawValue == L"1") return L"Enabled";
    if (rawValue == L"2") return L"Disabled";
    if (rawValue == L"3") return L"Absent";
    return rawValue;
}

std::wstring MapHyperVEnabledState(const std::wstring& rawValue) {
    if (rawValue == L"2") return L"Enabled";
    if (rawValue == L"3") return L"Disabled";
    if (rawValue == L"32768") return L"Paused";
    if (rawValue == L"32769") return L"Suspended";
    if (rawValue == L"32770") return L"Starting";
    if (rawValue == L"32771") return L"Snapshotting";
    if (rawValue == L"32773") return L"Saving";
    if (rawValue == L"32774") return L"Stopping";
    return rawValue;
}

bool ExecuteThreadsInfoQuery(const WmiTargetConfig& target, const std::wstring& wmiLocale, const WmiSecurityConfig& securityConfig) {
    g_lastNoData = false;

    IWbemServices* pSvc = NULL;
    if (!ConnectWmiServices(target, L"ROOT\\CIMV2", securityConfig, wmiLocale, &pSvc)) {
        return false;
    }

    IEnumWbemClassObject* pEnumerator = NULL;
    HRESULT hr = pSvc->ExecQuery(
        bstr_t("WQL"),
        bstr_t(L"SELECT Threads FROM Win32_PerfFormattedData_PerfOS_System"),
        WBEM_FLAG_FORWARD_ONLY | WBEM_FLAG_RETURN_IMMEDIATELY,
        NULL,
        &pEnumerator
    );

    if (FAILED(hr)) {
        pSvc->Release();
        return false;
    }

    IWbemClassObject* pclsObj = NULL;
    ULONG uReturn = 0;
    hr = pEnumerator->Next(WBEM_INFINITE, 1, &pclsObj, &uReturn);
    if (FAILED(hr) || uReturn == 0) {
        g_lastNoData = true;
        if (g_outputOptions.format == OutputFormat::Table) {
            std::wcout << L"  No data available.\n" << std::endl;
        }
        pEnumerator->Release();
        pSvc->Release();
        return false;
    }

    VARIANT vtThreads;
    VariantInit(&vtThreads);
    std::wstring threads = L"N/A";
    if (SUCCEEDED(pclsObj->Get(L"Threads", 0, &vtThreads, 0, 0))) {
        threads = VariantToString(vtThreads);
    }
    VariantClear(&vtThreads);

    pclsObj->Release();
    pEnumerator->Release();
    pSvc->Release();

    Table table;
    if (g_outputOptions.format == OutputFormat::Table) {
        table.headers = { L"Property", L"Value" };
        table.rows.push_back({ L"Running Threads", threads });
    } else {
        table.headers = { L"Running Threads" };
        table.rows.push_back({ threads });
    }

    table.Print();
    return true;
}

std::wstring HResultToHex(HRESULT hr) {
    wchar_t buffer[11] = {};
    _snwprintf_s(buffer, _countof(buffer), _TRUNCATE, L"0x%08lX", static_cast<unsigned long>(hr));
    return std::wstring(buffer);
}

std::wstring GetSystemMessageForHResult(HRESULT hr) {
    LPWSTR raw = NULL;
    DWORD flags = FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS;
    DWORD langId = MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT);
    DWORD len = FormatMessageW(flags, NULL, static_cast<DWORD>(hr), langId, reinterpret_cast<LPWSTR>(&raw), 0, NULL);
    if (len == 0 || raw == NULL) {
        return L"";
    }

    std::wstring text(raw, len);
    LocalFree(raw);

    while (!text.empty() && (text.back() == L'\r' || text.back() == L'\n' || text.back() == L' ' || text.back() == L'\t')) {
        text.pop_back();
    }
    return text;
}

std::wstring DescribeWmiHResult(HRESULT hr) {
    std::wstring symbol = L"HRESULT";
    std::wstring hint = L"Review namespace/class/property names, permissions, and transport/authentication settings.";

    switch (hr) {
    case WBEM_E_ACCESS_DENIED:
        symbol = L"WBEM_E_ACCESS_DENIED";
        hint = L"Access denied. Run elevated if needed, verify account rights, namespace ACLs, and UAC remote restrictions.";
        break;
    case WBEM_E_NOT_FOUND:
        symbol = L"WBEM_E_NOT_FOUND";
        hint = L"Requested object was not found. Verify class/object path and where filter values.";
        break;
    case WBEM_E_PROVIDER_FAILURE:
        symbol = L"WBEM_E_PROVIDER_FAILURE";
        hint = L"WMI provider failed. Retry, check provider/service health, and inspect Event Viewer WMI-Activity logs.";
        break;
    case WBEM_E_INVALID_NAMESPACE:
        symbol = L"WBEM_E_INVALID_NAMESPACE";
        hint = L"Invalid namespace. Verify --namespace value and that the namespace exists on target.";
        break;
    case WBEM_E_INVALID_CLASS:
        symbol = L"WBEM_E_INVALID_CLASS";
        hint = L"Invalid class. Confirm class name exists in the selected namespace on target.";
        break;
    case WBEM_E_INVALID_QUERY:
        symbol = L"WBEM_E_INVALID_QUERY";
        hint = L"Invalid WQL syntax. Validate SELECT/WHERE clauses and quoted values.";
        break;
    case WBEM_E_INVALID_QUERY_TYPE:
        symbol = L"WBEM_E_INVALID_QUERY_TYPE";
        hint = L"Unsupported query language. Use WQL queries for WMI operations.";
        break;
    case WBEM_E_INVALID_PARAMETER:
        symbol = L"WBEM_E_INVALID_PARAMETER";
        hint = L"Invalid parameter passed to provider/API. Check command arguments and property/value types.";
        break;
    case WBEM_E_OUT_OF_MEMORY:
        symbol = L"WBEM_E_OUT_OF_MEMORY";
        hint = L"Provider reported memory pressure. Reduce query scope/volume and retry.";
        break;
    case WBEM_E_TRANSPORT_FAILURE:
        symbol = L"WBEM_E_TRANSPORT_FAILURE";
        hint = L"Transport failure. Verify RPC/WinRM connectivity, firewall, DNS, and endpoint availability.";
        break;
    case WBEM_E_CALL_CANCELLED:
        symbol = L"WBEM_E_CALL_CANCELLED";
        hint = L"Operation was cancelled or timed out. Retry and reduce query scope if needed.";
        break;
    case E_ACCESSDENIED:
        symbol = L"E_ACCESSDENIED";
        hint = L"Access denied. Verify credentials, privileges, and remote management policy.";
        break;
    case HRESULT_FROM_WIN32(RPC_S_SERVER_UNAVAILABLE):
        symbol = L"RPC_S_SERVER_UNAVAILABLE";
        hint = L"RPC server unavailable. Verify target hostname, network reachability, firewall, and RPC service.";
        break;
    default:
        break;
    }

    std::wstring systemText = GetSystemMessageForHResult(hr);
    std::wstring out = HResultToHex(hr) + L" (" + symbol + L")";
    if (!systemText.empty()) {
        out += L": " + systemText;
    }
    if (!hint.empty()) {
        out += L". " + hint;
    }
    return out;
}

bool ProbeWmiSecurityLevel(const WmiTargetConfig& target, const WmiSecurityConfig& securityConfig, const std::wstring& wmiLocale, std::wstring& details) {
    IWbemServices* pSvc = NULL;
    if (!ConnectWmiServices(target, L"ROOT\\CIMV2", securityConfig, wmiLocale, &pSvc)) {
        details = L"ConnectServer/ProxyBlanket failed";
        return false;
    }

    IEnumWbemClassObject* pEnumerator = NULL;
    HRESULT hr = pSvc->ExecQuery(
        bstr_t("WQL"),
        bstr_t(L"SELECT Caption FROM Win32_OperatingSystem"),
        WBEM_FLAG_FORWARD_ONLY | WBEM_FLAG_RETURN_IMMEDIATELY,
        NULL,
        &pEnumerator
    );

    if (FAILED(hr)) {
        details = L"WMI probe query failed (" + DescribeWmiHResult(hr) + L")";
        pSvc->Release();
        return false;
    }

    IWbemClassObject* pclsObj = NULL;
    ULONG uReturn = 0;
    hr = pEnumerator->Next(WBEM_INFINITE, 1, &pclsObj, &uReturn);
    bool available = SUCCEEDED(hr) && uReturn > 0;

    if (available) {
        details = L"Available";
        pclsObj->Release();
    } else {
        details = L"Probe returned no data (" + DescribeWmiHResult(hr) + L")";
    }

    pEnumerator->Release();
    pSvc->Release();

    return available;
}

void PrintWmiSecurityAvailability(const WmiTargetConfig& target, const std::wstring& wmiLocale) {
    std::vector<std::wstring> levels = { L"default", L"connect", L"call", L"pkt", L"pktprivacy" };

    Table table;
    table.headers = { L"Security Level", L"Status", L"Details" };

    for (const auto& level : levels) {
        WmiSecurityConfig cfg;
        TryParseWmiSecurity(level, cfg);

        std::wstring details;
        bool ok = ProbeWmiSecurityLevel(target, cfg, wmiLocale, details);
        table.rows.push_back({ level, ok ? L"Available" : L"Unavailable", details });
    }

    if (g_outputOptions.format == OutputFormat::Table) {
        std::wcout << L"\nWMI Security Capability Check:" << std::endl;
    }
    table.Print();
}

std::wstring ReadRegistryStringValueWithHive(
    IWbemServices* pSvc,
    IWbemClassObject* pRegClass,
    unsigned long hive,
    const std::wstring& subKey,
    const std::wstring& valueName
);

std::wstring ReadRegistryStringValue(IWbemServices* pSvc, IWbemClassObject* pRegClass, const std::wstring& subKey, const std::wstring& valueName) {
    const unsigned long HKEY_LOCAL_MACHINE_HIVE = 0x80000002;
    return ReadRegistryStringValueWithHive(pSvc, pRegClass, HKEY_LOCAL_MACHINE_HIVE, subKey, valueName);
}

std::wstring ReadRegistryStringValueWithHive(
    IWbemServices* pSvc,
    IWbemClassObject* pRegClass,
    unsigned long hive,
    const std::wstring& subKey,
    const std::wstring& valueName
) {
    IWbemClassObject* pInDef = NULL;
    HRESULT hr = pRegClass->GetMethod(L"GetStringValue", 0, &pInDef, NULL);
    if (FAILED(hr) || pInDef == NULL) return L"";

    IWbemClassObject* pInParams = NULL;
    hr = pInDef->SpawnInstance(0, &pInParams);
    pInDef->Release();
    if (FAILED(hr) || pInParams == NULL) return L"";

    VARIANT vt;
    VariantInit(&vt);

    V_VT(&vt) = VT_UI4;
    V_UI4(&vt) = hive;
    pInParams->Put(L"hDefKey", 0, &vt, 0);
    VariantClear(&vt);

    V_VT(&vt) = VT_BSTR;
    V_BSTR(&vt) = SysAllocString(subKey.c_str());
    pInParams->Put(L"sSubKeyName", 0, &vt, 0);
    VariantClear(&vt);

    V_VT(&vt) = VT_BSTR;
    V_BSTR(&vt) = SysAllocString(valueName.c_str());
    pInParams->Put(L"sValueName", 0, &vt, 0);
    VariantClear(&vt);

    IWbemClassObject* pOutParams = NULL;
    hr = pSvc->ExecMethod(_bstr_t(L"StdRegProv"), _bstr_t(L"GetStringValue"), 0, NULL, pInParams, &pOutParams, NULL);
    pInParams->Release();
    if (FAILED(hr) || pOutParams == NULL) return L"";

    VARIANT vtOut;
    VariantInit(&vtOut);
    std::wstring result;
    hr = pOutParams->Get(L"sValue", 0, &vtOut, NULL, NULL);
    if (SUCCEEDED(hr) && V_VT(&vtOut) == VT_BSTR && V_BSTR(&vtOut) != NULL) {
        result = V_BSTR(&vtOut);
    }
    VariantClear(&vtOut);
    pOutParams->Release();
    return result;
}

bool ReadRegistryDwordValueWithHive(
    IWbemServices* pSvc,
    IWbemClassObject* pRegClass,
    unsigned long hive,
    const std::wstring& subKey,
    const std::wstring& valueName,
    unsigned long& valueOut
) {
    valueOut = 0;

    IWbemClassObject* pInDef = NULL;
    HRESULT hr = pRegClass->GetMethod(L"GetDWORDValue", 0, &pInDef, NULL);
    if (FAILED(hr) || pInDef == NULL) return false;

    IWbemClassObject* pInParams = NULL;
    hr = pInDef->SpawnInstance(0, &pInParams);
    pInDef->Release();
    if (FAILED(hr) || pInParams == NULL) return false;

    VARIANT vt;
    VariantInit(&vt);

    V_VT(&vt) = VT_UI4;
    V_UI4(&vt) = hive;
    pInParams->Put(L"hDefKey", 0, &vt, 0);
    VariantClear(&vt);

    V_VT(&vt) = VT_BSTR;
    V_BSTR(&vt) = SysAllocString(subKey.c_str());
    pInParams->Put(L"sSubKeyName", 0, &vt, 0);
    VariantClear(&vt);

    V_VT(&vt) = VT_BSTR;
    V_BSTR(&vt) = SysAllocString(valueName.c_str());
    pInParams->Put(L"sValueName", 0, &vt, 0);
    VariantClear(&vt);

    IWbemClassObject* pOutParams = NULL;
    hr = pSvc->ExecMethod(_bstr_t(L"StdRegProv"), _bstr_t(L"GetDWORDValue"), 0, NULL, pInParams, &pOutParams, NULL);
    pInParams->Release();
    if (FAILED(hr) || pOutParams == NULL) return false;

    VARIANT vtOut;
    VariantInit(&vtOut);
    bool success = false;
    hr = pOutParams->Get(L"uValue", 0, &vtOut, NULL, NULL);
    if (SUCCEEDED(hr) && (V_VT(&vtOut) == VT_UI4 || V_VT(&vtOut) == VT_I4)) {
        valueOut = (V_VT(&vtOut) == VT_UI4) ? V_UI4(&vtOut) : static_cast<unsigned long>(V_I4(&vtOut));
        success = true;
    }
    VariantClear(&vtOut);
    pOutParams->Release();
    return success;
}

bool EnumRegistrySubKeysWithHive(
    IWbemServices* pSvc,
    IWbemClassObject* pRegClass,
    unsigned long hive,
    const std::wstring& subKey,
    std::vector<std::wstring>& namesOut
) {
    namesOut.clear();

    IWbemClassObject* pInDef = NULL;
    HRESULT hr = pRegClass->GetMethod(L"EnumKey", 0, &pInDef, NULL);
    if (FAILED(hr) || pInDef == NULL) return false;

    IWbemClassObject* pInParams = NULL;
    hr = pInDef->SpawnInstance(0, &pInParams);
    pInDef->Release();
    if (FAILED(hr) || pInParams == NULL) return false;

    VARIANT vt;
    VariantInit(&vt);

    V_VT(&vt) = VT_UI4;
    V_UI4(&vt) = hive;
    pInParams->Put(L"hDefKey", 0, &vt, 0);
    VariantClear(&vt);

    V_VT(&vt) = VT_BSTR;
    V_BSTR(&vt) = SysAllocString(subKey.c_str());
    pInParams->Put(L"sSubKeyName", 0, &vt, 0);
    VariantClear(&vt);

    IWbemClassObject* pOutParams = NULL;
    hr = pSvc->ExecMethod(_bstr_t(L"StdRegProv"), _bstr_t(L"EnumKey"), 0, NULL, pInParams, &pOutParams, NULL);
    pInParams->Release();
    if (FAILED(hr) || pOutParams == NULL) return false;

    VARIANT vtNames;
    VariantInit(&vtNames);
    hr = pOutParams->Get(L"sNames", 0, &vtNames, NULL, NULL);
    if (FAILED(hr) || !(V_VT(&vtNames) & VT_ARRAY) || V_ARRAY(&vtNames) == NULL) {
        VariantClear(&vtNames);
        pOutParams->Release();
        return false;
    }

    long lBound = 0;
    long uBound = -1;
    SafeArrayGetLBound(V_ARRAY(&vtNames), 1, &lBound);
    SafeArrayGetUBound(V_ARRAY(&vtNames), 1, &uBound);

    for (long i = lBound; i <= uBound; ++i) {
        BSTR keyNameBstr = NULL;
        hr = SafeArrayGetElement(V_ARRAY(&vtNames), &i, &keyNameBstr);
        if (SUCCEEDED(hr) && keyNameBstr != NULL) {
            namesOut.push_back(std::wstring(keyNameBstr));
            SysFreeString(keyNameBstr);
        }
    }

    VariantClear(&vtNames);
    pOutParams->Release();
    return true;
}

bool CollectInstalledAppsByArchitecture(
    const WmiTargetConfig& target,
    bool showWin32Apps,
    const std::wstring& wmiLocale,
    const WmiSecurityConfig& securityConfig,
    std::vector<InstalledAppRecord>& recordsOut
) {
    recordsOut.clear();

    IWbemServices* pSvc = NULL;
    if (!ConnectWmiServices(target, L"ROOT\\DEFAULT", securityConfig, wmiLocale, &pSvc)) {
        return false;
    }

    IWbemClassObject* pRegClass = NULL;
    HRESULT hr = pSvc->GetObject(_bstr_t(L"StdRegProv"), 0, NULL, &pRegClass, NULL);
    if (FAILED(hr) || pRegClass == NULL) {
        pSvc->Release();
        return false;
    }

    const std::wstring uninstallPath = showWin32Apps
        ? L"SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall"
        : L"SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall";

    const unsigned long HKEY_LOCAL_MACHINE_HIVE = 0x80000002;
    std::vector<std::wstring> keyNames;
    if (!EnumRegistrySubKeysWithHive(pSvc, pRegClass, HKEY_LOCAL_MACHINE_HIVE, uninstallPath, keyNames)) {
        pRegClass->Release();
        pSvc->Release();
        return false;
    }

    std::vector<InstalledAppRecord> records;
    records.reserve(keyNames.size());
    for (const auto& keyName : keyNames) {

        std::wstring fullSubKey = uninstallPath + L"\\" + keyName;
        std::wstring appName = ReadRegistryStringValue(pSvc, pRegClass, fullSubKey, L"DisplayName");
        if (appName.empty()) {
            continue;
        }

        InstalledAppRecord rec;
        rec.name = appName;
        rec.version = ReadRegistryStringValue(pSvc, pRegClass, fullSubKey, L"DisplayVersion");
        rec.publisher = ReadRegistryStringValue(pSvc, pRegClass, fullSubKey, L"Publisher");
        if (rec.version.empty()) rec.version = L"N/A";
        if (rec.publisher.empty()) rec.publisher = L"N/A";
        records.push_back(std::move(rec));
    }

    pRegClass->Release();
    pSvc->Release();

    std::sort(records.begin(), records.end(), [](const InstalledAppRecord& a, const InstalledAppRecord& b) {
        return a.name < b.name;
    });

    recordsOut = std::move(records);
    return true;
}

bool PrintInstalledAppsByArchitecture(const WmiTargetConfig& target, bool showWin32Apps, const std::wstring& wmiLocale, const WmiSecurityConfig& securityConfig) {
    g_lastNoData = false;
    std::vector<InstalledAppRecord> records;
    if (!CollectInstalledAppsByArchitecture(target, showWin32Apps, wmiLocale, securityConfig, records)) {
        return false;
    }

    Table table;
    table.headers = { L"Name", L"Version", L"Publisher" };
    for (const auto& rec : records) {
        table.rows.push_back({ rec.name, rec.version, rec.publisher });
    }

    if (g_outputOptions.format == OutputFormat::Table) {
        std::wcout << L"\n"
                   << (showWin32Apps ? L"Installed Win32 Applications:" : L"Installed Win64 Applications:")
                   << std::endl;
    }

    if (table.rows.empty()) {
        g_lastNoData = true;
        std::wcout << L"  No data available.\n" << std::endl;
        return true;
    }

    table.Print();
    return true;
}

bool PrintInstalledAppsAggregated(const WmiTargetConfig& target, const std::wstring& wmiLocale, const WmiSecurityConfig& securityConfig) {
    g_lastNoData = false;

    std::vector<InstalledAppRecord> records64;
    std::vector<InstalledAppRecord> records32;

    bool ok64 = CollectInstalledAppsByArchitecture(target, false, wmiLocale, securityConfig, records64);
    bool ok32 = CollectInstalledAppsByArchitecture(target, true, wmiLocale, securityConfig, records32);

    if (!ok64 && !ok32) {
        return false;
    }

    auto toLower = [](std::wstring value) {
        std::transform(value.begin(), value.end(), value.begin(), towlower);
        return value;
    };

    std::set<std::wstring> seen;
    std::vector<InstalledAppRecord> merged;
    merged.reserve(records64.size() + records32.size());

    auto appendUnique = [&](const std::vector<InstalledAppRecord>& src) {
        for (const auto& rec : src) {
            std::wstring key = toLower(rec.name) + L"|" + toLower(rec.version) + L"|" + toLower(rec.publisher);
            if (seen.insert(key).second) {
                merged.push_back(rec);
            }
        }
    };

    appendUnique(records64);
    appendUnique(records32);

    std::sort(merged.begin(), merged.end(), [](const InstalledAppRecord& a, const InstalledAppRecord& b) {
        return a.name < b.name;
    });

    Table table;
    table.headers = { L"Name", L"Version", L"Publisher" };
    for (const auto& rec : merged) {
        table.rows.push_back({ rec.name, rec.version, rec.publisher });
    }

    if (g_outputOptions.format == OutputFormat::Table) {
        std::wcout << L"\nInstalled Applications (Win64 + Win32):" << std::endl;
    }

    if (table.rows.empty()) {
        g_lastNoData = true;
        std::wcout << L"  No data available.\n" << std::endl;
        return true;
    }

    table.Print();
    return true;
}

bool PrintInstalledAppsViaPowerShellTransport(const WmiTargetConfig& target, int architectureMode, std::wstring& errorOut) {
    errorOut.clear();
    g_lastNoData = false;

    if (!target.user.empty() || !target.password.empty() || !target.domain.empty()) {
        errorOut = L"apps over non-DCOM transport currently requires current logon token (no explicit credentials).";
        return false;
    }

    auto buildScript = [&](bool forSsh) -> std::wstring {
        std::wstring script;
        script += L"$ErrorActionPreference='Stop';";
        script += L"[uint32]$hklm=2147483650;";

        if (!forSsh && !target.node.empty() && target.node != L"." && _wcsicmp(target.node.c_str(), L"localhost") != 0) {
            script += L"$cimOpts=@{ComputerName='" + EscapePowerShellSingleQuoted(target.node) + L"'};";
        } else {
            script += L"$cimOpts=@{};";
        }

        script += L"function Get-AppRecords([string]$subKey,[hashtable]$opts){";
        script += L"$r=Invoke-CimMethod @opts -Namespace 'root/default' -ClassName 'StdRegProv' -MethodName 'EnumKey' -Arguments @{hDefKey=[uint32]$hklm;sSubKeyName=$subKey};";
        script += L"if($null -eq $r -or $null -eq $r.sNames){return @()};";
        script += L"$rows=@();";
        script += L"foreach($key in $r.sNames){";
        script += L"$full=$subKey+'\\'+$key;";
        script += L"$name=(Invoke-CimMethod @opts -Namespace 'root/default' -ClassName 'StdRegProv' -MethodName 'GetStringValue' -Arguments @{hDefKey=[uint32]$hklm;sSubKeyName=$full;sValueName='DisplayName'}).sValue;";
        script += L"if([string]::IsNullOrWhiteSpace($name)){continue};";
        script += L"$ver=(Invoke-CimMethod @opts -Namespace 'root/default' -ClassName 'StdRegProv' -MethodName 'GetStringValue' -Arguments @{hDefKey=[uint32]$hklm;sSubKeyName=$full;sValueName='DisplayVersion'}).sValue;";
        script += L"$pub=(Invoke-CimMethod @opts -Namespace 'root/default' -ClassName 'StdRegProv' -MethodName 'GetStringValue' -Arguments @{hDefKey=[uint32]$hklm;sSubKeyName=$full;sValueName='Publisher'}).sValue;";
        script += L"if([string]::IsNullOrWhiteSpace($ver)){$ver='N/A'}; if([string]::IsNullOrWhiteSpace($pub)){$pub='N/A'};";
        script += L"$rows += [PSCustomObject]@{Name=$name;Version=$ver;Publisher=$pub};";
        script += L"};";
        script += L"return $rows;";
        script += L"};";

        script += L"$records=@();";
        if (architectureMode == 0 || architectureMode == 64) {
            script += L"$records += Get-AppRecords 'SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall' $cimOpts;";
        }
        if (architectureMode == 0 || architectureMode == 32) {
            script += L"$records += Get-AppRecords 'SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall' $cimOpts;";
        }

        if (architectureMode == 0) {
            script += L"$records = $records | Group-Object Name,Version,Publisher | ForEach-Object { $_.Group[0] };";
        }

        script += L"$records = $records | Sort-Object Name,Version,Publisher;";

        if (g_outputOptions.format == OutputFormat::Json) {
            script += L"$records | ConvertTo-Json -Depth 4 -Compress";
        } else if (g_outputOptions.format == OutputFormat::Csv) {
            script += L"$csv=$records | ConvertTo-Csv -NoTypeInformation;";
            if (g_outputOptions.noHeader) {
                script += L"if($csv.Count -gt 1){$csv=$csv[1..($csv.Count-1)]}else{$csv=@()};";
            }
            script += L"$csv";
        } else {
            script += L"$records | Format-Table -Property Name,Version,Publisher -AutoSize";
        }

        return script;
    };

    std::wstring output;
    int code = -1;
    bool ok = false;
    if (target.transport == TransportMode::Ssh) {
        ok = RunSshPowerShellScriptCapture(target, buildScript(true), output, code);
    } else if (target.transport == TransportMode::WinRm) {
        ok = RunPowerShellCommandCapture(buildScript(false), output, code);
    } else {
        errorOut = L"Invalid transport for PrintInstalledAppsViaPowerShellTransport.";
        return false;
    }

    if (!ok || code != 0) {
        errorOut = (target.transport == TransportMode::Ssh)
            ? L"SSH PowerShell apps backend failed."
            : L"WinRM PowerShell apps backend failed.";
        std::wstring details = TrimWhitespace(output);
        if (!details.empty()) {
            errorOut += L" Details: " + details;
        }
        return false;
    }

    std::wstring trimmed = TrimWhitespace(output);
    if (trimmed.empty()) {
        g_lastNoData = true;
        std::wcout << L"  No data available.\n" << std::endl;
        return true;
    }

    std::wcout << output;
    if (output.back() != L'\n') std::wcout << L"\n";
    return true;
}

enum class WslProbeError {
    None,
    NoDistrosFound,
    UnsupportedTransport,
    RemoteTargetSkipped,
    AccessDenied,
    RegistryUnavailable,
    WslNotInstalled,
    PowerShellFailed,
    UnsupportedHost,
    Unknown
};

struct WslDetectionResult {
    WslProbeError status = WslProbeError::None;
    bool foundDistros = false;
    bool attemptedRegistry = false;
    bool registryAccessible = false;
    bool attemptedCli = false;
    bool cliSucceeded = false;
    bool isLocalTarget = false;
    std::vector<std::pair<std::wstring, std::wstring>> distros;
    std::vector<std::wstring> diagnostics;
    std::vector<std::wstring> errors;
};

std::wstring DescribeWslProbeError(WslProbeError error) {
    switch (error) {
    case WslProbeError::None: return L"Success";
    case WslProbeError::NoDistrosFound: return L"No distros found";
    case WslProbeError::UnsupportedTransport: return L"Unsupported transport for local WSL probing";
    case WslProbeError::RemoteTargetSkipped: return L"Remote target skipped";
    case WslProbeError::AccessDenied: return L"Access denied";
    case WslProbeError::RegistryUnavailable: return L"Registry path unavailable";
    case WslProbeError::WslNotInstalled: return L"WSL CLI not available";
    case WslProbeError::PowerShellFailed: return L"PowerShell fallback failed";
    case WslProbeError::UnsupportedHost: return L"Unsupported host environment";
    case WslProbeError::Unknown:
    default: return L"Unknown error";
    }
}

void AppendWslDiagnostic(WslDetectionResult& result, const std::wstring& message) {
    if (!message.empty()) {
        result.diagnostics.push_back(message);
    }
}

void AppendWslError(WslDetectionResult& result, WslProbeError error, const std::wstring& detail) {
    if (result.status == WslProbeError::None || result.status == WslProbeError::NoDistrosFound) {
        result.status = error;
    }
    if (!detail.empty()) {
        result.errors.push_back(detail);
    }
}

std::wstring FormatWslDetectionSummary(const WslDetectionResult& result) {
    std::wstring summary = DescribeWslProbeError(result.status);
    if (!result.diagnostics.empty()) {
        summary += L"; " + result.diagnostics.front();
    }
    return summary;
}

bool ReadRegistryStringValueDirect(HKEY hive, const std::wstring& subKey, const std::wstring& valueName, std::wstring& valueOut) {
    valueOut.clear();

    HKEY key = nullptr;
    if (RegOpenKeyExW(hive, subKey.c_str(), 0, KEY_READ, &key) != ERROR_SUCCESS) {
        return false;
    }

    DWORD type = 0;
    DWORD dataSize = 0;
    LONG rc = RegQueryValueExW(key, valueName.c_str(), nullptr, &type, nullptr, &dataSize);
    if (rc != ERROR_SUCCESS || (type != REG_SZ && type != REG_EXPAND_SZ)) {
        RegCloseKey(key);
        return false;
    }

    std::vector<wchar_t> buffer((dataSize / sizeof(wchar_t)) + 1);
    rc = RegQueryValueExW(key, valueName.c_str(), nullptr, &type, reinterpret_cast<LPBYTE>(buffer.data()), &dataSize);
    RegCloseKey(key);
    if (rc != ERROR_SUCCESS) {
        return false;
    }

    valueOut = buffer.data();
    return true;
}

bool ReadRegistryDwordValueDirect(HKEY hive, const std::wstring& subKey, const std::wstring& valueName, DWORD& valueOut) {
    valueOut = 0;

    HKEY key = nullptr;
    if (RegOpenKeyExW(hive, subKey.c_str(), 0, KEY_READ, &key) != ERROR_SUCCESS) {
        return false;
    }

    DWORD type = 0;
    DWORD dataSize = sizeof(DWORD);
    DWORD value = 0;
    LONG rc = RegQueryValueExW(key, valueName.c_str(), nullptr, &type, reinterpret_cast<LPBYTE>(&value), &dataSize);
    RegCloseKey(key);
    if (rc != ERROR_SUCCESS || type != REG_DWORD) {
        return false;
    }

    valueOut = value;
    return true;
}

bool EnumerateWslDistrosFromRegistry(HKEY hive, const std::wstring& rootSubKey, std::vector<std::pair<std::wstring, std::wstring>>& distrosOut) {
    distrosOut.clear();

    HKEY key = nullptr;
    if (RegOpenKeyExW(hive, rootSubKey.c_str(), 0, KEY_READ, &key) != ERROR_SUCCESS) {
        return false;
    }

    DWORD subKeyCount = 0;
    DWORD maxNameLength = 0;
    LONG rc = RegQueryInfoKeyW(key, nullptr, nullptr, nullptr, &subKeyCount, &maxNameLength, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr);
    RegCloseKey(key);
    if (rc != ERROR_SUCCESS) {
        return false;
    }

    if (subKeyCount == 0) {
        return false;
    }

    if (RegOpenKeyExW(hive, rootSubKey.c_str(), 0, KEY_READ, &key) != ERROR_SUCCESS) {
        return false;
    }

    std::vector<wchar_t> nameBuffer(maxNameLength + 1);
    for (DWORD i = 0; i < subKeyCount; ++i) {
        DWORD nameLength = static_cast<DWORD>(nameBuffer.size());
        if (RegEnumKeyExW(key, i, nameBuffer.data(), &nameLength, nullptr, nullptr, nullptr, nullptr) != ERROR_SUCCESS) {
            continue;
        }

        std::wstring subKey = rootSubKey + L"\\" + nameBuffer.data();
        std::wstring distroName;
        if (!ReadRegistryStringValueDirect(hive, subKey, L"DistributionName", distroName)) {
            continue;
        }

        std::wstring versionText = L"Version Unknown";
        DWORD version = 0;
        if (ReadRegistryDwordValueDirect(hive, subKey, L"Version", version)) {
            versionText = L"WSL" + std::to_wstring(version);
        }

        distrosOut.push_back({ distroName, versionText });
    }

    RegCloseKey(key);
    return !distrosOut.empty();
}

bool ParseWslListOutput(const std::wstring& wslOutput, std::vector<std::pair<std::wstring, std::wstring>>& distrosOut, const std::wstring& sourceLabel);

bool CollectWslDetectionResult(
    const WmiTargetConfig& target,
    const std::wstring& wmiLocale,
    const WmiSecurityConfig& securityConfig,
    WslDetectionResult& result
) {
    result = WslDetectionResult{};

    result.isLocalTarget = target.node.empty() || target.node == L"." || _wcsicmp(target.node.c_str(), L"localhost") == 0;

    if (target.transport != TransportMode::DcomRpc) {
        AppendWslDiagnostic(result, L"WSL probing is only supported for local DCOM targets.");
        AppendWslError(result, WslProbeError::UnsupportedTransport, L"Unsupported transport for WSL probing.");
        return false;
    }

    if (!result.isLocalTarget) {
        AppendWslDiagnostic(result, L"Skipping WSL probe on remote target because local registry and CLI fallback are unavailable.");
        AppendWslError(result, WslProbeError::RemoteTargetSkipped, L"Remote targets are not probed for WSL fallbacks.");
        return false;
    }

    IWbemServices* pRegSvc = NULL;
    if (!ConnectWmiServices(target, L"ROOT\\DEFAULT", securityConfig, wmiLocale, &pRegSvc)) {
        AppendWslDiagnostic(result, L"Unable to connect to ROOT\\DEFAULT for WSL registry probing.");
        AppendWslError(result, WslProbeError::RegistryUnavailable, L"WMI connection to ROOT\\DEFAULT failed.");
        return false;
    }

    result.attemptedRegistry = true;

    IWbemClassObject* pRegClass = NULL;
    HRESULT hr = pRegSvc->GetObject(_bstr_t(L"StdRegProv"), 0, NULL, &pRegClass, NULL);
    if (SUCCEEDED(hr) && pRegClass != NULL) {
        result.registryAccessible = true;
        const unsigned long HKEY_CURRENT_USER_HIVE = 0x80000001;
        const std::wstring lxssPath = L"SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Lxss";

        std::vector<std::wstring> distroKeys;
        std::wstring defaultDistroGuid = ReadRegistryStringValueWithHive(
            pRegSvc,
            pRegClass,
            HKEY_CURRENT_USER_HIVE,
            lxssPath,
            L"DefaultDistribution"
        );

        int distroCount = 0;
        if (EnumRegistrySubKeysWithHive(pRegSvc, pRegClass, HKEY_CURRENT_USER_HIVE, lxssPath, distroKeys)) {
            for (const auto& key : distroKeys) {
                std::wstring subKey = lxssPath + L"\\" + key;
                std::wstring distroName = ReadRegistryStringValueWithHive(
                    pRegSvc,
                    pRegClass,
                    HKEY_CURRENT_USER_HIVE,
                    subKey,
                    L"DistributionName"
                );

                if (distroName.empty()) {
                    continue;
                }

                unsigned long version = 0;
                std::wstring value = L"Version Unknown";
                if (ReadRegistryDwordValueWithHive(pRegSvc, pRegClass, HKEY_CURRENT_USER_HIVE, subKey, L"Version", version)) {
                    value = L"WSL" + std::to_wstring(version);
                }

                if (!defaultDistroGuid.empty() && _wcsicmp(defaultDistroGuid.c_str(), key.c_str()) == 0) {
                    value += L" (Default)";
                }

                result.distros.push_back({ distroName, value });
                ++distroCount;
            }
        }

        if (distroCount == 0) {
            std::vector<std::pair<std::wstring, std::wstring>> directDistros;
            bool directOk = EnumerateWslDistrosFromRegistry(HKEY_CURRENT_USER, L"SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Lxss", directDistros);
            if (!directOk) {
                directOk = EnumerateWslDistrosFromRegistry(HKEY_LOCAL_MACHINE, L"SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Lxss", directDistros);
            }
            if (directOk) {
                result.distros.insert(result.distros.end(), directDistros.begin(), directDistros.end());
                AppendWslDiagnostic(result, L"Detected WSL distributions via direct registry fallback.");
            }
        }

        if (!result.distros.empty()) {
            result.foundDistros = true;
            result.status = WslProbeError::None;
        }

        pRegClass->Release();
    } else {
        AppendWslDiagnostic(result, L"StdRegProv access failed; falling back to direct registry and CLI probing.");
        AppendWslError(result, WslProbeError::AccessDenied, L"StdRegProv access failed.");
    }

    if (!result.foundDistros) {
        result.attemptedCli = true;
        std::wstring wslOutput;
        int wslExit = -1;
        bool cliOk = RunCommandCapture(L"wsl.exe -l -q", wslOutput, wslExit);
        if (cliOk && wslExit == 0) {
            result.cliSucceeded = true;
            ParseWslListOutput(wslOutput, result.distros, L"Detected via wsl.exe");
            if (!result.distros.empty()) {
                result.foundDistros = true;
                AppendWslDiagnostic(result, L"Detected WSL distributions via wsl.exe -l -q fallback.");
            }
        } else {
            AppendWslError(result, WslProbeError::PowerShellFailed, L"WSL CLI fallback command did not succeed.");
            if (wslExit != 0) {
                AppendWslDiagnostic(result, L"wsl.exe returned a non-zero exit code during fallback probing.");
            }
        }
    }

    if (!result.foundDistros) {
        result.status = WslProbeError::NoDistrosFound;
        AppendWslDiagnostic(result, L"No WSL distributions were discovered from registry or CLI fallback paths.");
    }

    if (pRegSvc) {
        pRegSvc->Release();
    }

    if (!result.errors.empty()) {
        std::wclog << L"[WSL] " << FormatWslDetectionSummary(result) << std::endl;
    }

    return true;
}

bool ParseWslListOutput(const std::wstring& wslOutput, std::vector<std::pair<std::wstring, std::wstring>>& distrosOut, const std::wstring& sourceLabel) {
    size_t pos = 0;
    while (pos <= wslOutput.size()) {
        size_t lineEnd = wslOutput.find_first_of(L"\r\n", pos);
        if (lineEnd == std::wstring::npos) {
            lineEnd = wslOutput.size();
        }

        std::wstring trimmed = TrimWhitespace(wslOutput.substr(pos, lineEnd - pos));
        trimmed.erase(std::remove(trimmed.begin(), trimmed.end(), L'\0'), trimmed.end());
        trimmed = TrimWhitespace(trimmed);

        if (!trimmed.empty() && trimmed.size() > 1) {
            std::wstring lowered = trimmed;
            std::transform(lowered.begin(), lowered.end(), lowered.begin(), towlower);
            if (lowered.find(L"for information") != 0 &&
                lowered.find(L"windows subsystem for linux has no installed distributions") != 0 &&
                lowered.find(L"https://aka.ms/") != 0 &&
                lowered.find(L"the operation completed successfully") != 0) {
                distrosOut.push_back({ trimmed, sourceLabel });
            }
        }

        if (lineEnd == wslOutput.size()) {
            break;
        }

        pos = lineEnd;
        while (pos < wslOutput.size() && (wslOutput[pos] == L'\r' || wslOutput[pos] == L'\n')) {
            ++pos;
        }
    }

    return !distrosOut.empty();
}

bool ExecuteVirtualSwitchQuery(const WmiTargetConfig& target, const std::wstring& wmiLocale, const WmiSecurityConfig& securityConfig) {
    g_lastNoData = false;

    Table table;
    table.headers = { L"Category", L"Item", L"Value" };

    auto addRow = [&](const std::wstring& category, const std::wstring& item, const std::wstring& value) {
        table.rows.push_back({ category, item, value });
    };

    addRow(L"Context", L"Process Elevation", GetProcessElevationStateString());
    addRow(L"Context", L"User SID", GetCurrentUserSidString());
    if (g_outputOptions.verbose) {
        addRow(L"Context", L"Verbose", L"Enabled");
    }

    std::wstring wslPlatformState;
    std::vector<std::wstring> wslDiagnostics;
    auto addDiagnostic = [&](const std::wstring& message) {
        if (!message.empty()) {
            wslDiagnostics.push_back(message);
        }
    };

    auto updatePlatformRow = [&](const std::wstring& item, const std::wstring& value) {
        for (auto& row : table.rows) {
            if (row.size() >= 2 && row[0] == L"Platform" && row[1] == item) {
                row[2] = value;
            }
        }
    };

    IWbemServices* pSvc = NULL;
    if (ConnectWmiServices(target, L"ROOT\\CIMV2", securityConfig, wmiLocale, &pSvc)) {
        std::map<std::wstring, std::wstring> featureStates;

        IEnumWbemClassObject* pFeatureEnum = NULL;
        HRESULT hr = pSvc->ExecQuery(
            bstr_t("WQL"),
            bstr_t(L"SELECT Name, InstallState FROM Win32_OptionalFeature WHERE Name='Microsoft-Hyper-V-All' OR Name='Microsoft-Hyper-V' OR Name='Microsoft-Hyper-V-Hypervisor' OR Name='Microsoft-Hyper-V-Services' OR Name='Microsoft-Hyper-V-Management-PowerShell' OR Name='VirtualMachinePlatform' OR Name='Microsoft-Windows-Subsystem-Linux' OR Name='HypervisorPlatform'"),
            WBEM_FLAG_FORWARD_ONLY | WBEM_FLAG_RETURN_IMMEDIATELY,
            NULL,
            &pFeatureEnum
        );

        if (SUCCEEDED(hr) && pFeatureEnum) {
            IWbemClassObject* pclsObj = NULL;
            ULONG uReturn = 0;
            while (pFeatureEnum) {
                hr = pFeatureEnum->Next(WBEM_INFINITE, 1, &pclsObj, &uReturn);
                if (FAILED(hr) || uReturn == 0) break;

                VARIANT vtName;
                VARIANT vtState;
                VariantInit(&vtName);
                VariantInit(&vtState);

                std::wstring featureName = L"N/A";
                std::wstring state = L"N/A";

                if (SUCCEEDED(pclsObj->Get(L"Name", 0, &vtName, 0, 0))) {
                    featureName = VariantToString(vtName);
                }
                if (SUCCEEDED(pclsObj->Get(L"InstallState", 0, &vtState, 0, 0))) {
                    state = MapOptionalFeatureInstallState(VariantToString(vtState));
                }

                featureStates[featureName] = state;

                if (featureName == L"Microsoft-Hyper-V-All") featureName = L"Hyper-V";
                else if (featureName == L"Microsoft-Hyper-V") featureName = L"Hyper-V Base";
                else if (featureName == L"Microsoft-Hyper-V-Hypervisor") featureName = L"Hyper-V Hypervisor";
                else if (featureName == L"Microsoft-Hyper-V-Services") featureName = L"Hyper-V Services";
                else if (featureName == L"Microsoft-Hyper-V-Management-PowerShell") featureName = L"Hyper-V PowerShell";
                else if (featureName == L"VirtualMachinePlatform") featureName = L"Virtual Machine Platform";
                else if (featureName == L"Microsoft-Windows-Subsystem-Linux") featureName = L"Windows Subsystem for Linux";
                else if (featureName == L"HypervisorPlatform") featureName = L"Windows Hypervisor Platform";

                addRow(L"Platform", featureName, state);

                VariantClear(&vtName);
                VariantClear(&vtState);
                pclsObj->Release();
            }

            pFeatureEnum->Release();
        }

        auto aggregateFeatureState = [&](const std::vector<std::wstring>& names) -> std::wstring {
            bool sawDisabled = false;
            for (const auto& n : names) {
                auto it = featureStates.find(n);
                if (it == featureStates.end()) {
                    continue;
                }
                if (it->second == L"Enabled") return L"Enabled";
                if (it->second == L"Disabled") sawDisabled = true;
            }
            if (sawDisabled) return L"Disabled";
            return L"Unavailable";
        };

        addRow(
            L"Platform",
            L"Hyper-V (Aggregated)",
            aggregateFeatureState({ L"Microsoft-Hyper-V-All", L"Microsoft-Hyper-V", L"Microsoft-Hyper-V-Hypervisor", L"Microsoft-Hyper-V-Services" })
        );
        wslPlatformState = aggregateFeatureState({ L"Microsoft-Windows-Subsystem-Linux", L"VirtualMachinePlatform" });
        addRow(
            L"Platform",
            L"WSL (Aggregated)",
            wslPlatformState
        );

        IEnumWbemClassObject* pSysEnum = NULL;
        hr = pSvc->ExecQuery(
            bstr_t("WQL"),
            bstr_t(L"SELECT HypervisorPresent FROM Win32_ComputerSystem"),
            WBEM_FLAG_FORWARD_ONLY | WBEM_FLAG_RETURN_IMMEDIATELY,
            NULL,
            &pSysEnum
        );

        if (SUCCEEDED(hr) && pSysEnum) {
            IWbemClassObject* pclsObj = NULL;
            ULONG uReturn = 0;
            hr = pSysEnum->Next(WBEM_INFINITE, 1, &pclsObj, &uReturn);
            if (SUCCEEDED(hr) && uReturn > 0 && pclsObj) {
                VARIANT vtHypervisor;
                VariantInit(&vtHypervisor);
                std::wstring present = L"N/A";
                if (SUCCEEDED(pclsObj->Get(L"HypervisorPresent", 0, &vtHypervisor, 0, 0))) {
                    present = VariantToString(vtHypervisor);
                }
                addRow(L"Platform", L"Hypervisor Present", present);
                VariantClear(&vtHypervisor);
                pclsObj->Release();
            }
            pSysEnum->Release();
        }

        IEnumWbemClassObject* pSvcEnum = NULL;
        hr = pSvc->ExecQuery(
            bstr_t("WQL"),
            bstr_t(L"SELECT Name, State, StartMode FROM Win32_Service WHERE Name='vmms' OR Name='vmcompute' OR Name='LxssManager'"),
            WBEM_FLAG_FORWARD_ONLY | WBEM_FLAG_RETURN_IMMEDIATELY,
            NULL,
            &pSvcEnum
        );

        if (SUCCEEDED(hr) && pSvcEnum) {
            IWbemClassObject* pclsObj = NULL;
            ULONG uReturn = 0;
            while (pSvcEnum) {
                hr = pSvcEnum->Next(WBEM_INFINITE, 1, &pclsObj, &uReturn);
                if (FAILED(hr) || uReturn == 0) break;

                VARIANT vtName;
                VARIANT vtState;
                VARIANT vtStart;
                VariantInit(&vtName);
                VariantInit(&vtState);
                VariantInit(&vtStart);

                std::wstring name = L"N/A";
                std::wstring state = L"N/A";
                std::wstring startMode = L"N/A";

                if (SUCCEEDED(pclsObj->Get(L"Name", 0, &vtName, 0, 0))) name = VariantToString(vtName);
                if (SUCCEEDED(pclsObj->Get(L"State", 0, &vtState, 0, 0))) state = VariantToString(vtState);
                if (SUCCEEDED(pclsObj->Get(L"StartMode", 0, &vtStart, 0, 0))) startMode = VariantToString(vtStart);

                std::wstring display = name;
                if (_wcsicmp(name.c_str(), L"vmms") == 0) display = L"Hyper-V Virtual Machine Management (vmms)";
                else if (_wcsicmp(name.c_str(), L"vmcompute") == 0) display = L"Host Compute Service (vmcompute)";
                else if (_wcsicmp(name.c_str(), L"LxssManager") == 0) display = L"WSL Service (LxssManager)";

                addRow(L"Service", display, state + L" / " + startMode);

                VariantClear(&vtName);
                VariantClear(&vtState);
                VariantClear(&vtStart);
                pclsObj->Release();
            }
            pSvcEnum->Release();
        }

        pSvc->Release();
    } else {
        addRow(L"Platform", L"Virtualization/WSL Feature Detection", L"Unavailable");
        if (g_outputOptions.verbose) {
            addRow(L"WSL Diagnostics", L"Error", L"Unable to connect to ROOT\\CIMV2 for platform feature detection.");
        }
    }

    IWbemServices* pHyperVSvc = NULL;
    if (ConnectWmiServices(target, L"ROOT\\virtualization\\v2", securityConfig, wmiLocale, &pHyperVSvc, false)) {
        IEnumWbemClassObject* pVmEnum = NULL;
        HRESULT hr = pHyperVSvc->ExecQuery(
            bstr_t("WQL"),
            bstr_t(L"SELECT ElementName, EnabledState FROM Msvm_ComputerSystem WHERE Caption='Virtual Machine'"),
            WBEM_FLAG_FORWARD_ONLY | WBEM_FLAG_RETURN_IMMEDIATELY,
            NULL,
            &pVmEnum
        );

        int vmCount = 0;
        if (SUCCEEDED(hr) && pVmEnum) {
            IWbemClassObject* pclsObj = NULL;
            ULONG uReturn = 0;
            while (pVmEnum) {
                hr = pVmEnum->Next(WBEM_INFINITE, 1, &pclsObj, &uReturn);
                if (FAILED(hr) || uReturn == 0) break;

                VARIANT vtName;
                VARIANT vtState;
                VariantInit(&vtName);
                VariantInit(&vtState);

                std::wstring vmName = L"N/A";
                std::wstring vmState = L"N/A";

                if (SUCCEEDED(pclsObj->Get(L"ElementName", 0, &vtName, 0, 0))) {
                    vmName = VariantToString(vtName);
                }
                if (SUCCEEDED(pclsObj->Get(L"EnabledState", 0, &vtState, 0, 0))) {
                    vmState = MapHyperVEnabledState(VariantToString(vtState));
                }

                addRow(L"Hyper-V VM", vmName, vmState);
                ++vmCount;

                VariantClear(&vtName);
                VariantClear(&vtState);
                pclsObj->Release();
            }

            pVmEnum->Release();
        }

        if (vmCount == 0) {
            addRow(L"Hyper-V VM", L"Instances", L"None found");
        }

        pHyperVSvc->Release();
    } else {
        addRow(L"Hyper-V VM", L"Instances", L"Unavailable (namespace not present or access denied)");
        if (g_outputOptions.verbose) {
            addRow(L"WSL Diagnostics", L"Error", L"Unable to connect to ROOT\\virtualization\\v2 for Hyper-V VM enumeration.");
        }
    }

    IWbemServices* pRegSvc = NULL;
    if (ConnectWmiServices(target, L"ROOT\\DEFAULT", securityConfig, wmiLocale, &pRegSvc)) {
        IWbemClassObject* pRegClass = NULL;
        HRESULT hr = pRegSvc->GetObject(_bstr_t(L"StdRegProv"), 0, NULL, &pRegClass, NULL);

        if (SUCCEEDED(hr) && pRegClass != NULL) {
            const unsigned long HKEY_CURRENT_USER_HIVE = 0x80000001;
            const std::wstring lxssPath = L"SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Lxss";

            std::vector<std::wstring> distroKeys;
            std::wstring defaultDistroGuid = ReadRegistryStringValueWithHive(
                pRegSvc,
                pRegClass,
                HKEY_CURRENT_USER_HIVE,
                lxssPath,
                L"DefaultDistribution"
            );

            int distroCount = 0;
            if (EnumRegistrySubKeysWithHive(pRegSvc, pRegClass, HKEY_CURRENT_USER_HIVE, lxssPath, distroKeys)) {
                for (const auto& key : distroKeys) {
                    std::wstring subKey = lxssPath + L"\\" + key;
                    std::wstring distroName = ReadRegistryStringValueWithHive(
                        pRegSvc,
                        pRegClass,
                        HKEY_CURRENT_USER_HIVE,
                        subKey,
                        L"DistributionName"
                    );

                    if (distroName.empty()) {
                        continue;
                    }

                    unsigned long version = 0;
                    std::wstring value = L"Version Unknown";
                    if (ReadRegistryDwordValueWithHive(pRegSvc, pRegClass, HKEY_CURRENT_USER_HIVE, subKey, L"Version", version)) {
                        value = L"WSL" + std::to_wstring(version);
                    }

                    if (!defaultDistroGuid.empty() && _wcsicmp(defaultDistroGuid.c_str(), key.c_str()) == 0) {
                        value += L" (Default)";
                    }

                    addRow(L"WSL Distro", distroName, value);
                    ++distroCount;
                }
            }

            if (distroCount == 0) {
                std::vector<std::pair<std::wstring, std::wstring>> directDistros;
                if (EnumerateWslDistrosFromRegistry(HKEY_CURRENT_USER, L"SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Lxss", directDistros) ||
                    EnumerateWslDistrosFromRegistry(HKEY_LOCAL_MACHINE, L"SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Lxss", directDistros)) {
                    for (const auto& entry : directDistros) {
                        addRow(L"WSL Distro", entry.first, entry.second);
                        ++distroCount;
                    }
                    addDiagnostic(L"Detected WSL distributions via direct registry fallback.");
                }
            }

            if (distroCount == 0) {
                bool isLocalTarget = target.node.empty() || target.node == L"." || _wcsicmp(target.node.c_str(), L"localhost") == 0;
                if (isLocalTarget && target.transport == TransportMode::DcomRpc) {
                    std::wstring wslOutput;
                    int wslExit = -1;
                    if (RunCommandCapture(L"wsl.exe -l -q", wslOutput, wslExit) && wslExit == 0) {
                        std::vector<std::pair<std::wstring, std::wstring>> cliDistros;
                        if (ParseWslListOutput(wslOutput, cliDistros, L"Detected via wsl.exe")) {
                            for (const auto& entry : cliDistros) {
                                addRow(L"WSL Distro", entry.first, entry.second);
                                ++distroCount;
                            }
                            addDiagnostic(L"Detected WSL distributions via wsl.exe -l -q fallback.");
                        }
                    }
                }
            }

            if (distroCount > 0) {
                wslPlatformState = L"Enabled";
                updatePlatformRow(L"Windows Subsystem for Linux", L"Enabled");
                updatePlatformRow(L"WSL (Aggregated)", L"Enabled");
            }

            if (distroCount == 0) {
                addRow(L"WSL Distro", L"Installed Distributions", L"None found (or different user profile context)");
                addDiagnostic(L"No WSL distributions were discovered from registry or CLI fallback paths.");
            }

            pRegClass->Release();
        } else {
            addRow(L"WSL Distro", L"Installed Distributions", L"Unavailable (StdRegProv access failed)");
        }

        pRegSvc->Release();
    } else {
        addRow(L"WSL Distro", L"Installed Distributions", L"Unavailable");
        addDiagnostic(L"Root\\DEFAULT registry access was unavailable for WSL distro discovery.");
    }

    for (const auto& note : wslDiagnostics) {
        addRow(L"WSL Diagnostics", L"Probe", note);
    }

    if (table.rows.empty()) {
        g_lastNoData = true;
        if (g_outputOptions.format == OutputFormat::Table) {
            std::wcout << L"  No data available.\n" << std::endl;
        }
        return false;
    }

    table.Print();
    return true;
}

bool ExecuteWMISwitchStateQuery(
    const WmiTargetConfig& target,
    const std::wstring& sectionTitle,
    const std::wstring& wqlQuery,
    const std::vector<std::pair<std::wstring, std::wstring>>& switches,
    const std::wstring& wmiLocale = L"",
    const WmiSecurityConfig& securityConfig = WmiSecurityConfig()
) {
    g_lastNoData = false;

    IWbemServices* pSvc = NULL;
    if (!ConnectWmiServices(target, L"ROOT\\CIMV2", securityConfig, wmiLocale, &pSvc)) {
        return false;
    }

    IEnumWbemClassObject* pEnumerator = NULL;
    HRESULT hr = pSvc->ExecQuery(
        bstr_t("WQL"),
        bstr_t(wqlQuery.c_str()),
        WBEM_FLAG_FORWARD_ONLY | WBEM_FLAG_RETURN_IMMEDIATELY,
        NULL,
        &pEnumerator
    );

    if (FAILED(hr)) {
        std::wcerr << L"[!] WMI Query execution failed: " << DescribeWmiHResult(hr) << std::endl;
        pSvc->Release();
        return false;
    }

    IWbemClassObject* pclsObj = NULL;
    ULONG uReturn = 0;
    hr = pEnumerator->Next(WBEM_INFINITE, 1, &pclsObj, &uReturn);

    if (g_outputOptions.format == OutputFormat::Table) {
        std::wcout << L"\n" << sectionTitle << L":" << std::endl;
    }
    if (uReturn == 0 || FAILED(hr)) {
        g_lastNoData = true;
        std::wcout << L"  No data available.\n" << std::endl;
        pEnumerator->Release();
        pSvc->Release();
        return false;
    }

    Table table;
    table.headers = { L"Switch", L"State" };

    for (const auto& sw : switches) {
        VARIANT vtProp;
        VariantInit(&vtProp);

        hr = pclsObj->Get(sw.first.c_str(), 0, &vtProp, 0, 0);
        if (SUCCEEDED(hr)) {
            table.rows.push_back({ sw.second, FormatSwitchState(VariantToString(vtProp)) });
            VariantClear(&vtProp);
        } else {
            table.rows.push_back({ sw.second, L"N/A" });
        }
    }

    table.Print();

    pclsObj->Release();
    pEnumerator->Release();
    pSvc->Release();
    return true;
}

bool ExecuteWMIQuery(
    const WmiTargetConfig& target,
    const std::wstring& wqlQuery,
    const std::vector<std::wstring>& properties,
    bool autoByteFormat,
    const std::wstring& wmiLocale,
    const std::vector<std::wstring>& displayHeaders,
    const WmiSecurityConfig& securityConfig
);

bool ExecuteGetDiskPreset(
    const WmiTargetConfig& target,
    const std::wstring& whereClause,
    const std::wstring& wmiLocale,
    const WmiSecurityConfig& securityConfig
) {
    return ExecuteWMIQuery(
        target,
        BuildWqlWithOptionalWhere(
            L"SELECT Index, Model, InterfaceType, MediaType, Size, SerialNumber, Status FROM Win32_DiskDrive",
            whereClause
        ),
        { L"Index", L"Model", L"InterfaceType", L"MediaType", L"Size", L"SerialNumber", L"Status" },
        true,
        wmiLocale,
        { L"Disk", L"Model", L"Interface", L"Media Type", L"Size", L"Serial Number", L"Status" },
        securityConfig
    );
}

// Main WMI Query Execution Core
bool ExecuteWMIQuery(
    const WmiTargetConfig& target,
    const std::wstring& wqlQuery,
    const std::vector<std::wstring>& properties,
    bool autoByteFormat = true,
    const std::wstring& wmiLocale = L"",
    const std::vector<std::wstring>& displayHeaders = {},
    const WmiSecurityConfig& securityConfig = WmiSecurityConfig()
) {
    if (target.transport == TransportMode::Ssh) {
        std::wstring out;
        std::wstring error;
        bool noData = false;
        if (!SshPowerShellBackend::ExecuteQuery(target, wqlQuery, properties, g_outputOptions, out, noData, error)) {
            std::wcerr << L"[!] " << error << std::endl;
            return false;
        }

        if (noData) {
            g_lastNoData = true;
            return true;
        }

        std::wcout << out;
        if (!out.empty() && out.back() != L'\n') std::wcout << L"\n";
        return true;
    }

    if (target.transport == TransportMode::WinRm) {
        const IWinRmBackend& backend = GetWinRmBackend(target.winrmBackend);
        std::wstring out;
        std::wstring error;
        bool noData = false;
        if (!backend.ExecuteQuery(target, wqlQuery, properties, g_outputOptions, out, noData, error)) {
            std::wcerr << L"[!] " << error << std::endl;
            return false;
        }

        if (noData) {
            g_lastNoData = true;
            return true;
        }

        std::wcout << out;
        if (!out.empty() && out.back() != L'\n') std::wcout << L"\n";
        return true;
    }

    g_lastNoData = false;

    IWbemServices* pSvc = NULL;
    if (!ConnectWmiServices(target, target.wmiNamespace, securityConfig, wmiLocale, &pSvc)) {
        return false;
    }

    IEnumWbemClassObject* pEnumerator = NULL;
    HRESULT hr = pSvc->ExecQuery(
        bstr_t("WQL"),
        bstr_t(wqlQuery.c_str()),
        WBEM_FLAG_FORWARD_ONLY | WBEM_FLAG_RETURN_IMMEDIATELY,
        NULL,
        &pEnumerator
    );

    if (FAILED(hr)) {
        std::wcerr << L"[!] WMI Query execution failed: " << DescribeWmiHResult(hr) << std::endl;
        pSvc->Release();
        return false;
    }

    if (g_outputOptions.format == OutputFormat::Json) {
        std::vector<std::wstring> jsonHeaders;
        if (!displayHeaders.empty() && displayHeaders.size() == properties.size()) {
            jsonHeaders = displayHeaders;
        } else {
            jsonHeaders = properties;
        }

        std::wstring jsonOut;
        jsonOut.reserve(4096);
        jsonOut.push_back(L'[');

        IWbemClassObject* pclsObj = NULL;
        ULONG uReturn = 0;
        bool firstRow = true;

        while (pEnumerator) {
            hr = pEnumerator->Next(WBEM_INFINITE, 1, &pclsObj, &uReturn);
            if (FAILED(hr)) {
                std::wcerr << L"[!] WMI result enumeration failed: " << DescribeWmiHResult(hr) << std::endl;
                pEnumerator->Release();
                pSvc->Release();
                return false;
            }
            if (uReturn == 0) break;

            if (!firstRow) jsonOut.push_back(L',');
            firstRow = false;

            jsonOut.push_back(L'{');
            for (size_t c = 0; c < properties.size(); ++c) {
                if (c > 0) jsonOut.push_back(L',');

                std::wstring key = EscapeJson(jsonHeaders[c]);
                jsonOut += L"\"";
                jsonOut += key;
                jsonOut += L"\":";

                VARIANT vtProp;
                VariantInit(&vtProp);
                hr = pclsObj->Get(properties[c].c_str(), 0, &vtProp, 0, 0);

                if (SUCCEEDED(hr)) {
                    if (properties[c] == L"InstallDate" || properties[c] == L"ReleaseDate") {
                        std::wstring val = FormatWmiDateTime(VariantToString(vtProp));
                        jsonOut += L"\"";
                        jsonOut += EscapeJson(val);
                        jsonOut += L"\"";
                    } else if (properties[c] == L"LicenseStatus") {
                        std::wstring val = MapLicenseStatusCode(VariantToString(vtProp));
                        jsonOut += L"\"";
                        jsonOut += EscapeJson(val);
                        jsonOut += L"\"";
                    } else {
                        jsonOut += VariantToJson(vtProp);
                    }
                } else {
                    jsonOut += L"null";
                }

                VariantClear(&vtProp);
            }
            jsonOut.push_back(L'}');

            pclsObj->Release();
        }

        if (firstRow) {
            g_lastNoData = true;
        }

        jsonOut += L"]\n";
        std::wcout << jsonOut;

        pEnumerator->Release();
        pSvc->Release();
        return true;
    }

    Table table;
    if (!displayHeaders.empty() && displayHeaders.size() == properties.size()) {
        table.headers = displayHeaders;
    } else {
        table.headers = properties;
    }

    IWbemClassObject* pclsObj = NULL;
    ULONG uReturn = 0;

    while (pEnumerator) {
        hr = pEnumerator->Next(WBEM_INFINITE, 1, &pclsObj, &uReturn);
        if (FAILED(hr)) {
            std::wcerr << L"[!] WMI result enumeration failed: " << DescribeWmiHResult(hr) << std::endl;
            pEnumerator->Release();
            pSvc->Release();
            return false;
        }
        if (0 == uReturn) break;

        std::vector<std::wstring> row;
        row.reserve(properties.size());
        for (const auto& prop : properties) {
            VARIANT vtProp;
            VariantInit(&vtProp);
            hr = pclsObj->Get(prop.c_str(), 0, &vtProp, 0, 0);

            if (SUCCEEDED(hr)) {
                std::wstring val = VariantToString(vtProp);

                if (prop == L"InstallDate" || prop == L"ReleaseDate") {
                    val = FormatWmiDateTime(val);
                }

                if (prop == L"LicenseStatus") {
                    val = MapLicenseStatusCode(val);
                }
                
                if (autoByteFormat && (prop == L"Size" || prop == L"FreeSpace" || prop == L"Capacity" || prop == L"WorkingSetSize")) {
                    unsigned long long bytes = 0;
                    if (TryParseUnsignedLongLong(val, bytes)) {
                        val = FormatBytes(bytes);
                    }
                }
                
                row.push_back(val);
                VariantClear(&vtProp);
            } else {
                row.push_back(L"N/A");
            }
        }
        table.rows.push_back(std::move(row));
        pclsObj->Release();
    }

    if (table.rows.empty()) {
        g_lastNoData = true;
    }

    table.Print();

    pEnumerator->Release();
    pSvc->Release();
    return true;
}

// --- WMI Method Execution (`call`) ---

bool ExecuteWmiMethodCall(
    const WmiTargetConfig& target,
    const std::wstring& classNameOrPath,
    const std::wstring& methodName,
    const std::map<std::wstring, std::wstring>& inputArgs,
    const std::wstring& wmiLocale,
    const WmiSecurityConfig& securityConfig
) {
    if (target.transport == TransportMode::Ssh) {
        std::wstring out;
        std::wstring error;
        if (!SshPowerShellBackend::ExecuteMethodCall(target, classNameOrPath, methodName, inputArgs, out, error)) {
            std::wcerr << L"[!] " << error << std::endl;
            return false;
        }

        std::wcout << L"\nMethod Execution Successful.";
        if (!out.empty()) {
            std::wstring trimmed = out;
            while (!trimmed.empty() && (trimmed.back() == L'\n' || trimmed.back() == L'\r')) trimmed.pop_back();
            if (!trimmed.empty()) std::wcout << L" " << trimmed;
        }
        std::wcout << L"\n" << std::endl;
        return true;
    }

    if (target.transport == TransportMode::WinRm) {
        const IWinRmBackend& backend = GetWinRmBackend(target.winrmBackend);
        std::wstring out;
        std::wstring error;
        if (!backend.ExecuteMethodCall(target, classNameOrPath, methodName, inputArgs, out, error)) {
            std::wcerr << L"[!] " << error << std::endl;
            return false;
        }

        std::wcout << L"\nMethod Execution Successful.";
        if (!out.empty()) {
            std::wstring trimmed = out;
            while (!trimmed.empty() && (trimmed.back() == L'\n' || trimmed.back() == L'\r')) trimmed.pop_back();
            if (!trimmed.empty()) std::wcout << L" " << trimmed;
        }
        std::wcout << L"\n" << std::endl;
        return true;
    }

    IWbemServices* pSvc = NULL;
    if (!ConnectWmiServices(target, target.wmiNamespace, securityConfig, wmiLocale, &pSvc)) {
        return false;
    }

    IWbemClassObject* pClass = NULL;
    HRESULT hr = pSvc->GetObject(_bstr_t(classNameOrPath.c_str()), 0, NULL, &pClass, NULL);
    if (FAILED(hr)) {
        std::wcerr << L"[!] Failed to get target object/class for method execution." << std::endl;
        pSvc->Release();
        return false;
    }

    IWbemClassObject* pInParamsDef = NULL;
    hr = pClass->GetMethod(methodName.c_str(), 0, &pInParamsDef, NULL);
    if (FAILED(hr)) {
        std::wcerr << L"[!] Method signature lookup failed for: " << methodName << std::endl;
        pClass->Release();
        pSvc->Release();
        return false;
    }

    IWbemClassObject* pInClass = NULL;
    if (pInParamsDef) {
        hr = pInParamsDef->SpawnInstance(0, &pInClass);
        if (FAILED(hr) || pInClass == NULL) {
            std::wcerr << L"[!] Failed to create method input parameter instance." << std::endl;
            pInParamsDef->Release();
            pClass->Release();
            pSvc->Release();
            return false;
        }

        auto isIntegerLiteral = [](const std::wstring& value) -> bool {
            if (value.empty()) return false;

            size_t start = 0;
            if (value[0] == L'+' || value[0] == L'-') {
                if (value.size() == 1) return false;
                start = 1;
            }

            for (size_t i = start; i < value.size(); ++i) {
                if (!iswdigit(value[i])) return false;
            }
            return true;
        };

        auto mapCimToVariantType = [](CIMTYPE baseType, VARTYPE& vtOut) -> bool {
            switch (baseType) {
            case CIM_SINT8: vtOut = VT_I1; return true;
            case CIM_UINT8: vtOut = VT_UI1; return true;
            case CIM_SINT16: vtOut = VT_I2; return true;
            case CIM_UINT16: vtOut = VT_UI2; return true;
            case CIM_SINT32: vtOut = VT_I4; return true;
            case CIM_UINT32: vtOut = VT_UI4; return true;
            case CIM_SINT64: vtOut = VT_I8; return true;
            case CIM_UINT64: vtOut = VT_UI8; return true;
            case CIM_REAL32: vtOut = VT_R4; return true;
            case CIM_REAL64: vtOut = VT_R8; return true;
            case CIM_BOOLEAN: vtOut = VT_BOOL; return true;
            case CIM_STRING:
            case CIM_DATETIME:
            case CIM_REFERENCE:
            case CIM_CHAR16:
            case CIM_OBJECT:
                vtOut = VT_BSTR;
                return true;
            default:
                return false;
            }
        };

        auto tryBuildScalarVariant = [&](CIMTYPE baseType, const std::wstring& rawValue, VARIANT& vtOut) -> bool {
            try {
                switch (baseType) {
                case CIM_SINT8:
                    V_VT(&vtOut) = VT_I1;
                    V_I1(&vtOut) = static_cast<CHAR>(std::stoi(rawValue));
                    return true;
                case CIM_UINT8:
                    V_VT(&vtOut) = VT_UI1;
                    V_UI1(&vtOut) = static_cast<BYTE>(std::stoul(rawValue));
                    return true;
                case CIM_SINT16:
                    V_VT(&vtOut) = VT_I2;
                    V_I2(&vtOut) = static_cast<SHORT>(std::stoi(rawValue));
                    return true;
                case CIM_UINT16:
                    V_VT(&vtOut) = VT_UI2;
                    V_UI2(&vtOut) = static_cast<USHORT>(std::stoul(rawValue));
                    return true;
                case CIM_SINT32:
                    V_VT(&vtOut) = VT_I4;
                    V_I4(&vtOut) = static_cast<LONG>(std::stol(rawValue));
                    return true;
                case CIM_UINT32:
                    V_VT(&vtOut) = VT_UI4;
                    V_UI4(&vtOut) = static_cast<ULONG>(std::stoul(rawValue));
                    return true;
                case CIM_SINT64:
                    V_VT(&vtOut) = VT_I8;
                    V_I8(&vtOut) = static_cast<LONGLONG>(std::stoll(rawValue));
                    return true;
                case CIM_UINT64:
                    V_VT(&vtOut) = VT_UI8;
                    V_UI8(&vtOut) = static_cast<ULONGLONG>(std::stoull(rawValue));
                    return true;
                case CIM_REAL32:
                    V_VT(&vtOut) = VT_R4;
                    V_R4(&vtOut) = static_cast<FLOAT>(std::stof(rawValue));
                    return true;
                case CIM_REAL64:
                    V_VT(&vtOut) = VT_R8;
                    V_R8(&vtOut) = static_cast<DOUBLE>(std::stod(rawValue));
                    return true;
                case CIM_BOOLEAN: {
                    std::wstring lowered = rawValue;
                    std::transform(lowered.begin(), lowered.end(), lowered.begin(), towlower);
                    if (lowered == L"true" || lowered == L"1") {
                        V_VT(&vtOut) = VT_BOOL;
                        V_BOOL(&vtOut) = VARIANT_TRUE;
                        return true;
                    }
                    if (lowered == L"false" || lowered == L"0") {
                        V_VT(&vtOut) = VT_BOOL;
                        V_BOOL(&vtOut) = VARIANT_FALSE;
                        return true;
                    }
                    return false;
                }
                case CIM_STRING:
                case CIM_DATETIME:
                case CIM_REFERENCE:
                case CIM_CHAR16:
                case CIM_OBJECT:
                    V_VT(&vtOut) = VT_BSTR;
                    V_BSTR(&vtOut) = SysAllocString(rawValue.c_str());
                    return V_BSTR(&vtOut) != NULL;
                default:
                    return false;
                }
            } catch (...) {
                return false;
            }
        };

        auto tryBuildArrayVariant = [&](CIMTYPE baseType, const std::wstring& rawValue, VARIANT& vtOut) -> bool {
            VARTYPE elementVt = VT_EMPTY;
            if (!mapCimToVariantType(baseType, elementVt)) {
                return false;
            }

            std::vector<std::wstring> items = SplitAndTrimCommaList(rawValue);
            if (items.empty()) {
                return false;
            }

            SAFEARRAYBOUND bound;
            bound.lLbound = 0;
            bound.cElements = static_cast<ULONG>(items.size());
            SAFEARRAY* psa = SafeArrayCreate(elementVt, 1, &bound);
            if (!psa) {
                return false;
            }

            bool ok = true;
            for (LONG i = 0; i < static_cast<LONG>(items.size()); ++i) {
                const std::wstring& item = items[i];
                HRESULT putHr = E_FAIL;

                try {
                    switch (elementVt) {
                    case VT_I1: {
                        CHAR v = static_cast<CHAR>(std::stoi(item));
                        putHr = SafeArrayPutElement(psa, &i, &v);
                        break;
                    }
                    case VT_UI1: {
                        BYTE v = static_cast<BYTE>(std::stoul(item));
                        putHr = SafeArrayPutElement(psa, &i, &v);
                        break;
                    }
                    case VT_I2: {
                        SHORT v = static_cast<SHORT>(std::stoi(item));
                        putHr = SafeArrayPutElement(psa, &i, &v);
                        break;
                    }
                    case VT_UI2: {
                        USHORT v = static_cast<USHORT>(std::stoul(item));
                        putHr = SafeArrayPutElement(psa, &i, &v);
                        break;
                    }
                    case VT_I4: {
                        LONG v = static_cast<LONG>(std::stol(item));
                        putHr = SafeArrayPutElement(psa, &i, &v);
                        break;
                    }
                    case VT_UI4: {
                        ULONG v = static_cast<ULONG>(std::stoul(item));
                        putHr = SafeArrayPutElement(psa, &i, &v);
                        break;
                    }
                    case VT_I8: {
                        LONGLONG v = static_cast<LONGLONG>(std::stoll(item));
                        putHr = SafeArrayPutElement(psa, &i, &v);
                        break;
                    }
                    case VT_UI8: {
                        ULONGLONG v = static_cast<ULONGLONG>(std::stoull(item));
                        putHr = SafeArrayPutElement(psa, &i, &v);
                        break;
                    }
                    case VT_R4: {
                        FLOAT v = static_cast<FLOAT>(std::stof(item));
                        putHr = SafeArrayPutElement(psa, &i, &v);
                        break;
                    }
                    case VT_R8: {
                        DOUBLE v = static_cast<DOUBLE>(std::stod(item));
                        putHr = SafeArrayPutElement(psa, &i, &v);
                        break;
                    }
                    case VT_BOOL: {
                        std::wstring lowered = item;
                        std::transform(lowered.begin(), lowered.end(), lowered.begin(), towlower);
                        VARIANT_BOOL v;
                        if (lowered == L"true" || lowered == L"1") v = VARIANT_TRUE;
                        else if (lowered == L"false" || lowered == L"0") v = VARIANT_FALSE;
                        else {
                            putHr = E_INVALIDARG;
                            break;
                        }
                        putHr = SafeArrayPutElement(psa, &i, &v);
                        break;
                    }
                    case VT_BSTR: {
                        BSTR b = SysAllocString(item.c_str());
                        if (!b) {
                            putHr = E_OUTOFMEMORY;
                            break;
                        }
                        putHr = SafeArrayPutElement(psa, &i, b);
                        SysFreeString(b);
                        break;
                    }
                    default:
                        putHr = E_NOTIMPL;
                        break;
                    }
                } catch (...) {
                    putHr = E_INVALIDARG;
                }

                if (FAILED(putHr)) {
                    ok = false;
                    break;
                }
            }

            if (!ok) {
                SafeArrayDestroy(psa);
                return false;
            }

            V_VT(&vtOut) = static_cast<VARTYPE>(VT_ARRAY | elementVt);
            V_ARRAY(&vtOut) = psa;
            return true;
        };

        auto putTypedInputValue = [&](const std::wstring& name, const std::wstring& rawValue) -> bool {
            CIMTYPE cimType = 0;
            VARIANT vtSchema;
            VariantInit(&vtSchema);
            HRESULT schemaHr = pInParamsDef->Get(name.c_str(), 0, &vtSchema, &cimType, NULL);
            VariantClear(&vtSchema);

            VARIANT vtVal;
            VariantInit(&vtVal);
            bool assigned = false;
            bool hasSchemaType = SUCCEEDED(schemaHr);

            if (hasSchemaType) {
                CIMTYPE baseType = static_cast<CIMTYPE>(cimType & ~CIM_FLAG_ARRAY);
                bool isArray = (cimType & CIM_FLAG_ARRAY) != 0;
                assigned = isArray
                    ? tryBuildArrayVariant(baseType, rawValue, vtVal)
                    : tryBuildScalarVariant(baseType, rawValue, vtVal);

                if (!assigned) {
                    // Schema exists but conversion failed; avoid sending mismatched VARTYPE.
                    return false;
                }
            }

            // Fallback when schema is unavailable: best-effort integer or BSTR.
            if (!hasSchemaType && isIntegerLiteral(rawValue)) {
                try {
                    long long v = std::stoll(rawValue);
                    if (v >= static_cast<long long>(LONG_MIN) && v <= static_cast<long long>(LONG_MAX)) {
                        V_VT(&vtVal) = VT_I4;
                        V_I4(&vtVal) = static_cast<LONG>(v);
                    } else {
                        V_VT(&vtVal) = VT_I8;
                        V_I8(&vtVal) = static_cast<LONGLONG>(v);
                    }
                    assigned = true;
                } catch (...) {
                    assigned = false;
                }
            }

            if (!assigned) {
                V_VT(&vtVal) = VT_BSTR;
                V_BSTR(&vtVal) = SysAllocString(rawValue.c_str());
            }

            HRESULT putHr = pInClass->Put(name.c_str(), 0, &vtVal, 0);
            VariantClear(&vtVal);
            return SUCCEEDED(putHr);
        };

        for (const auto& kv : inputArgs) {
            if (!putTypedInputValue(kv.first, kv.second)) {
                std::wcerr << L"[!] Failed to set method input parameter: " << kv.first << std::endl;
                pInClass->Release();
                pInParamsDef->Release();
                pClass->Release();
                pSvc->Release();
                return false;
            }
        }

        pInParamsDef->Release();
    }

    IWbemClassObject* pOutParams = NULL;
    hr = pSvc->ExecMethod(_bstr_t(classNameOrPath.c_str()), _bstr_t(methodName.c_str()), 0, NULL, pInClass, &pOutParams, NULL);

    if (pInClass) pInClass->Release();
    pClass->Release();

    if (SUCCEEDED(hr) && pOutParams) {
        VARIANT vtRet;
        VariantInit(&vtRet);
        if (SUCCEEDED(pOutParams->Get(L"ReturnValue", 0, &vtRet, NULL, NULL))) {
            std::wcout << L"\nMethod Execution Successful. ReturnValue = " << VariantToString(vtRet) << L"\n" << std::endl;
        } else {
            std::wcout << L"\nMethod Executed Successfully.\n" << std::endl;
        }
        VariantClear(&vtRet);
        pOutParams->Release();
        pSvc->Release();
        return true;
    }

    std::wcerr << L"[!] Method execution failed: " << DescribeWmiHResult(hr) << std::endl;
    pSvc->Release();
    return false;
}

// --- WMI Property Modification (`set`) ---

bool ExecuteWmiSetProperty(
    const WmiTargetConfig& target,
    const std::wstring& objectPath,
    const std::wstring& propName,
    const std::wstring& propValue,
    const std::wstring& wmiLocale,
    const WmiSecurityConfig& securityConfig
) {
    if (target.transport == TransportMode::WinRm) {
        const IWinRmBackend& backend = GetWinRmBackend(target.winrmBackend);
        std::wstring out;
        std::wstring error;
        if (!backend.ExecuteSetProperty(target, objectPath, propName, propValue, out, error)) {
            std::wcerr << L"[!] " << error << std::endl;
            return false;
        }

        if (!out.empty()) {
            std::wcout << out;
            if (out.back() != L'\n') std::wcout << L"\n";
        } else {
            std::wcout << L"\nProperty updated successfully: " << propName << L" = " << propValue << L"\n" << std::endl;
        }
        return true;
    }

    IWbemServices* pSvc = NULL;
    if (!ConnectWmiServices(target, target.wmiNamespace, securityConfig, wmiLocale, &pSvc)) {
        return false;
    }

    IWbemClassObject* pInst = NULL;
    HRESULT hr = pSvc->GetObject(_bstr_t(objectPath.c_str()), 0, NULL, &pInst, NULL);
    if (FAILED(hr)) {
        std::wcerr << L"[!] Instance not found for SET operation." << std::endl;
        pSvc->Release();
        return false;
    }

    VARIANT vtVal;
    VariantInit(&vtVal);
    V_VT(&vtVal) = VT_BSTR;
    V_BSTR(&vtVal) = SysAllocString(propValue.c_str());

    hr = pInst->Put(propName.c_str(), 0, &vtVal, 0);
    VariantClear(&vtVal);

    if (SUCCEEDED(hr)) {
        hr = pSvc->PutInstance(pInst, WBEM_FLAG_UPDATE_ONLY, NULL, NULL);
    }

    pInst->Release();
    pSvc->Release();

    if (SUCCEEDED(hr)) {
        std::wcout << L"\nProperty updated successfully: " << propName << L" = " << propValue << L"\n" << std::endl;
        return true;
    }

    std::wcerr << L"[!] Failed to update instance property: " << DescribeWmiHResult(hr) << std::endl;
    return false;
}

// --- WMI Instance Deletion (`delete`) ---

bool ExecuteWmiDelete(
    const WmiTargetConfig& target,
    const std::wstring& objectPath,
    const std::wstring& wmiLocale,
    const WmiSecurityConfig& securityConfig
) {
    if (target.transport == TransportMode::WinRm) {
        const IWinRmBackend& backend = GetWinRmBackend(target.winrmBackend);
        std::wstring out;
        std::wstring error;
        if (!backend.ExecuteDeleteInstance(target, objectPath, out, error)) {
            std::wcerr << L"[!] " << error << std::endl;
            return false;
        }

        if (!out.empty()) {
            std::wcout << out;
            if (out.back() != L'\n') std::wcout << L"\n";
        } else {
            std::wcout << L"\nInstance deleted successfully: " << objectPath << L"\n" << std::endl;
        }
        return true;
    }

    IWbemServices* pSvc = NULL;
    if (!ConnectWmiServices(target, target.wmiNamespace, securityConfig, wmiLocale, &pSvc)) {
        return false;
    }

    HRESULT hr = pSvc->DeleteInstance(_bstr_t(objectPath.c_str()), 0, NULL, NULL);
    pSvc->Release();

    if (SUCCEEDED(hr)) {
        std::wcout << L"\nInstance deleted successfully: " << objectPath << L"\n" << std::endl;
        return true;
    }

    std::wcerr << L"[!] Failed to delete instance: " << DescribeWmiHResult(hr) << std::endl;
    return false;
}

bool ExecuteRamStatusSummary(const WmiTargetConfig& target, const std::wstring& wmiLocale, const WmiSecurityConfig& securityConfig) {
    if (target.transport != TransportMode::DcomRpc) {
        return ExecuteWMIQuery(
            target,
            L"SELECT TotalVisibleMemorySize, FreePhysicalMemory FROM Win32_OperatingSystem",
            { L"TotalVisibleMemorySize", L"FreePhysicalMemory" },
            false,
            wmiLocale,
            { L"Total Visible Memory (KB)", L"Free Physical Memory (KB)" },
            securityConfig
        );
    }

    IWbemServices* pSvc = NULL;
    if (!ConnectWmiServices(target, L"ROOT\\CIMV2", securityConfig, wmiLocale, &pSvc)) {
        return false;
    }

    IEnumWbemClassObject* pEnumerator = NULL;
    HRESULT hr = pSvc->ExecQuery(
        bstr_t("WQL"),
        bstr_t(L"SELECT TotalVisibleMemorySize, FreePhysicalMemory FROM Win32_OperatingSystem"),
        WBEM_FLAG_FORWARD_ONLY | WBEM_FLAG_RETURN_IMMEDIATELY,
        NULL,
        &pEnumerator
    );

    if (FAILED(hr)) {
        pSvc->Release();
        return false;
    }

    IWbemClassObject* pclsObj = NULL;
    ULONG uReturn = 0;
    hr = pEnumerator->Next(WBEM_INFINITE, 1, &pclsObj, &uReturn);
    if (FAILED(hr) || uReturn == 0) {
        pEnumerator->Release();
        pSvc->Release();
        return false;
    }

    auto readProp = [&](const wchar_t* propName) -> std::wstring {
        VARIANT vtProp;
        VariantInit(&vtProp);
        std::wstring value = L"N/A";
        if (SUCCEEDED(pclsObj->Get(propName, 0, &vtProp, 0, 0))) {
            value = VariantToString(vtProp);
        }
        VariantClear(&vtProp);
        return value;
    };

    std::wstring totalKbStr = readProp(L"TotalVisibleMemorySize");
    std::wstring freeKbStr = readProp(L"FreePhysicalMemory");

    std::wstring ramLoad = L"N/A";
    std::wstring totalPhysical = L"N/A";
    std::wstring availablePhysical = L"N/A";

    unsigned long long totalKb = 0;
    unsigned long long freeKb = 0;
    if (TryParseUnsignedLongLong(totalKbStr, totalKb) && TryParseUnsignedLongLong(freeKbStr, freeKb)) {
        unsigned long long usedKb = (totalKb > freeKb) ? (totalKb - freeKb) : 0;

        if (totalKb > 0) {
            unsigned long long loadPct = (usedKb * 100ULL) / totalKb;
            ramLoad = std::to_wstring(loadPct) + L"%";
        }

        totalPhysical = FormatBytes(totalKb * 1024ULL);
        availablePhysical = FormatBytes(freeKb * 1024ULL);
    }

    if (g_outputOptions.format == OutputFormat::Table) {
        std::wcout << L"\n--- System Memory Summary ---" << std::endl;
        std::wcout << L"RAM Load:            " << ramLoad << std::endl;
        std::wcout << L"Total Physical:      " << totalPhysical << std::endl;
        std::wcout << L"Available Physical:  " << availablePhysical << std::endl;
    } else {
        Table table;
        table.headers = { L"RAM Load", L"Total Physical", L"Available Physical" };
        table.rows.push_back({ ramLoad, totalPhysical, availablePhysical });
        table.Print();
    }

    pclsObj->Release();
    pEnumerator->Release();
    pSvc->Release();
    return true;
}

bool ResolveExecutablePath(const std::wstring& candidate, std::wstring& resolvedPath) {
    if (!candidate.empty()) {
        if (candidate.find(L'\\') != std::wstring::npos || candidate.find(L'/') != std::wstring::npos) {
            resolvedPath = candidate;
            return true;
        }
    }

    wchar_t buffer[MAX_PATH] = {};
    DWORD length = GetModuleFileNameW(nullptr, buffer, MAX_PATH);
    if (length != 0 && length < MAX_PATH) {
        resolvedPath = buffer;
        return true;
    }

    if (!candidate.empty()) {
        std::wstring candidatePath = candidate;
        if (candidatePath.find(L'\\') == std::wstring::npos && candidatePath.find(L'/') == std::wstring::npos) {
            wchar_t cwd[MAX_PATH] = {};
            if (GetCurrentDirectoryW(MAX_PATH, cwd)) {
                candidatePath = std::wstring(cwd) + L"\\" + candidatePath;
            }
        }
        resolvedPath = candidatePath;
        return true;
    }

    return false;
}

std::wstring QuoteCommandLineArgument(const std::wstring& value) {
    if (value.empty()) {
        return L"\"\"";
    }

    bool needsQuotes = value.find_first_of(L" \t\"") != std::wstring::npos;
    if (!needsQuotes) {
        return value;
    }

    std::wstring quoted = L"\"";
    for (size_t i = 0; i < value.size(); ++i) {
        size_t backslashes = 0;
        while (i < value.size() && value[i] == L'\\') {
            backslashes++;
            i++;
        }

        if (i == value.size()) {
            quoted.append(backslashes * 2, L'\\');
            break;
        } else if (value[i] == L'"') {
            quoted.append(backslashes * 2 + 1, L'\\');
            quoted.push_back(L'"');
        } else {
            quoted.append(backslashes, L'\\');
            quoted.push_back(value[i]);
        }
    }
    quoted += L"\"";
    return quoted;
}

std::wstring FormatSystemErrorMessage(DWORD errorCode) {
    LPWSTR messageBuffer = nullptr;
    FormatMessageW(
        FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS,
        nullptr,
        errorCode,
        0,
        reinterpret_cast<LPWSTR>(&messageBuffer),
        0,
        nullptr
    );

    std::wstring message = messageBuffer ? messageBuffer : L"Unknown system error";
    if (messageBuffer) {
        LocalFree(messageBuffer);
    }

    return message;
}

std::vector<std::wstring> TokenizeShellInput(const std::wstring& input) {
    std::vector<std::wstring> tokens;
    std::wstring current;
    bool inQuotes = false;

    for (wchar_t ch : input) {
        if (ch == L'\"') {
            inQuotes = !inQuotes;
            continue;
        }

        if (std::iswspace(ch) && !inQuotes) {
            if (!current.empty()) {
                tokens.push_back(current);
                current.clear();
            }
            continue;
        }

        current.push_back(ch);
    }

    if (!current.empty()) {
        tokens.push_back(current);
    }

    return tokens;
}

bool RunChildProcessAndWait(const std::wstring& executablePath, const std::vector<std::wstring>& args, std::wstring& errorOut, int& exitCode, bool suppressOutput = false) {
    std::wstring commandLine = QuoteCommandLineArgument(executablePath);
    for (const std::wstring& arg : args) {
        commandLine += L" " + QuoteCommandLineArgument(arg);
    }

    std::vector<wchar_t> commandBuffer(commandLine.begin(), commandLine.end());
    commandBuffer.push_back(L'\0');

    STARTUPINFOW startupInfo{};
    startupInfo.cb = sizeof(startupInfo);
    PROCESS_INFORMATION processInfo{};
    HANDLE hNul = NULL;

    if (suppressOutput) {
        SECURITY_ATTRIBUTES sa = {};
        sa.nLength = sizeof(sa);
        sa.bInheritHandle = TRUE;
        hNul = CreateFileW(L"NUL", GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
        if (hNul == INVALID_HANDLE_VALUE) {
            hNul = NULL;
        }
        if (hNul != NULL) {
            startupInfo.dwFlags |= STARTF_USESTDHANDLES;
            startupInfo.hStdOutput = hNul;
            startupInfo.hStdError = hNul;
            startupInfo.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
        }
    }

    std::wstring processPath = executablePath;
    if (processPath.empty()) {
        processPath = L"xmic.exe";
    }

    BOOL started = CreateProcessW(
        nullptr,
        commandBuffer.data(),
        nullptr,
        nullptr,
        TRUE,
        0,
        nullptr,
        nullptr,
        &startupInfo,
        &processInfo
    );

    if (!started) {
        DWORD errorCode = GetLastError();
        errorOut = L"Failed to launch xmic child process. Make sure xmic.exe is available and try again. System error: " + FormatSystemErrorMessage(errorCode);
        if (hNul != NULL) {
            CloseHandle(hNul);
        }
        return false;
    }

    WaitForSingleObject(processInfo.hProcess, INFINITE);

    DWORD code = 0;
    GetExitCodeProcess(processInfo.hProcess, &code);
    CloseHandle(processInfo.hThread);
    CloseHandle(processInfo.hProcess);
    if (hNul != NULL) {
        CloseHandle(hNul);
    }
    exitCode = static_cast<int>(code);
    return true;
}

bool TryParsePositiveInt(const std::wstring& input, int& valueOut) {
    valueOut = 0;
    if (input.empty()) {
        return false;
    }

    errno = 0;
    wchar_t* endPtr = nullptr;
    long parsed = wcstol(input.c_str(), &endPtr, 10);
    if (endPtr == input.c_str() || *endPtr != L'\0' || errno == ERANGE || parsed < kBenchmarkRunsMin || parsed > kBenchmarkRunsMax) {
        return false;
    }

    valueOut = static_cast<int>(parsed);
    return true;
}

bool TryParseBenchmarkRunsValue(int valueIndex, int argc, wchar_t* argv[], int& runsOut, std::wstring& errorOut) {
    runsOut = 0;
    errorOut.clear();

    if (valueIndex >= argc) {
        errorOut = kBenchmarkRunsMissingMessage;
        return false;
    }

    if (!TryParsePositiveInt(argv[valueIndex], runsOut)) {
        errorOut = kBenchmarkRunsInvalidMessage;
        return false;
    }

    return true;
}

bool ValidateBenchmarkOptions(
    int benchmarkRuns,
    bool benchmarkQuiet,
    bool interactivePasswordRequired,
    std::wstring& errorOut
) {
    errorOut.clear();

    if (benchmarkRuns > 1 && interactivePasswordRequired) {
        errorOut = kBenchmarkInteractivePromptConflictMessage;
        return false;
    }

    if (benchmarkQuiet && benchmarkRuns <= 1) {
        errorOut = kBenchmarkQuietRequiresRunsMessage;
        return false;
    }

    return true;
}

int RunInteractiveShell(const std::wstring& executablePath) {
    std::wcout << L"\nXMIC interactive shell" << std::endl;
    std::wcout << L"Enter a normal xmic command, one per line." << std::endl;
    std::wcout << L"Examples: os, process, path Win32_Process get Name,ProcessId" << std::endl;
    std::wcout << L"Type 'help' for shell commands, 'set <name> <value>' for defaults, or 'exit' / 'quit' to leave." << std::endl;

    std::wstring shellNode;
    std::wstring shellUser;
    std::wstring shellPassword;
    std::wstring shellDomain;
    std::wstring shellNamespace;
    std::wstring shellTransport;
    std::wstring shellWinrmBackend;
    std::wstring shellFormat;
    std::wstring shellConsoleEncoding;
    bool shellNoHeader = false;

    while (true) {
        std::wcout << L"xmic> ";
        std::wstring inputLine;
        if (!std::getline(std::wcin, inputLine)) {
            break;
        }

        if (inputLine.empty()) {
            continue;
        }

        std::vector<std::wstring> tokens = TokenizeShellInput(inputLine);
        if (tokens.empty()) {
            continue;
        }

        std::wstring command = tokens[0];
        std::transform(command.begin(), command.end(), command.begin(), towlower);

        if (command == L"exit" || command == L"quit") {
            break;
        }

        if (command == L"help") {
            std::wcout << L"Shell commands:" << std::endl;
            std::wcout << L"  help                      Show this help" << std::endl;
            std::wcout << L"  exit / quit               Leave the shell" << std::endl;
            std::wcout << L"  set <name> <value>        Set persistent shell options" << std::endl;
            std::wcout << L"  show                      Show current shell options" << std::endl;
            std::wcout << L"Command examples:" << std::endl;
            std::wcout << L"  os" << std::endl;
            std::wcout << L"  process" << std::endl;
            std::wcout << L"  path Win32_Process get Name,ProcessId" << std::endl;
            std::wcout << L"Common defaults:" << std::endl;
            std::wcout << L"  set node server01" << std::endl;
            std::wcout << L"  set transport ssh" << std::endl;
            std::wcout << L"  set format json" << std::endl;
            continue;
        }

        if (command == L"show") {
            std::wcout << L"Current shell options:" << std::endl;
            if (!shellNode.empty()) std::wcout << L"  node=" << shellNode << std::endl;
            if (!shellUser.empty()) std::wcout << L"  user=" << shellUser << std::endl;
            if (!shellPassword.empty()) std::wcout << L"  password=<set>" << std::endl;
            if (!shellDomain.empty()) std::wcout << L"  domain=" << shellDomain << std::endl;
            if (!shellNamespace.empty()) std::wcout << L"  namespace=" << shellNamespace << std::endl;
            if (!shellTransport.empty()) std::wcout << L"  transport=" << shellTransport << std::endl;
            if (!shellWinrmBackend.empty()) std::wcout << L"  winrm-backend=" << shellWinrmBackend << std::endl;
            if (!shellFormat.empty()) std::wcout << L"  format=" << shellFormat << std::endl;
            if (!shellConsoleEncoding.empty()) std::wcout << L"  console-encoding=" << shellConsoleEncoding << std::endl;
            if (shellNoHeader) std::wcout << L"  no-header" << std::endl;
            continue;
        }

        if (command == L"set" && tokens.size() >= 2) {
            std::wstring key = tokens[1];
            std::transform(key.begin(), key.end(), key.begin(), towlower);
            std::wstring value;
            if (tokens.size() >= 3) {
                value = tokens[2];
            }

            if (key == L"node") {
                shellNode = value;
            } else if (key == L"user") {
                shellUser = value;
            } else if (key == L"password") {
                shellPassword = value;
            } else if (key == L"domain") {
                shellDomain = value;
            } else if (key == L"namespace") {
                shellNamespace = value;
            } else if (key == L"transport") {
                shellTransport = value;
            } else if (key == L"winrm-backend") {
                shellWinrmBackend = value;
            } else if (key == L"format") {
                shellFormat = value;
            } else if (key == L"console-encoding") {
                shellConsoleEncoding = value;
            } else if (key == L"no-header") {
                shellNoHeader = true;
            } else {
                std::wcout << L"Unknown shell setting: " << key << std::endl;
            }
            continue;
        }

        std::vector<std::wstring> childArgs;
        if (!shellNode.empty()) {
            childArgs.push_back(L"--node");
            childArgs.push_back(shellNode);
        }
        if (!shellUser.empty()) {
            childArgs.push_back(L"--user");
            childArgs.push_back(shellUser);
        }
        if (!shellPassword.empty()) {
            childArgs.push_back(L"--password");
            childArgs.push_back(shellPassword);
        }
        if (!shellDomain.empty()) {
            childArgs.push_back(L"--domain");
            childArgs.push_back(shellDomain);
        }
        if (!shellNamespace.empty()) {
            childArgs.push_back(L"--namespace");
            childArgs.push_back(shellNamespace);
        }
        if (!shellTransport.empty()) {
            childArgs.push_back(L"--transport");
            childArgs.push_back(shellTransport);
        }
        if (!shellWinrmBackend.empty()) {
            childArgs.push_back(L"--winrm-backend");
            childArgs.push_back(shellWinrmBackend);
        }
        if (!shellFormat.empty()) {
            childArgs.push_back(L"--format");
            childArgs.push_back(shellFormat);
        }
        if (!shellConsoleEncoding.empty()) {
            childArgs.push_back(L"--console-encoding");
            childArgs.push_back(shellConsoleEncoding);
        }
        if (shellNoHeader) {
            childArgs.push_back(L"--no-header");
        }

        childArgs.insert(childArgs.end(), tokens.begin(), tokens.end());

        int exitCode = EXIT_OK;
        std::wstring launchError;
        if (!RunChildProcessAndWait(executablePath, childArgs, launchError, exitCode)) {
            std::wcerr << L"[!] " << launchError << std::endl;
            return EXIT_WMI_FAILURE;
        }

        if (exitCode != EXIT_OK) {
            std::wcout << L"[shell] Command exited with code " << exitCode << std::endl;
        }
    }

    std::wcout << L"Leaving XMIC shell." << std::endl;
    return EXIT_OK;
}

